{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "REOG Converter",
  "version": "1.0.0",
  "identifier": "com.reog.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "REOG Converter",
        "width": 900,
        "height": 650
      }
    ],
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/REOG163/reog163.github.io/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}
