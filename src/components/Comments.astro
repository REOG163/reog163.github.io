---
// ===== 配置 Giscus 评论（获取方法见说明）=====
const REPO = 'REOG163/reog163.github.io';
const REPO_ID = ''; // 在 https://giscus.app 获取 data-repo-id
const CATEGORY = 'Announcements';
const CATEGORY_ID = ''; // 在 https://giscus.app 获取 data-category-id
// ============================================
const ready = Boolean(REPO_ID && CATEGORY_ID);
---

{
	ready && (
		<section class="comments">
			<h2>评论</h2>
			<div
				id="giscus-box"
				data-repo={REPO}
				data-repo-id={REPO_ID}
				data-category={CATEGORY}
				data-category-id={CATEGORY_ID}
			/>
		</section>
	)
}

<style>
	.comments {
		margin-top: 48px;
		padding-top: 24px;
		border-top: 1px solid rgba(var(--gray), 0.3);
	}
	.comments h2 {
		font-size: 22px;
		margin: 0 0 16px;
	}
</style>

<script>
	const box = document.getElementById('giscus-box');
	if (box) {
		const s = document.createElement('script');
		s.src = 'https://giscus.app/client.js';
		s.async = true;
		s.crossOrigin = 'anonymous';
		const attrs: Record<string, string> = {
			'data-repo': box.dataset.repo || '',
			'data-repo-id': box.dataset.repoId || '',
			'data-category': box.dataset.category || '',
			'data-category-id': box.dataset.categoryId || '',
			'data-mapping': 'pathname',
			'data-strict': '0',
			'data-reactions-enabled': '1',
			'data-emit-metadata': '0',
			'data-input-position': 'top',
			'data-theme': document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light',
			'data-lang': 'zh-CN',
			'data-loading': 'lazy',
		};
		Object.entries(attrs).forEach(([k, v]) => s.setAttribute(k, v));
		box.appendChild(s);

		window.addEventListener('theme-change', (e) => {
			const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
			frame?.contentWindow?.postMessage(
				{ giscus: { setConfig: { theme: (e as CustomEvent).detail } } },
				'https://giscus.app',
			);
		});
	}
</script>
