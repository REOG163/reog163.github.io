---
import Share from './Share.astro';
import NowBadge from './NowBadge.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="now-wrap">
		<NowBadge />
	</div>
	<div class="copy">© {year} REOG · 保留所有权利</div>
	<div class="links">
		<a href="/rss.xml">RSS</a>
		<a href="/search">搜索</a>
		<a href="/stats">仪表盘</a>
		<a href="/tools">小工具</a>
		<a href="/changelog">日志</a>
		<a href="/now">此刻</a>
		<a href="/about">联系</a>
		<button
			type="button"
			data-share
			data-share-scope="site"
			data-share-url="/"
			data-share-title={SITE_TITLE}
			data-share-desc={SITE_DESCRIPTION}>分享</button
		>
	</div>
</footer>
<Share />

<style>
	footer {
		padding: 2em 1em 4em;
		margin: 0;
		background: none;
		text-align: center;
		color: rgb(var(--gray));
		font-size: 14px;
		line-height: 1.9;
		box-sizing: border-box;
		overflow-x: hidden;
	}
	.now-wrap {
		display: flex;
		justify-content: center;
		margin-bottom: 16px;
		padding: 0 4px;
		box-sizing: border-box;
		width: 100%;
	}
	.copy {
		margin-bottom: 6px;
	}
	.links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px 14px;
		padding: 0 8px;
	}
	.links a,
	.links button {
		color: rgb(var(--gray));
		text-decoration: none;
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		cursor: pointer;
		white-space: nowrap;
	}
	.links a:hover,
	.links button:hover {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		footer {
			padding: 1.5em 12px 3em;
			font-size: 13px;
		}
		.links {
			gap: 10px 12px;
		}
	}
</style>
