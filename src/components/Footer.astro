---
import Share from './Share.astro';
import NowBadge from './NowBadge.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="now-wrap">
		<NowBadge />
	</div>
	<div>© {year} REOG · 保留所有权利</div>
	<div class="links">
		<a href="/rss.xml">RSS 订阅</a>
		<a href="/search">站内搜索</a>
		<a href="/stats">写作仪表盘</a>
		<a href="/tools">小工具</a>
		<a href="/changelog">建站日志</a>
		<a href="/now">此刻</a>
		<a href="/about">联系我</a>
		<button
			type="button"
			data-share
			data-share-scope="site"
			data-share-url="/"
			data-share-title={SITE_TITLE}
			data-share-desc={SITE_DESCRIPTION}>分享本站</button
		>
	</div>
</footer>
<Share />

<style>
	footer {
		padding: 2em 1em 4em;
		margin: 0;
		background: none;
		text-align: center;
		color: rgb(var(--gray));
		font-size: 14px;
		line-height: 1.9;
	}
	.now-wrap {
		display: flex;
		justify-content: center;
		margin-bottom: 16px;
	}
	.links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 4px 18px;
	}
	.links a,
	.links button {
		color: rgb(var(--gray));
		text-decoration: none;
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		cursor: pointer;
	}
	.links a:hover,
	.links button:hover {
		color: var(--accent);
	}
</style>
