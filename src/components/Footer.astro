<style>
	footer {
		padding: 2em 1em 4em;
		margin: 0;
		background: none;
		text-align: center;
		color: rgb(var(--gray));
		font-size: 14px;
		line-height: 1.9;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 18px;
	}
	.links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
