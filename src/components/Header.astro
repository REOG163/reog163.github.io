---
// src/components/Header.astro
// 导航栏带点击滑动胶囊动效
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '作品' },
  { href: '/about', label: '关于' },
];
import '../styles/gold-logo.css';

---

<header class="site-header">
  <nav>
    <a class="brand" href="/">Northilne</a>

    <div class="right">
      <div class="links" id="nav-links">
        <!-- 滑动背景胶囊 -->
        <span class="nav-indicator" id="nav-indicator" aria-hidden="true"></span>

        {links.map((link) => {
          const isActive =
            link.href === '/'
              ? pathname === '/'
              : pathname.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={isActive ? 'active' : ''}
              data-nav-link
            >
              {link.label}
            </a>
          );
        })}
      </div>

      <a class="icon-btn" href="/search" aria-label="搜索">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>

      <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换深色模式">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  /* ========== Header 基础布局 ========== */
  .site-header {
    z-index: 50;
    backdrop-filter: blur(8px);
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid rgb(226, 232, 240);
    position: sticky;
    top: 0;
    margin: 0;
    padding: 0;
  }

  nav {
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    max-width: 960px;
    height: 56px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .brand {
    font-weight: 700;
    font-size: 17px;
    color: rgb(15, 23, 42);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* ========== 导航链接 + 滑动胶囊 ========== */
  .links {
    position: relative;
    display: flex;
    gap: 2px;
  }

  .links a {
    position: relative;
    z-index: 1;
    color: rgb(71, 85, 105);
    border-radius: 8px;
    padding: 6px 9px;
    font-size: 15px;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.18s ease;
  }

  .links a:hover {
    color: rgb(20, 32, 74);
  }

  .links a.active {
    color: rgb(20, 32, 74);
    font-weight: 600;
  }

  /* 点击瞬间轻微缩放反馈 */
  .links a:active {
    transform: scale(0.94);
  }

  /* 滑动背景胶囊 */
  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 8px;
    background: rgb(238, 242, 255);
    z-index: 0;
    transition:
      transform 0.38s cubic-bezier(0.34, 1.3, 0.64, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
    pointer-events: none;
    opacity: 0;
  }

  /* ========== 图标按钮 ========== */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: rgb(71, 85, 105);
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .icon-btn:hover {
    color: rgb(20, 32, 74);
    background: rgb(238, 242, 255);
  }

  .icon-btn svg {
    width: 18px;
    height: 18px;
  }

  /* 主题切换图标显示控制 */
  .icon-btn .sun {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-btn .moon {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-btn .sun {
    display: block;
  }

  /* ========== 深色模式 ========== */
  :global(html[data-theme='dark']) .site-header {
    background: rgba(11, 16, 32, 0.92);
    border-bottom-color: rgb(38, 51, 92);
  }

  :global(html[data-theme='dark']) .brand {
    color: #e6ebff;
  }

  :global(html[data-theme='dark']) .links a,
  :global(html[data-theme='dark']) .icon-btn {
    color: rgb(170, 182, 211);
  }

  :global(html[data-theme='dark']) .links a.active,
  :global(html[data-theme='dark']) .links a:hover,
  :global(html[data-theme='dark']) .icon-btn:hover {
    color: #fff;
  }

  :global(html[data-theme='dark']) .nav-indicator,
  :global(html[data-theme='dark']) .icon-btn:hover {
    background: rgb(29, 42, 82);
  }

  /* ========== 小屏适配 ========== */
  @media (max-width: 430px) {
    nav {
      gap: 6px;
      padding: 0 10px;
    }
    .brand {
      font-size: 15px;
    }
    .links {
      gap: 0;
    }
    .links a {
      padding: 6px 5px;
      font-size: 14px;
    }
    .icon-btn {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  // ========== 主题切换 ==========
  function getTheme() {
    return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function setTheme(theme) {
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    try {
      localStorage.setItem('theme', theme);
    } catch (_) {}
  }

  function bindThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      setTheme(getTheme() === 'dark' ? 'light' : 'dark');
    });
  }

  // 首次进入：读取本地偏好（没有则跟随系统）
  (function initTheme() {
    let theme = null;
    try {
      theme = localStorage.getItem('theme');
    } catch (_) {}
    if (theme !== 'dark' && theme !== 'light') {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    setTheme(theme);
  })();

  bindThemeToggle();

  // ========== 导航胶囊 ==========
  function updateIndicator(immediate = false) {
    const linksEl = document.getElementById('nav-links');
    const indicator = document.getElementById('nav-indicator');
    if (!linksEl || !indicator) return;

    const active = linksEl.querySelector('a.active');
    if (!active) {
      indicator.style.opacity = '0';
      return;
    }

    const linksRect = linksEl.getBoundingClientRect();
    const activeRect = active.getBoundingClientRect();
    const left = activeRect.left - linksRect.left;
    const width = activeRect.width;

    if (immediate) {
      indicator.style.transition = 'none';
    }

    indicator.style.width = width + 'px';
    indicator.style.transform = `translateX(${left}px)`;
    indicator.style.opacity = '1';

    if (immediate) {
      void indicator.offsetHeight;
      indicator.style.transition = '';
    }
  }

  updateIndicator(true);

  document.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', () => {
      document.querySelectorAll('[data-nav-link]').forEach((a) =>
        a.classList.remove('active')
      );
      link.classList.add('active');
      updateIndicator();
    });
  });

  window.addEventListener('resize', () => updateIndicator(true));

  document.addEventListener('astro:page-load', () => {
    bindThemeToggle();
    updateIndicator(true);
  });
</script>
