---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '博客' },
	{ href: '/about', label: '关于' },
];
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<script is:inline>
	(function () {
		try {
			var t = localStorage.getItem('theme');
			if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			document.documentElement.setAttribute('data-theme', t);
		} catch (e) {}
	})();
</script>

<header class="site-header">
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="right">
			<div class="links">
				{links.map((l) => <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>)}
			</div>
			<a class="icon-btn" href="/search" aria-label="搜索">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
			</a>
			<button class="icon-btn" id="theme-toggle" type="button" aria-label="切换深色模式">
				<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
				<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
			</button>
		</div>
	</nav>
</header>

<style is:global>
	html[data-theme='dark'] {
		color-scheme: dark;
		--accent: #8fa8ff;
		--accent-dark: #b9c7ff;
		--black: 241, 245, 255;
		--gray: 148, 163, 196;
		--gray-light: 30, 40, 70;
		--gray-dark: 214, 222, 240;
		--gray-gradient: rgba(30, 40, 70, 50%), #0b1020;
	}
	html[data-theme='dark'] body {
		background-color: #0b1020;
	}
</style>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid #e2e8f0;
		box-shadow: none;
	}
	nav {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 16px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		box-sizing: border-box;
	}
	.brand {
		font-weight: 700;
		font-size: 17px;
		letter-spacing: 0.04em;
		color: #0f172a;
		text-decoration: none;
		white-space: nowrap;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 2px;
	}
	.links {
		display: flex;
		gap: 2px;
	}
	.links a {
		padding: 6px 9px;
		font-size: 15px;
		color: #475569;
		text-decoration: none;
		border-radius: 8px;
	}
	.links a:hover {
		color: #14204a;
	}
	.links a.active {
		color: #14204a;
		font-weight: 600;
		background: #eef2ff;
	}
	.icon-btn {
		width: 36px;
		height: 36px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		padding: 0;
		background: transparent;
		color: #475569;
		border-radius: 8px;
		cursor: pointer;
	}
	.icon-btn:hover {
		background: #eef2ff;
		color: #14204a;
	}
	.icon-btn svg {
		width: 20px;
		height: 20px;
	}
	.sun {
		display: none;
	}
	:global(html[data-theme='dark']) .sun {
		display: block;
	}
	:global(html[data-theme='dark']) .moon {
		display: none;
	}
	:global(html[data-theme='dark']) .site-header {
		background: rgba(11, 16, 32, 0.92);
		border-bottom-color: #26335c;
	}
	:global(html[data-theme='dark']) .brand {
		color: #f1f5ff;
	}
	:global(html[data-theme='dark']) .links a,
	:global(html[data-theme='dark']) .icon-btn {
		color: #aab6d3;
	}
	:global(html[data-theme='dark']) .links a.active,
	:global(html[data-theme='dark']) .links a:hover,
	:global(html[data-theme='dark']) .icon-btn:hover {
		color: #fff;
		background: #1d2a52;
	}
	@media (max-width: 380px) {
		.brand {
			font-size: 15px;
		}
		.links a {
			padding: 6px 6px;
			font-size: 14px;
		}
	}
</style>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
		window.dispatchEvent(new CustomEvent('theme-change', { detail: next }));
	});
</script>
