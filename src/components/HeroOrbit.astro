---
interface Props {
	/** 星球中央浮现的品牌字母 */
	initial?: string;
}
const { initial = 'R' } = Astro.props;
---

<div class="ho" data-hero-orbit data-initial={initial} aria-hidden="true">
	<canvas class="ho-canvas"></canvas>
</div>

<style>
	.ho {
		position: relative;
		width: 100%;
		max-width: 540px;
		aspect-ratio: 1 / 1;
		margin: 0 auto;
		background: transparent; /* 彻底消除方框边缘，与英雄区背景完美融合 */
		overflow: visible;
	}
	.ho-canvas {
		position: absolute;
		inset: -10%;
		width: 120%;
		height: 120%;
		display: block;
		touch-action: pan-y;
		cursor: pointer;
	}
</style>

<script>
	const TAU = Math.PI * 2;
	const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
	const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
	const easeOutBack = (t) => {
		const c1 = 1.70158;
		const c3 = c1 + 1;
		return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
	};
	const smooth = (a, b, x) => {
		const t = clamp((x - a) / (b - a), 0, 1);
		return t * t * (3 - 2 * t);
	};
	function rng(seed) {
		let s = seed >>> 0;
		return () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
	}

	const TEX_W = 1024;
	const TEX_H = 256;
	const TEX_EXTRA = 96;
	const TEX_VIS = TEX_W / 2;
	function makeTexture() {
		const c = document.createElement('canvas');
		c.width = TEX_W + TEX_EXTRA;
		c.height = TEX_H;
		const g = c.getContext('2d');
		const r = rng(77);
		const base = g.createLinearGradient(0, 0, 0, TEX_H);
		base.addColorStop(0, '#040b22');
		base.addColorStop(0.25, '#122c7a');
		base.addColorStop(0.5, '#3b62ff');
		base.addColorStop(0.78, '#18328c');
		base.addColorStop(1, '#020510');
		g.fillStyle = base;
		g.fillRect(0, 0, c.width, TEX_H);

		for (let i = 0; i < 75; i++) {
			const y = r() * TEX_H;
			const h = 2 + r() * 24;
			const k = r();
			const col = k < 0.35 ? '255,215,90' : k < 0.72 ? '135,185,255' : '94,234,212';
			const a = 0.1 + r() * 0.3;
			const ph = r() * TAU;
			const amp = 2 + r() * 7;
			const fq = 2 + Math.floor(r() * 4);
			g.fillStyle = `rgba(${col},${a})`;
			g.beginPath();
			g.moveTo(0, y);
			for (let x = 0; x <= c.width; x += 16) g.lineTo(x, y + Math.sin((x / TEX_W) * TAU * fq + ph) * amp);
			for (let x = c.width; x >= 0; x -= 16) g.lineTo(x, y + h + Math.sin((x / TEX_W) * TAU * fq + ph + 1) * amp);
			g.closePath();
			g.fill();
		}
		for (const [sx, sy, rw, rh] of [[250, 130, 95, 32], [710, 90, 60, 20], [500, 190, 50, 16]]) {
			for (const ox of [0, TEX_W]) {
				const grd = g.createRadialGradient(sx + ox, sy, 2, sx + ox, sy, rw);
				grd.addColorStop(0, 'rgba(255,245,180,1)');
				grd.addColorStop(0.4, 'rgba(255,190,70,0.75)');
				grd.addColorStop(1, 'rgba(255,190,70,0)');
				g.save();
				g.translate(sx + ox, sy);
				g.scale(1, rh / rw);
				g.translate(-(sx + ox), -sy);
				g.fillStyle = grd;
				g.beginPath();
				g.arc(sx + ox, sy, rw, 0, TAU);
				g.fill();
				g.restore();
			}
		}
		return c;
	}

	function makeGlow(rgb) {
		const s = 64;
		const c = document.createElement('canvas');
		c.width = c.height = s;
		const g = c.getContext('2d');
		const grd = g.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
		grd.addColorStop(0, `rgba(${rgb},1)`);
		grd.addColorStop(0.2, `rgba(${rgb},0.9)`);
		grd.addColorStop(0.5, `rgba(${rgb},0.35)`);
		grd.addColorStop(1, `rgba(${rgb},0)`);
		g.fillStyle = grd;
		g.fillRect(0, 0, s, s);
		return c;
	}

	function initOrbit(host) {
		const canvas = host.querySelector('canvas');
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		const initial = host.dataset.initial || 'R';
		const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
		const tex = makeTexture();
		const glow = { 
			white: makeGlow('255,255,255'), 
			gold: makeGlow('255,215,90'), 
			teal: makeGlow('94,234,212'), 
			blue: makeGlow('135,185,255'), 
			violet: makeGlow('190,150,255') 
		};

		const RINGS = [
			{ R: 0.22, tilt: 1.15, roll: -0.38, speed: 0.75, rgb: '135,185,255', moons: [{ a: 0.4, size: 0.015, glow: 'white' }] },
			{ R: 0.275, tilt: 0.9, roll: 0.65, speed: -0.52, rgb: '94,234,212', belt: true, moons: [{ a: 1.6, size: 0.02, glow: 'teal' }, { a: 4.2, size: 0.012, glow: 'white' }] },
			{ R: 0.33, tilt: 1.38, roll: -0.85, speed: 0.38, rgb: '255,215,90', moons: [{ a: 1.1, size: 0.024, glow: 'gold' }] },
			{ R: 0.39, tilt: 0.7, roll: 1.65, speed: -0.28, rgb: '190,150,255', moons: [{ a: 3.0, size: 0.015, glow: 'violet' }] },
		];
		RINGS.forEach((rg, i) => {
			const r = rng(300 + i);
			rg.rgbArr = rg.rgb.split(',').map(Number);
			rg.dust = rg.belt ? Array.from({ length: 300 }, () => ({ a: r() * TAU, dr: (r() - 0.5) * 0.04, dz: (r() - 0.5) * 0.03, s: 0.7 + r() * 1.5 })) : [];
			rg.moons.forEach((m) => (m.trail = []));
		});
		const rs = rng(128);
		const STARS = Array.from({ length: 150 }, () => ({ x: rs(), y: rs(), z: 0.2 + rs() * 0.8, s: 0.6 + rs() * 1.8, p: rs() * TAU, f: 0.9 + rs() * 2.5 }));

		let S = 0;
		let dpr = 1;
		let q = { seg: 140, wide: true, step: 1, stars: 150, trail: 36 };
		let rx = -0.28;
		let ry = 0;
		let tx = 0;
		let ty = 0;
		let boost = 0;
		let pulse = 0;
		const shocks = [];
		const sparks = [];
		let meteor = null;
		let nextMeteor = 1.5;
		let time = 0;
		let introT = 0;
		let burstDone = false;

		function resize() {
			const rect = host.getBoundingClientRect();
			S = Math.max(160, Math.round(rect.width * 1.2)); // 略微放大画布确保边缘无裁剪
			dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas.width = Math.round(S * dpr);
			canvas.height = Math.round(S * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		}

		const F = 2.4;
		function project(x, y, z) {
			const x1 = x * Math.cos(ry) + z * Math.sin(ry);
			const z1 = -x * Math.sin(ry) + z * Math.cos(ry);
			const y2 = y * Math.cos(rx) - z1 * Math.sin(rx);
			const z2 = y * Math.sin(rx) + z1 * Math.cos(rx);
			const s = F / (F - z2);
			return { x: S / 2 + x1 * s * S, y: S / 2 + y2 * s * S, z: z2, s };
		}
		function ringPoint(rg, a, rScale, dr = 0, dz = 0) {
			const R = (rg.R + dr) * rScale;
			let x = Math.cos(a) * R;
			let y = Math.sin(a) * R;
			let z = dz;
			const y1 = y * Math.cos(rg.tilt) - z * Math.sin(rg.tilt);
			const z1 = y * Math.sin(rg.tilt) + z * Math.cos(rg.tilt);
			const x2 = x * Math.cos(rg.roll) - y1 * Math.sin(rg.roll);
			const y2 = x * Math.sin(rg.roll) + y1 * Math.cos(rg.roll);
			return project(x2, y2, z1);
		}

		function drawGlowSprite(name, x, y, r, alpha) {
			ctx.globalAlpha = alpha;
			ctx.drawImage(glow[name], x - r, y - r, r * 2, r * 2);
		}

		function drawNebula(intro) {
			const t = time;
			ctx.globalCompositeOperation = 'lighter';
			const blobs = [
				[0.5, 0.48, 0.7, '60,110,255', 0.45 + Math.sin(t * 0.4) * 0.1],
				[0.22, 0.25, 0.4, '140,80,255', 0.32 + Math.sin(t * 0.6 + 1) * 0.08],
				[0.8, 0.75, 0.45, '255,190,60', 0.25 + Math.sin(t * 0.5 + 2) * 0.06],
				[0.62, 0.22, 0.35, '94,234,212', 0.22 + Math.cos(t * 0.55) * 0.06],
			];
			for (const [bx, by, br, rgb, a] of blobs) {
				const grd = ctx.createRadialGradient(bx * S, by * S, 0, bx * S, by * S, br * S);
				grd.addColorStop(0, `rgba(${rgb},${a * intro})`);
				grd.addColorStop(1, `rgba(${rgb},0)`);
				ctx.fillStyle = grd;
				ctx.fillRect(0, 0, S, S);
			}
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawStars(intro) {
			ctx.globalCompositeOperation = 'lighter';
			const n = q.stars;
			for (let i = 0; i < n; i++) {
				const st = STARS[i];
				const px = ((st.x * S + ry * -60 * st.z) % S + S) % S;
				const py = ((st.y * S + rx * -60 * st.z) % S + S) % S;
				const tw = 0.45 + 0.55 * Math.sin(time * st.f + st.p);
				drawGlowSprite(st.s > 1.4 ? 'gold' : st.s > 1.1 ? 'teal' : 'white', px, py, st.s * 3.8, tw * st.z * intro);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawFlare(intro) {
			const x = S * 0.22;
			const y = S * 0.18;
			const pulseFactor = 0.85 + 0.15 * Math.sin(time * 1.6);
			ctx.globalCompositeOperation = 'lighter';
			drawGlowSprite('gold', x, y, S * 0.18 * pulseFactor, 0.65 * intro);
			drawGlowSprite('white', x, y, S * 0.05, intro);
			const g = ctx.createLinearGradient(x - S * 0.35, y, x + S * 0.35, y);
			g.addColorStop(0, 'rgba(255,235,170,0)');
			g.addColorStop(0.5, `rgba(255,250,220,${0.75 * intro})`);
			g.addColorStop(1, 'rgba(255,235,170,0)');
			ctx.globalAlpha = 1;
			ctx.fillStyle = g;
			ctx.fillRect(x - S * 0.35, y - 1.2, S * 0.7, 2.4);
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawRingPass(rg, rScale, alpha, front) {
			const N = q.seg;
			const [r, g, b] = rg.rgbArr;
			ctx.lineCap = 'round';
			let prev = ringPoint(rg, 0, rScale);
			for (let i = 1; i <= N; i++) {
				const cur = ringPoint(rg, (i / N) * TAU, rScale);
				const zAvg = (prev.z + cur.z) / 2;
				if ((zAvg >= 0) === front) {
					const depth = clamp(0.5 + zAvg / (rg.R * 2.2), 0.15, 1);
					const a = alpha * (front ? 0.48 + 0.52 * depth : 0.16 + 0.44 * depth);
					ctx.beginPath();
					ctx.moveTo(prev.x, prev.y);
					ctx.lineTo(cur.x, cur.y);
					if (q.wide) {
						ctx.strokeStyle = `rgba(${r},${g},${b},${a * 0.25})`;
						ctx.lineWidth = 7 * cur.s;
						ctx.stroke();
					}
					ctx.strokeStyle = `rgba(${r},${g},${b},${a})`;
					ctx.lineWidth = (front ? 1.9 : 1.3) * cur.s;
					ctx.stroke();
				}
				prev = cur;
			}
		}

		function drawDust(rg, rScale, alpha, front) {
			ctx.globalCompositeOperation = 'lighter';
			for (const d of rg.dust) {
				const p = ringPoint(rg, d.a + time * rg.speed * 0.5, rScale, d.dr, d.dz);
				if ((p.z >= 0) !== front) continue;
				const a = alpha * (front ? 0.95 : 0.48) * clamp(0.5 + p.z / 0.4, 0.2, 1);
				ctx.fillStyle = `rgba(210,255,255,${a})`;
				const sz = d.s * p.s;
				ctx.fillRect(p.x - sz / 2, p.y - sz / 2, sz, sz);
			}
			ctx.globalCompositeOperation = 'source-over';
		}

		function moonPos(rg, m, rScale) {
			return ringPoint(rg, m.a + time * rg.speed * (1 + boost * 2) + (m.off || 0), rScale);
		}

		function drawMoons(rg, rScale, alpha, front) {
			ctx.globalCompositeOperation = 'lighter';
			for (const m of rg.moons) {
				const p = m.cur;
				if (!p || (p.z >= 0) !== front) continue;
				const tr = m.trail;
				for (let i = 1; i < tr.length; i++) {
					const k = i / tr.length;
					ctx.strokeStyle = `rgba(${rg.rgb},${k * k * 0.9 * alpha})`;
					ctx.lineWidth = k * m.size * S * 1.9 * p.s;
					ctx.lineCap = 'round';
					ctx.beginPath();
					ctx.moveTo(tr[i - 1].x, tr[i - 1].y);
					ctx.lineTo(tr[i].x, tr[i].y);
					ctx.stroke();
				}
				const rad = m.size * S * p.s * (front ? 1.25 : 0.95);
				drawGlowSprite(m.glow, p.x, p.y, rad * 4.5, alpha * 0.92);
				drawGlowSprite('white', p.x, p.y, rad * 1.45, alpha);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawPlanet(cx, cy, R, scale, alpha) {
			const Rp = R * scale;
			ctx.save();
			ctx.globalAlpha = alpha;
			
			ctx.globalCompositeOperation = 'lighter';
			const halo = ctx.createRadialGradient(cx, cy, Rp * 0.75, cx, cy, Rp * 2.4);
			halo.addColorStop(0, 'rgba(100,190,255,0.7)');
			halo.addColorStop(0.35, 'rgba(140,110,255,0.3)');
			halo.addColorStop(1, 'rgba(40,70,220,0)');
			ctx.fillStyle = halo;
			ctx.beginPath();
			ctx.arc(cx, cy, Rp * 2.4, 0, TAU);
			ctx.fill();
			ctx.globalCompositeOperation = 'source-over';

			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(-0.22);
			ctx.beginPath();
			ctx.arc(0, 0, Rp, 0, TAU);
			ctx.clip();
			const rot = (time * 32) % TEX_W;
			const step = q.step;
			for (let dx = -Rp; dx < Rp; dx += step) {
				const nx = clamp((dx + step / 2) / Rp, -0.999, 0.999);
				const s = Math.sqrt(1 - nx * nx);
				const u = Math.asin(nx);
				const fx = (u + Math.PI / 2) / Math.PI;
				const sx = (rot + fx * TEX_VIS) % TEX_W;
				const sw = clamp((step / (Rp * Math.max(0.06, s))) * (TEX_VIS / Math.PI), 1, TEX_EXTRA - 2);
				ctx.drawImage(tex, sx, 0, sw, TEX_H, dx, -Rp, step + 0.7, Rp * 2);
			}
			ctx.restore();

			ctx.beginPath();
			ctx.arc(cx, cy, Rp, 0, TAU);
			ctx.save();
			ctx.clip();
			const lg = ctx.createRadialGradient(cx - Rp * 0.45, cy - Rp * 0.48, Rp * 0.05, cx - Rp * 0.2, cy - Rp * 0.22, Rp * 1.8);
			lg.addColorStop(0, 'rgba(255,255,255,0.45)');
			lg.addColorStop(0.28, 'rgba(255,255,255,0.06)');
			lg.addColorStop(0.6, 'rgba(3,6,26,0.55)');
			lg.addColorStop(1, 'rgba(1,2,10,0.98)');
			ctx.fillStyle = lg;
			ctx.fillRect(cx - Rp, cy - Rp, Rp * 2, Rp * 2);

			ctx.globalCompositeOperation = 'lighter';
			const rim = ctx.createRadialGradient(cx + Rp * 0.12, cy + Rp * 0.15, Rp * 0.65, cx, cy, Rp * 1.02);
			rim.addColorStop(0, 'rgba(0,0,0,0)');
			rim.addColorStop(1, 'rgba(140,220,255,0.65)');
			ctx.fillStyle = rim;
			ctx.fillRect(cx - Rp, cy - Rp, Rp * 2, Rp * 2);
			ctx.restore();

			const ring = ctx.createLinearGradient(cx - Rp, cy - Rp, cx + Rp, cy + Rp);
			ring.addColorStop(0, 'rgba(200,250,255,1)');
			ring.addColorStop(0.5, 'rgba(140,180,255,0.4
