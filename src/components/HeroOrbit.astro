---
interface Props {
	/** 星球中央浮现的品牌字母 */
	initial?: string;
}
const { initial = 'R' } = Astro.props;
---

<div class="ho" data-hero-orbit data-initial={initial} aria-hidden="true">
	<canvas class="ho-canvas"></canvas>
</div>

<style>
	.ho {
		position: relative;
		width: 100%;
		max-width: 520px;
		aspect-ratio: 1 / 1;
		margin: 0 auto;
		background: radial-gradient(circle at 50% 50%, rgba(59, 91, 219, 0.28) 0%, rgba(59, 91, 219, 0) 62%);
	}
	.ho-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		touch-action: pan-y;
		cursor: pointer;
	}
</style>

<script>
	const TAU = Math.PI * 2;
	const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
	const lerp = (a, b, t) => a + (b - a) * t;
	const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
	const easeOutBack = (t) => {
		const c1 = 1.70158;
		const c3 = c1 + 1;
		return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
	};
	const smooth = (a, b, x) => {
		const t = clamp((x - a) / (b - a), 0, 1);
		return t * t * (3 - 2 * t);
	};
	function rng(seed) {
		let s = seed >>> 0;
		return () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
	}
	const hexRgb = (h) => {
		const n = parseInt(h.slice(1), 16);
		return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
	};

	// ---------- 星球贴图：横向无缝的气态巨行星条带 ----------
	const TEX_W = 1024;
	const TEX_H = 256;
	const TEX_EXTRA = 96;
	const TEX_VIS = TEX_W / 2; // 可见半球对应的贴图宽度
	function makeTexture() {
		const c = document.createElement('canvas');
		c.width = TEX_W + TEX_EXTRA;
		c.height = TEX_H;
		const g = c.getContext('2d');
		const r = rng(11);
		const base = g.createLinearGradient(0, 0, 0, TEX_H);
		base.addColorStop(0, '#0f1f52');
		base.addColorStop(0.28, '#27439f');
		base.addColorStop(0.5, '#3857d6');
		base.addColorStop(0.72, '#27439f');
		base.addColorStop(1, '#0c1946');
		g.fillStyle = base;
		g.fillRect(0, 0, c.width, TEX_H);
		for (let i = 0; i < 52; i++) {
			const y = r() * TEX_H;
			const h = 3 + r() * 17;
			const k = r();
			const col = k < 0.42 ? '245,198,58' : k < 0.78 ? '165,185,255' : '94,234,212';
			const a = 0.06 + r() * 0.18;
			const ph = r() * TAU;
			const amp = 1 + r() * 4.5;
			const fq = 2 + Math.floor(r() * 5); // 整数频率 → 左右无缝
			g.fillStyle = `rgba(${col},${a})`;
			g.beginPath();
			g.moveTo(0, y);
			for (let x = 0; x <= c.width; x += 16) g.lineTo(x, y + Math.sin((x / TEX_W) * TAU * fq + ph) * amp);
			for (let x = c.width; x >= 0; x -= 16) g.lineTo(x, y + h + Math.sin((x / TEX_W) * TAU * fq + ph + 1) * amp);
			g.closePath();
			g.fill();
		}
		// 风暴旋涡（画两份保证无缝）
		for (const [sx, sy, rw, rh] of [[300, 150, 62, 22], [760, 90, 40, 14]]) {
			for (const ox of [0, TEX_W]) {
				const grd = g.createRadialGradient(sx + ox, sy, 2, sx + ox, sy, rw);
				grd.addColorStop(0, 'rgba(255,226,130,0.95)');
				grd.addColorStop(0.5, 'rgba(245,170,50,0.55)');
				grd.addColorStop(1, 'rgba(245,170,50,0)');
				g.save();
				g.translate(sx + ox, sy);
				g.scale(1, rh / rw);
				g.translate(-(sx + ox), -sy);
				g.fillStyle = grd;
				g.beginPath();
				g.arc(sx + ox, sy, rw, 0, TAU);
				g.fill();
				g.restore();
			}
		}
		return c;
	}

	// ---------- 光点精灵 ----------
	function makeGlow(rgb) {
		const s = 64;
		const c = document.createElement('canvas');
		c.width = c.height = s;
		const g = c.getContext('2d');
		const grd = g.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
		grd.addColorStop(0, `rgba(${rgb},1)`);
		grd.addColorStop(0.18, `rgba(${rgb},0.85)`);
		grd.addColorStop(0.45, `rgba(${rgb},0.28)`);
		grd.addColorStop(1, `rgba(${rgb},0)`);
		g.fillStyle = grd;
		g.fillRect(0, 0, s, s);
		return c;
	}

	function initOrbit(host) {
		const canvas = host.querySelector('canvas');
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		const initial = host.dataset.initial || 'R';
		const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
		const tex = makeTexture();
		const glow = { white: makeGlow('255,255,255'), gold: makeGlow('245,198,58'), teal: makeGlow('94,234,212'), blue: makeGlow('143,168,255'), violet: makeGlow('160,130,255') };

		const RINGS = [
			{ R: 0.245, tilt: 1.12, roll: -0.35, speed: 0.62, rgb: '143,168,255', moons: [{ a: 0.4, size: 0.012, glow: 'white' }] },
			{ R: 0.292, tilt: 0.98, roll: 0.55, speed: -0.42, rgb: '94,234,212', belt: true, moons: [{ a: 2.1, size: 0.017, glow: 'teal' }, { a: 5.0, size: 0.009, glow: 'white' }] },
			{ R: 0.336, tilt: 1.3, roll: -1.0, speed: 0.3, rgb: '245,198,58', moons: [{ a: 1.0, size: 0.021, glow: 'gold' }] },
			{ R: 0.38, tilt: 0.78, roll: 1.9, speed: -0.2, rgb: '165,185,255', moons: [{ a: 3.8, size: 0.012, glow: 'violet' }] },
		];
		RINGS.forEach((rg, i) => {
			const r = rng(100 + i);
			rg.rgbArr = rg.rgb.split(',').map(Number);
			rg.dust = rg.belt ? Array.from({ length: 190 }, () => ({ a: r() * TAU, dr: (r() - 0.5) * 0.03, dz: (r() - 0.5) * 0.02, s: 0.4 + r() * 1.1 })) : [];
			rg.moons.forEach((m) => (m.trail = []));
		});
		const rs = rng(5);
		const STARS = Array.from({ length: 80 }, () => ({ x: rs(), y: rs(), z: 0.2 + rs() * 0.8, s: 0.5 + rs() * 1.3, p: rs() * TAU, f: 0.6 + rs() * 1.8 }));

		let S = 0;
		let dpr = 1;
		let q = { seg: 96, wide: true, step: 1, stars: 80, trail: 26 };
		let rx = -0.28;
		let ry = 0;
		let tx = 0;
		let ty = 0;
		let boost = 0;
		let pulse = 0;
		const shocks = [];
		const sparks = [];
		let meteor = null;
		let nextMeteor = 2.5;
		let time = 0;
		let introT = 0;
		let burstDone = false;

		function resize() {
			const rect = host.getBoundingClientRect();
			S = Math.max(160, Math.round(rect.width));
			dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas.width = Math.round(S * dpr);
			canvas.height = Math.round(S * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		}

		// 3D 投影：ring 点 → 屏幕
		const F = 2.4;
		function project(x, y, z) {
			const x1 = x * Math.cos(ry) + z * Math.sin(ry);
			const z1 = -x * Math.sin(ry) + z * Math.cos(ry);
			const y2 = y * Math.cos(rx) - z1 * Math.sin(rx);
			const z2 = y * Math.sin(rx) + z1 * Math.cos(rx);
			const s = F / (F - z2);
			return { x: S / 2 + x1 * s * S, y: S / 2 + y2 * s * S, z: z2, s };
		}
		function ringPoint(rg, a, rScale, dr = 0, dz = 0) {
			const R = (rg.R + dr) * rScale;
			let x = Math.cos(a) * R;
			let y = Math.sin(a) * R;
			let z = dz;
			const y1 = y * Math.cos(rg.tilt) - z * Math.sin(rg.tilt);
			const z1 = y * Math.sin(rg.tilt) + z * Math.cos(rg.tilt);
			const x2 = x * Math.cos(rg.roll) - y1 * Math.sin(rg.roll);
			const y2 = x * Math.sin(rg.roll) + y1 * Math.cos(rg.roll);
			return project(x2, y2, z1);
		}

		function drawGlowSprite(name, x, y, r, alpha) {
			ctx.globalAlpha = alpha;
			ctx.drawImage(glow[name], x - r, y - r, r * 2, r * 2);
		}

		function drawNebula(intro) {
			const t = time;
			ctx.globalCompositeOperation = 'lighter';
			const blobs = [
				[0.5, 0.5, 0.52, '59,91,219', 0.34 + Math.sin(t * 0.5) * 0.05],
				[0.28, 0.3, 0.3, '124,92,255', 0.2 + Math.sin(t * 0.7 + 1) * 0.05],
				[0.74, 0.72, 0.32, '245,170,60', 0.13 + Math.sin(t * 0.6 + 2) * 0.04],
			];
			for (const [bx, by, br, rgb, a] of blobs) {
				const grd = ctx.createRadialGradient(bx * S, by * S, 0, bx * S, by * S, br * S);
				grd.addColorStop(0, `rgba(${rgb},${a * intro})`);
				grd.addColorStop(1, `rgba(${rgb},0)`);
				ctx.fillStyle = grd;
				ctx.fillRect(0, 0, S, S);
			}
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawStars(intro) {
			ctx.globalCompositeOperation = 'lighter';
			const n = q.stars;
			for (let i = 0; i < n; i++) {
				const st = STARS[i];
				const px = ((st.x * S + ry * -60 * st.z) % S + S) % S;
				const py = ((st.y * S + rx * -60 * st.z) % S + S) % S;
				const tw = 0.55 + 0.45 * Math.sin(time * st.f + st.p);
				drawGlowSprite(st.s > 1.3 ? 'gold' : 'white', px, py, st.s * 3.2, tw * st.z * 0.9 * intro);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawFlare(intro) {
			const x = S * 0.25;
			const y = S * 0.2;
			const pulse = 0.85 + 0.15 * Math.sin(time * 1.3);
			ctx.globalCompositeOperation = 'lighter';
			drawGlowSprite('gold', x, y, S * 0.13 * pulse, 0.5 * intro);
			drawGlowSprite('white', x, y, S * 0.034, 0.95 * intro);
			const g = ctx.createLinearGradient(x - S * 0.23, y, x + S * 0.23, y);
			g.addColorStop(0, 'rgba(255,235,170,0)');
			g.addColorStop(0.5, `rgba(255,240,190,${0.55 * intro})`);
			g.addColorStop(1, 'rgba(255,235,170,0)');
			ctx.globalAlpha = 1;
			ctx.fillStyle = g;
			ctx.fillRect(x - S * 0.23, y - 0.8, S * 0.46, 1.6);
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawRingPass(rg, rScale, alpha, front) {
			const N = q.seg;
			const [r, g, b] = rg.rgbArr;
			ctx.lineCap = 'round';
			let prev = ringPoint(rg, 0, rScale);
			for (let i = 1; i <= N; i++) {
				const cur = ringPoint(rg, (i / N) * TAU, rScale);
				const zAvg = (prev.z + cur.z) / 2;
				if ((zAvg >= 0) === front) {
					const depth = clamp(0.5 + zAvg / (rg.R * 2.2), 0.15, 1);
					const a = alpha * (front ? 0.35 + 0.65 * depth : 0.12 + 0.4 * depth);
					ctx.beginPath();
					ctx.moveTo(prev.x, prev.y);
					ctx.lineTo(cur.x, cur.y);
					if (q.wide) {
						ctx.strokeStyle = `rgba(${r},${g},${b},${a * 0.16})`;
						ctx.lineWidth = 5 * cur.s;
						ctx.stroke();
					}
					ctx.strokeStyle = `rgba(${r},${g},${b},${a})`;
					ctx.lineWidth = (front ? 1.5 : 1.1) * cur.s;
					ctx.stroke();
				}
				prev = cur;
			}
		}

		function drawDust(rg, rScale, alpha, front) {
			ctx.globalCompositeOperation = 'lighter';
			for (const d of rg.dust) {
				const p = ringPoint(rg, d.a + time * rg.speed * 0.5, rScale, d.dr, d.dz);
				if ((p.z >= 0) !== front) continue;
				const a = alpha * (front ? 0.85 : 0.4) * clamp(0.5 + p.z / 0.4, 0.2, 1);
				ctx.fillStyle = `rgba(180,255,240,${a})`;
				const sz = d.s * p.s;
				ctx.fillRect(p.x - sz / 2, p.y - sz / 2, sz, sz);
			}
			ctx.globalCompositeOperation = 'source-over';
		}

		function moonPos(rg, m, rScale) {
			return ringPoint(rg, m.a + time * rg.speed * (1 + boost * 2) + (m.off || 0), rScale);
		}

		function drawMoons(rg, rScale, alpha, front) {
			ctx.globalCompositeOperation = 'lighter';
			for (const m of rg.moons) {
				const p = m.cur;
				if (!p || (p.z >= 0) !== front) continue;
				const tr = m.trail;
				for (let i = 1; i < tr.length; i++) {
					const k = i / tr.length;
					ctx.strokeStyle = `rgba(${rg.rgb},${k * k * 0.75 * alpha})`;
					ctx.lineWidth = k * m.size * S * 1.5 * p.s;
					ctx.lineCap = 'round';
					ctx.beginPath();
					ctx.moveTo(tr[i - 1].x, tr[i - 1].y);
					ctx.lineTo(tr[i].x, tr[i].y);
					ctx.stroke();
				}
				const rad = m.size * S * p.s * (front ? 1.15 : 0.9);
				drawGlowSprite(m.glow, p.x, p.y, rad * 3.6, alpha * 0.85);
				drawGlowSprite('white', p.x, p.y, rad * 1.3, alpha);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawPlanet(cx, cy, R, scale, alpha) {
			const Rp = R * scale;
			ctx.save();
			ctx.globalAlpha = alpha;
			// 外层大气辉光
			ctx.globalCompositeOperation = 'lighter';
			const halo = ctx.createRadialGradient(cx, cy, Rp * 0.85, cx, cy, Rp * 1.9);
			halo.addColorStop(0, 'rgba(94,160,255,0.55)');
			halo.addColorStop(0.35, 'rgba(120,110,255,0.22)');
			halo.addColorStop(1, 'rgba(60,80,220,0)');
			ctx.fillStyle = halo;
			ctx.beginPath();
			ctx.arc(cx, cy, Rp * 1.9, 0, TAU);
			ctx.fill();
			ctx.globalCompositeOperation = 'source-over';

			// 自转的球面贴图
			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(-0.22);
			ctx.beginPath();
			ctx.arc(0, 0, Rp, 0, TAU);
			ctx.clip();
			const rot = (time * 26) % TEX_W;
			const step = q.step;
			for (let dx = -Rp; dx < Rp; dx += step) {
				const nx = clamp((dx + step / 2) / Rp, -0.999, 0.999);
				const s = Math.sqrt(1 - nx * nx);
				const u = Math.asin(nx);
				const fx = (u + Math.PI / 2) / Math.PI;
				const sx = (rot + fx * TEX_VIS) % TEX_W;
				const sw = clamp((step / (Rp * Math.max(0.06, s))) * (TEX_VIS / Math.PI), 1, TEX_EXTRA - 2);
				ctx.drawImage(tex, sx, 0, sw, TEX_H, dx, -Rp, step + 0.7, Rp * 2);
			}
			ctx.restore();

			// 明暗交界：光源在左上
			ctx.beginPath();
			ctx.arc(cx, cy, Rp, 0, TAU);
			ctx.save();
			ctx.clip();
			const lg = ctx.createRadialGradient(cx - Rp * 0.42, cy - Rp * 0.46, Rp * 0.05, cx - Rp * 0.2, cy - Rp * 0.22, Rp * 1.75);
			lg.addColorStop(0, 'rgba(255,255,255,0.34)');
			lg.addColorStop(0.28, 'rgba(255,255,255,0.03)');
			lg.addColorStop(0.62, 'rgba(6,10,36,0.42)');
			lg.addColorStop(1, 'rgba(2,4,16,0.93)');
			ctx.fillStyle = lg;
			ctx.fillRect(cx - Rp, cy - Rp, Rp * 2, Rp * 2);
			// 左下与右上的冷暖反光
			ctx.globalCompositeOperation = 'lighter';
			const rim = ctx.createRadialGradient(cx + Rp * 0.1, cy + Rp * 0.15, Rp * 0.7, cx, cy, Rp * 1.02);
			rim.addColorStop(0, 'rgba(0,0,0,0)');
			rim.addColorStop(1, 'rgba(110,190,255,0.5)');
			ctx.fillStyle = rim;
			ctx.fillRect(cx - Rp, cy - Rp, Rp * 2, Rp * 2);
			ctx.restore();

			// 极光般的边缘光
			const ring = ctx.createLinearGradient(cx - Rp, cy - Rp, cx + Rp, cy + Rp);
			ring.addColorStop(0, 'rgba(160,230,255,0.95)');
			ring.addColorStop(0.5, 'rgba(120,150,255,0.25)');
			ring.addColorStop(1, 'rgba(245,198,58,0.8)');
			ctx.globalCompositeOperation = 'lighter';
			ctx.strokeStyle = ring;
			ctx.lineWidth = 1.6;
			ctx.beginPath();
			ctx.arc(cx, cy, Rp - 0.5, 0, TAU);
			ctx.stroke();
			ctx.globalCompositeOperation = 'source-over';

			// 品牌字母：像刻在星球上的金色全息字
			ctx.font = `800 ${Rp * 1.0}px system-ui, -apple-system, "Segoe UI", sans-serif`;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			const tg = ctx.createLinearGradient(0, cy - Rp * 0.5, 0, cy + Rp * 0.5);
			tg.addColorStop(0, 'rgba(255,244,190,0.95)');
			tg.addColorStop(0.5, 'rgba(245,198,58,0.88)');
			tg.addColorStop(1, 'rgba(184,134,11,0.8)');
			ctx.shadowColor = 'rgba(245,198,58,0.85)';
			ctx.shadowBlur = Rp * 0.45;
			ctx.fillStyle = tg;
			ctx.fillText(initial, cx, cy + Rp * 0.04);
			ctx.restore();
		}

		function drawShocks() {
			ctx.globalCompositeOperation = 'lighter';
			for (let i = shocks.length - 1; i >= 0; i--) {
				const k = (time - shocks[i].t0) / shocks[i].dur;
				if (k >= 1) {
					shocks.splice(i, 1);
					continue;
				}
				if (k < 0) continue; // 延迟出现的第二圈冲击波
				const e = easeOutCubic(k);
				const r = e * S * shocks[i].max;
				ctx.strokeStyle = `rgba(${shocks[i].rgb},${(1 - k) * 0.85})`;
				ctx.lineWidth = (1 - k) * 4 + 0.5;
				ctx.beginPath();
				ctx.arc(S / 2, S / 2, r, 0, TAU);
				ctx.stroke();
			}
			for (let i = sparks.length - 1; i >= 0; i--) {
				const sp = sparks[i];
				const age = time - sp.t0;
				if (age > sp.life) {
					sparks.splice(i, 1);
					continue;
				}
				const k = age / sp.life;
				const d = easeOutCubic(k) * sp.dist * S;
				drawGlowSprite(sp.glow, S / 2 + Math.cos(sp.ang) * d, S / 2 + Math.sin(sp.ang) * d, sp.size * (1 - k * 0.6), (1 - k) * 0.95);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function burst(strength = 1) {
			shocks.push({ t0: time, dur: 1.1, max: 0.5, rgb: '245,198,58' });
			shocks.push({ t0: time + 0.12, dur: 1.3, max: 0.56, rgb: '120,170,255' });
			const n = Math.round(30 * strength);
			for (let i = 0; i < n; i++) {
				sparks.push({ t0: time, life: 0.9 + Math.random() * 0.9, ang: Math.random() * TAU, dist: 0.18 + Math.random() * 0.3, size: 5 + Math.random() * 9, glow: ['gold', 'white', 'teal', 'blue'][i % 4] });
			}
			pulse = 1;
			boost = 1;
		}

		function drawMeteor(dt) {
			nextMeteor -= dt;
			if (!meteor && nextMeteor <= 0) {
				meteor = { x: S * (0.55 + Math.random() * 0.5), y: -S * 0.05 + Math.random() * S * 0.3, v: S * (0.9 + Math.random() * 0.6), len: S * (0.16 + Math.random() * 0.12), t: 0 };
				nextMeteor = 3 + Math.random() * 4;
			}
			if (!meteor) return;
			meteor.t += dt;
			const ang = Math.PI * 0.78;
			const dx = Math.cos(ang);
			const dy = Math.sin(ang);
			const hx = meteor.x + dx * meteor.v * meteor.t;
			const hy = meteor.y + dy * meteor.v * meteor.t;
			const tx2 = hx - dx * meteor.len;
			const ty2 = hy - dy * meteor.len;
			const grd = ctx.createLinearGradient(hx, hy, tx2, ty2);
			grd.addColorStop(0, 'rgba(255,245,200,0.95)');
			grd.addColorStop(0.3, 'rgba(245,198,58,0.5)');
			grd.addColorStop(1, 'rgba(245,198,58,0)');
			ctx.globalCompositeOperation = 'lighter';
			ctx.strokeStyle = grd;
			ctx.lineWidth = 1.8;
			ctx.lineCap = 'round';
			ctx.beginPath();
			ctx.moveTo(hx, hy);
			ctx.lineTo(tx2, ty2);
			ctx.stroke();
			ctx.globalCompositeOperation = 'source-over';
			if (hx < -S * 0.2 || hy > S * 1.2) meteor = null;
		}

		// ---------- 主渲染 ----------
		function frame(dt) {
			time += dt;
			introT = Math.min(1, introT + dt / 2.6);
			const iNeb = smooth(0, 0.5, introT);
			const iPlanet = easeOutBack(clamp(introT / 0.55, 0, 1));
			const iPlanetA = smooth(0, 0.3, introT);
			const iRing = easeOutCubic(clamp((introT - 0.12) / 0.7, 0, 1));
			const iRingA = smooth(0.1, 0.55, introT);
			const iMoon = smooth(0.4, 0.9, introT);
			if (!burstDone && introT > 0.16) {
				burstDone = true;
				burst(0.8);
			}
			boost *= Math.pow(0.35, dt);
			pulse *= Math.pow(0.04, dt);
			// 视角：指针视差 + 缓慢自摆
			ry += ((tx * 0.5 + Math.sin(time * 0.27) * 0.14) - ry) * Math.min(1, dt * 4);
			rx += ((-0.28 + ty * 0.3 + Math.sin(time * 0.21 + 1) * 0.05) - rx) * Math.min(1, dt * 4);

			ctx.clearRect(0, 0, S, S);
			drawNebula(iNeb);
			drawStars(iNeb);
			drawFlare(iNeb);
			drawMeteor(dt);

			const rScale = 0.4 + 0.6 * iRing;
			// 先更新月亮位置与拖尾
			for (const rg of RINGS) {
				for (const m of rg.moons) {
					m.cur = moonPos(rg, m, rScale);
					m.acc = (m.acc || 0) + dt;
					if (m.acc > 0.016) {
						m.acc = 0;
						m.trail.push({ x: m.cur.x, y: m.cur.y });
						if (m.trail.length > q.trail) m.trail.shift();
					}
				}
			}
			// 背面：轨道、尘埃、月亮
			for (const rg of RINGS) {
				drawRingPass(rg, rScale, iRingA, false);
				if (rg.belt) drawDust(rg, rScale, iRingA, false);
				drawMoons(rg, rScale, iMoon, false);
			}
			// 星球
			const pr = 0.158 * S;
			drawPlanet(S / 2, S / 2, pr, iPlanet * (1 + pulse * 0.05), iPlanetA);
			// 正面：轨道、尘埃、月亮
			for (const rg of RINGS) {
				drawRingPass(rg, rScale, iRingA, true);
				if (rg.belt) drawDust(rg, rScale, iRingA, true);
				drawMoons(rg, rScale, iMoon, true);
			}
			drawShocks();
		}

		// ---------- 交互 ----------
		function onPointer(e) {
			const r = host.getBoundingClientRect();
			const cx = r.left + r.width / 2;
			const cy = r.top + r.height / 2;
			tx = clamp((e.clientX - cx) / (window.innerWidth / 2), -1, 1);
			ty = clamp((e.clientY - cy) / (window.innerHeight / 2), -1, 1);
		}
		let running = false;
		let last = 0;
		let slow = 0;
		let raf = 0;
		function loop(now) {
			if (!running) return;
			const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
			last = now;
			// 自适应画质：持续掉帧时自动降级
			if (q.seg === 96) {
				slow = dt > 0.03 ? slow + 1 : Math.max(0, slow - 1);
				if (slow > 70) q = { seg: 56, wide: false, step: 2, stars: 40, trail: 14 };
			}
			frame(dt);
			raf = requestAnimationFrame(loop);
		}
		function start() {
			if (running || reduce) return;
			running = true;
			last = 0;
			raf = requestAnimationFrame(loop);
		}
		function stop() {
			running = false;
			cancelAnimationFrame(raf);
		}

		resize();
		if (reduce) {
			// 静态画面：跳过动画，直接渲染一帧成品
			introT = 1;
			burstDone = true;
			frame(4);
		} else {
			window.addEventListener('pointermove', onPointer, { passive: true });
			canvas.addEventListener('pointerdown', (e) => {
				onPointer(e);
				burst(1);
			});
			new IntersectionObserver((es) => (es[0].isIntersecting && !document.hidden ? start() : stop()), { threshold: 0.01 }).observe(host);
			document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
		}
		new ResizeObserver(() => {
			resize();
			if (reduce) frame(0);
		}).observe(host);
		// 测试/调试钩子
		host.__orbit = { burst, advance: (s) => { for (let i = 0; i < s * 60; i++) frame(1 / 60); }, setPointer: (x, y) => { tx = x; ty = y; }, stop, running: () => running };
	}

	document.querySelectorAll('[data-hero-orbit]').forEach(initOrbit);
</script>
