---
interface Props {
	/** 星球中央浮现的品牌字母 */
	initial?: string;
}
const { initial = 'R' } = Astro.props;
---

<div class="ho" data-hero-orbit data-initial={initial} aria-hidden="true">
	<canvas class="ho-canvas"></canvas>
</div>

<style>
	.ho {
		position: relative;
		width: 100%;
		max-width: 520px;
		aspect-ratio: 1 / 1;
		margin: 0 auto;
		background: radial-gradient(circle at 50% 50%, rgba(79, 119, 255, 0.38) 0%, rgba(20, 32, 74, 0.2) 50%, rgba(11, 16, 32, 0) 75%);
	}
	.ho-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		touch-action: pan-y;
		cursor: pointer;
	}
</style>

<script>
	const TAU = Math.PI * 2;
	const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
	const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
	const easeOutBack = (t) => {
		const c1 = 1.70158;
		const c3 = c1 + 1;
		return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
	};
	const smooth = (a, b, x) => {
		const t = clamp((x - a) / (b - a), 0, 1);
		return t * t * (3 - 2 * t);
	};
	function rng(seed) {
		let s = seed >>> 0;
		return () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
	}

	// ---------- 震撼级星球贴图：层次丰富、色彩对比更强 ----------
	const TEX_W = 1024;
	const TEX_H = 256;
	const TEX_EXTRA = 96;
	const TEX_VIS = TEX_W / 2;
	function makeTexture() {
		const c = document.createElement('canvas');
		c.width = TEX_W + TEX_EXTRA;
		c.height = TEX_H;
		const g = c.getContext('2d');
		const r = rng(42);
		const base = g.createLinearGradient(0, 0, 0, TEX_H);
		base.addColorStop(0, '#060d26');
		base.addColorStop(0.22, '#18328c');
		base.addColorStop(0.48, '#4f75ff');
		base.addColorStop(0.75, '#1e389c');
		base.addColorStop(1, '#040818');
		g.fillStyle = base;
		g.fillRect(0, 0, c.width, TEX_H);

		for (let i = 0; i < 70; i++) {
			const y = r() * TEX_H;
			const h = 2 + r() * 22;
			const k = r();
			const col = k < 0.38 ? '255,215,90' : k < 0.75 ? '135,175,255' : '94,234,212';
			const a = 0.08 + r() * 0.26;
			const ph = r() * TAU;
			const amp = 1.5 + r() * 6;
			const fq = 2 + Math.floor(r() * 4);
			g.fillStyle = `rgba(${col},${a})`;
			g.beginPath();
			g.moveTo(0, y);
			for (let x = 0; x <= c.width; x += 16) g.lineTo(x, y + Math.sin((x / TEX_W) * TAU * fq + ph) * amp);
			for (let x = c.width; x >= 0; x -= 16) g.lineTo(x, y + h + Math.sin((x / TEX_W) * TAU * fq + ph + 1) * amp);
			g.closePath();
			g.fill();
		}
		// 宏大风暴旋涡
		for (const [sx, sy, rw, rh] of [[280, 140, 85, 28], [740, 80, 55, 18], [520, 200, 45, 15]]) {
			for (const ox of [0, TEX_W]) {
				const grd = g.createRadialGradient(sx + ox, sy, 2, sx + ox, sy, rw);
				grd.addColorStop(0, 'rgba(255,240,160,0.98)');
				grd.addColorStop(0.4, 'rgba(245,180,60,0.68)');
				grd.addColorStop(1, 'rgba(245,180,60,0)');
				g.save();
				g.translate(sx + ox, sy);
				g.scale(1, rh / rw);
				g.translate(-(sx + ox), -sy);
				g.fillStyle = grd;
				g.beginPath();
				g.arc(sx + ox, sy, rw, 0, TAU);
				g.fill();
				g.restore();
			}
		}
		return c;
	}

	function makeGlow(rgb) {
		const s = 64;
		const c = document.createElement('canvas');
		c.width = c.height = s;
		const g = c.getContext('2d');
		const grd = g.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
		grd.addColorStop(0, `rgba(${rgb},1)`);
		grd.addColorStop(0.2, `rgba(${rgb},0.88)`);
		grd.addColorStop(0.5, `rgba(${rgb},0.32)`);
		grd.addColorStop(1, `rgba(${rgb},0)`);
		g.fillStyle = grd;
		g.fillRect(0, 0, s, s);
		return c;
	}

	function initOrbit(host) {
		const canvas = host.querySelector('canvas');
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		const initial = host.dataset.initial || 'R';
		const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
		const tex = makeTexture();
		const glow = { 
			white: makeGlow('255,255,255'), 
			gold: makeGlow('255,215,90'), 
			teal: makeGlow('94,234,212'), 
			blue: makeGlow('135,175,255'), 
			violet: makeGlow('180,140,255') 
		};

		// 增强的四条史诗级轨道环
		const RINGS = [
			{ R: 0.23, tilt: 1.18, roll: -0.4, speed: 0.7, rgb: '135,175,255', moons: [{ a: 0.5, size: 0.014, glow: 'white' }] },
			{ R: 0.285, tilt: 0.92, roll: 0.62, speed: -0.48, rgb: '94,234,212', belt: true, moons: [{ a: 1.8, size: 0.019, glow: 'teal' }, { a: 4.5, size: 0.011, glow: 'white' }] },
			{ R: 0.34, tilt: 1.35, roll: -0.9, speed: 0.35, rgb: '255,215,90', moons: [{ a: 1.2, size: 0.023, glow: 'gold' }] },
			{ R: 0.395, tilt: 0.72, roll: 1.7, speed: -0.25, rgb: '180,140,255', moons: [{ a: 3.2, size: 0.014, glow: 'violet' }] },
		];
		RINGS.forEach((rg, i) => {
			const r = rng(200 + i);
			rg.rgbArr = rg.rgb.split(',').map(Number);
			rg.dust = rg.belt ? Array.from({ length: 260 }, () => ({ a: r() * TAU, dr: (r() - 0.5) * 0.035, dz: (r() - 0.5) * 0.025, s: 0.6 + r() * 1.4 })) : [];
			rg.moons.forEach((m) => (m.trail = []));
		});
		const rs = rng(99);
		const STARS = Array.from({ length: 120 }, () => ({ x: rs(), y: rs(), z: 0.2 + rs() * 0.8, s: 0.6 + rs() * 1.6, p: rs() * TAU, f: 0.8 + rs() * 2.2 }));

		let S = 0;
		let dpr = 1;
		let q = { seg: 120, wide: true, step: 1, stars: 120, trail: 32 };
		let rx = -0.28;
		let ry = 0;
		let tx = 0;
		let ty = 0;
		let boost = 0;
		let pulse = 0;
		const shocks = [];
		const sparks = [];
		let meteor = null;
		let nextMeteor = 1.8;
		let time = 0;
		let introT = 0;
		let burstDone = false;

		function resize() {
			const rect = host.getBoundingClientRect();
			S = Math.max(160, Math.round(rect.width));
			dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas.width = Math.round(S * dpr);
			canvas.height = Math.round(S * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		}

		const F = 2.4;
		function project(x, y, z) {
			const x1 = x * Math.cos(ry) + z * Math.sin(ry);
			const z1 = -x * Math.sin(ry) + z * Math.cos(ry);
			const y2 = y * Math.cos(rx) - z1 * Math.sin(rx);
			const z2 = y * Math.sin(rx) + z1 * Math.cos(rx);
			const s = F / (F - z2);
			return { x: S / 2 + x1 * s * S, y: S / 2 + y2 * s * S, z: z2, s };
		}
		function ringPoint(rg, a, rScale, dr = 0, dz = 0) {
			const R = (rg.R + dr) * rScale;
			let x = Math.cos(a) * R;
			let y = Math.sin(a) * R;
			let z = dz;
			const y1 = y * Math.cos(rg.tilt) - z * Math.sin(rg.tilt);
			const z1 = y * Math.sin(rg.tilt) + z * Math.cos(rg.tilt);
			const x2 = x * Math.cos(rg.roll) - y1 * Math.sin(rg.roll);
			const y2 = x * Math.sin(rg.roll) + y1 * Math.cos(rg.roll);
			return project(x2, y2, z1);
		}

		function drawGlowSprite(name, x, y, r, alpha) {
			ctx.globalAlpha = alpha;
			ctx.drawImage(glow[name], x - r, y - r, r * 2, r * 2);
		}

		// 极其华丽的深空星云团
		function drawNebula(intro) {
			const t = time;
			ctx.globalCompositeOperation = 'lighter';
			const blobs = [
				[0.5, 0.48, 0.65, '79,119,255', 0.42 + Math.sin(t * 0.4) * 0.08],
				[0.25, 0.28, 0.38, '130,90,255', 0.28 + Math.sin(t * 0.6 + 1) * 0.06],
				[0.78, 0.72, 0.42, '255,185,60', 0.22 + Math.sin(t * 0.5 + 2) * 0.05],
				[0.65, 0.25, 0.32, '94,234,212', 0.2 + Math.cos(t * 0.55) * 0.05],
			];
			for (const [bx, by, br, rgb, a] of blobs) {
				const grd = ctx.createRadialGradient(bx * S, by * S, 0, bx * S, by * S, br * S);
				grd.addColorStop(0, `rgba(${rgb},${a * intro})`);
				grd.addColorStop(1, `rgba(${rgb},0)`);
				ctx.fillStyle = grd;
				ctx.fillRect(0, 0, S, S);
			}
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawStars(intro) {
			ctx.globalCompositeOperation = 'lighter';
			const n = q.stars;
			for (let i = 0; i < n; i++) {
				const st = STARS[i];
				const px = ((st.x * S + ry * -60 * st.z) % S + S) % S;
				const py = ((st.y * S + rx * -60 * st.z) % S + S) % S;
				const tw = 0.5 + 0.5 * Math.sin(time * st.f + st.p);
				drawGlowSprite(st.s > 1.4 ? 'gold' : st.s > 1.1 ? 'teal' : 'white', px, py, st.s * 3.6, tw * st.z * intro);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		// 增强的炫光太阳耀斑
		function drawFlare(intro) {
			const x = S * 0.22;
			const y = S * 0.18;
			const pulseFactor = 0.88 + 0.12 * Math.sin(time * 1.5);
			ctx.globalCompositeOperation = 'lighter';
			drawGlowSprite('gold', x, y, S * 0.16 * pulseFactor, 0.6 * intro);
			drawGlowSprite('white', x, y, S * 0.045, intro);
			const g = ctx.createLinearGradient(x - S * 0.3, y, x + S * 0.3, y);
			g.addColorStop(0, 'rgba(255,235,170,0)');
			g.addColorStop(0.5, `rgba(255,250,210,${0.7 * intro})`);
			g.addColorStop(1, 'rgba(255,235,170,0)');
			ctx.globalAlpha = 1;
			ctx.fillStyle = g;
			ctx.fillRect(x - S * 0.3, y - 1, S * 0.6, 2);
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawRingPass(rg, rScale, alpha, front) {
			const N = q.seg;
			const [r, g, b] = rg.rgbArr;
			ctx.lineCap = 'round';
			let prev = ringPoint(rg, 0, rScale);
			for (let i = 1; i <= N; i++) {
				const cur = ringPoint(rg, (i / N) * TAU, rScale);
				const zAvg = (prev.z + cur.z) / 2;
				if ((zAvg >= 0) === front) {
					const depth = clamp(0.5 + zAvg / (rg.R * 2.2), 0.15, 1);
					const a = alpha * (front ? 0.45 + 0.55 * depth : 0.15 + 0.45 * depth);
					ctx.beginPath();
					ctx.moveTo(prev.x, prev.y);
					ctx.lineTo(cur.x, cur.y);
					if (q.wide) {
						ctx.strokeStyle = `rgba(${r},${g},${b},${a * 0.22})`;
						ctx.lineWidth = 6.5 * cur.s;
						ctx.stroke();
					}
					ctx.strokeStyle = `rgba(${r},${g},${b},${a})`;
					ctx.lineWidth = (front ? 1.8 : 1.2) * cur.s;
					ctx.stroke();
				}
				prev = cur;
			}
		}

		function drawDust(rg, rScale, alpha, front) {
			ctx.globalCompositeOperation = 'lighter';
			for (const d of rg.dust) {
				const p = ringPoint(rg, d.a + time * rg.speed * 0.5, rScale, d.dr, d.dz);
				if ((p.z >= 0) !== front) continue;
				const a = alpha * (front ? 0.92 : 0.45) * clamp(0.5 + p.z / 0.4, 0.2, 1);
				ctx.fillStyle = `rgba(200,255,250,${a})`;
				const sz = d.s * p.s;
				ctx.fillRect(p.x - sz / 2, p.y - sz / 2, sz, sz);
			}
			ctx.globalCompositeOperation = 'source-over';
		}

		function moonPos(rg, m, rScale) {
			return ringPoint(rg, m.a + time * rg.speed * (1 + boost * 2) + (m.off || 0), rScale);
		}

		function drawMoons(rg, rScale, alpha, front) {
			ctx.globalCompositeOperation = 'lighter';
			for (const m of rg.moons) {
				const p = m.cur;
				if (!p || (p.z >= 0) !== front) continue;
				const tr = m.trail;
				for (let i = 1; i < tr.length; i++) {
					const k = i / tr.length;
					ctx.strokeStyle = `rgba(${rg.rgb},${k * k * 0.85 * alpha})`;
					ctx.lineWidth = k * m.size * S * 1.8 * p.s;
					ctx.lineCap = 'round';
					ctx.beginPath();
					ctx.moveTo(tr[i - 1].x, tr[i - 1].y);
					ctx.lineTo(tr[i].x, tr[i].y);
					ctx.stroke();
				}
				const rad = m.size * S * p.s * (front ? 1.2 : 0.95);
				drawGlowSprite(m.glow, p.x, p.y, rad * 4.2, alpha * 0.9);
				drawGlowSprite('white', p.x, p.y, rad * 1.4, alpha);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function drawPlanet(cx, cy, R, scale, alpha) {
			const Rp = R * scale;
			ctx.save();
			ctx.globalAlpha = alpha;
			
			// 震撼的超广角大气光晕
			ctx.globalCompositeOperation = 'lighter';
			const halo = ctx.createRadialGradient(cx, cy, Rp * 0.8, cx, cy, Rp * 2.2);
			halo.addColorStop(0, 'rgba(94,180,255,0.65)');
			halo.addColorStop(0.35, 'rgba(130,110,255,0.28)');
			halo.addColorStop(1, 'rgba(40,70,220,0)');
			ctx.fillStyle = halo;
			ctx.beginPath();
			ctx.arc(cx, cy, Rp * 2.2, 0, TAU);
			ctx.fill();
			ctx.globalCompositeOperation = 'source-over';

			// 球面贴图渲染
			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(-0.22);
			ctx.beginPath();
			ctx.arc(0, 0, Rp, 0, TAU);
			ctx.clip();
			const rot = (time * 30) % TEX_W;
			const step = q.step;
			for (let dx = -Rp; dx < Rp; dx += step) {
				const nx = clamp((dx + step / 2) / Rp, -0.999, 0.999);
				const s = Math.sqrt(1 - nx * nx);
				const u = Math.asin(nx);
				const fx = (u + Math.PI / 2) / Math.PI;
				const sx = (rot + fx * TEX_VIS) % TEX_W;
				const sw = clamp((step / (Rp * Math.max(0.06, s))) * (TEX_VIS / Math.PI), 1, TEX_EXTRA - 2);
				ctx.drawImage(tex, sx, 0, sw, TEX_H, dx, -Rp, step + 0.7, Rp * 2);
			}
			ctx.restore();

			// 极强对比的明暗交界线
			ctx.beginPath();
			ctx.arc(cx, cy, Rp, 0, TAU);
			ctx.save();
			ctx.clip();
			const lg = ctx.createRadialGradient(cx - Rp * 0.45, cy - Rp * 0.48, Rp * 0.05, cx - Rp * 0.2, cy - Rp * 0.22, Rp * 1.8);
			lg.addColorStop(0, 'rgba(255,255,255,0.4)');
			lg.addColorStop(0.28, 'rgba(255,255,255,0.05)');
			lg.addColorStop(0.6, 'rgba(4,8,30,0.5)');
			lg.addColorStop(1, 'rgba(1,3,12,0.95)');
			ctx.fillStyle = lg;
			ctx.fillRect(cx - Rp, cy - Rp, Rp * 2, Rp * 2);

			// 冷暖反光
			ctx.globalCompositeOperation = 'lighter';
			const rim = ctx.createRadialGradient(cx + Rp * 0.12, cy + Rp * 0.15, Rp * 0.65, cx, cy, Rp * 1.02);
			rim.addColorStop(0, 'rgba(0,0,0,0)');
			rim.addColorStop(1, 'rgba(130,210,255,0.6)');
			ctx.fillStyle = rim;
			ctx.fillRect(cx - Rp, cy - Rp, Rp * 2, Rp * 2);
			ctx.restore();

			// 耀眼的高亮度边缘极光圈
			const ring = ctx.createLinearGradient(cx - Rp, cy - Rp, cx + Rp, cy + Rp);
			ring.addColorStop(0, 'rgba(180,240,255,1)');
			ring.addColorStop(0.5, 'rgba(130,170,255,0.35)');
			ring.addColorStop(1, 'rgba(255,215,90,0.9)');
			ctx.globalCompositeOperation = 'lighter';
			ctx.strokeStyle = ring;
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.arc(cx, cy, Rp - 0.5, 0, TAU);
			ctx.stroke();
			ctx.globalCompositeOperation = 'source-over';

			// 震撼的品牌中央立体金色字母 R
			ctx.font = `800 ${Rp * 1.0}px system-ui, -apple-system, "Segoe UI", sans-serif`;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			const tg = ctx.createLinearGradient(0, cy - Rp * 0.5, 0, cy + Rp * 0.5);
			tg.addColorStop(0, 'rgba(255,250,210,1)');
			tg.addColorStop(0.5, 'rgba(255,215,90,0.95)');
			tg.addColorStop(1, 'rgba(200,140,20,0.9)');
			ctx.shadowColor = 'rgba(255,215,90,0.95)';
			ctx.shadowBlur = Rp * 0.55;
			ctx.fillStyle = tg;
			ctx.fillText(initial, cx, cy + Rp * 0.04);
			ctx.restore();
		}

		function drawShocks() {
			ctx.globalCompositeOperation = 'lighter';
			for (let i = shocks.length - 1; i >= 0; i--) {
				const k = (time - shocks[i].t0) / shocks[i].dur;
				if (k >= 1) {
					shocks.splice(i, 1);
					continue;
				}
				if (k < 0) continue;
				const e = easeOutCubic(k);
				const r = e * S * shocks[i].max;
				ctx.strokeStyle = `rgba(${shocks[i].rgb},${(1 - k) * 0.9})`;
				ctx.lineWidth = (1 - k) * 5 + 1;
				ctx.beginPath();
				ctx.arc(S / 2, S / 2, r, 0, TAU);
				ctx.stroke();
			}
			for (let i = sparks.length - 1; i >= 0; i--) {
				const sp = sparks[i];
				const age = time - sp.t0;
				if (age > sp.life) {
					sparks.splice(i, 1);
					continue;
				}
				const k = age / sp.life;
				const d = easeOutCubic(k) * sp.dist * S;
				drawGlowSprite(sp.glow, S / 2 + Math.cos(sp.ang) * d, S / 2 + Math.sin(sp.ang) * d, sp.size * (1 - k * 0.5), (1 - k) * 0.98);
			}
			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = 'source-over';
		}

		function burst(strength = 1) {
			shocks.push({ t0: time, dur: 1.2, max: 0.55, rgb: '255,215,90' });
			shocks.push({ t0: time + 0.15, dur: 1.4, max: 0.62, rgb: '130,190,255' });
			const n = Math.round(40 * strength);
			for (let i = 0; i < n; i++) {
				sparks.push({ t0: time, life: 1.0 + Math.random() * 1.0, ang: Math.random() * TAU, dist: 0.2 + Math.random() * 0.35, size: 6 + Math.random() * 10, glow: ['gold', 'white', 'teal', 'blue'][i % 4] });
			}
			pulse = 1;
			boost = 1;
		}

		function drawMeteor(dt) {
			nextMeteor -= dt;
			if (!meteor && nextMeteor <= 0) {
				meteor = { x: S * (0.6 + Math.random() * 0.4), y: -S * 0.05 + Math.random() * S * 0.25, v: S * (1.1 + Math.random() * 0.7), len: S * (0.2 + Math.random() * 0.15), t: 0 };
				nextMeteor = 2.5 + Math.random() * 3.5;
			}
			if (!meteor) return;
			meteor.t += dt;
			const ang = Math.PI * 0.78;
			const dx = Math.cos(ang);
			const dy = Math.sin(ang);
			const hx = meteor.x + dx * meteor.v * meteor.t;
			const hy = meteor.y + dy * meteor.v * meteor.t;
			const tx2 = hx - dx * meteor.len;
			const ty2 = hy - dy * meteor.len;
			const grd = ctx.createLinearGradient(hx, hy, tx2, ty2);
			grd.addColorStop(0, 'rgba(255,255,220,1)');
			grd.addColorStop(0.3, 'rgba(255,215,90,0.6)');
			grd.addColorStop(1, 'rgba(255,215,90,0)');
			ctx.globalCompositeOperation = 'lighter';
			ctx.strokeStyle = grd;
			ctx.lineWidth = 2.2;
			ctx.lineCap = 'round';
			ctx.beginPath();
			ctx.moveTo(hx, hy);
			ctx.lineTo(tx2, ty2);
			ctx.stroke();
			ctx.globalCompositeOperation = 'source-over';
			if (hx < -S * 0.2 || hy > S * 1.2) meteor = null;
		}

		function frame(dt) {
			time += dt;
			introT = Math.min(1, introT + dt / 2.4);
			const iNeb = smooth(0, 0.5, introT);
			const iPlanet = easeOutBack(clamp(introT / 0.55, 0, 1));
			const iPlanetA = smooth(0, 0.3, introT);
			const iRing = easeOutCubic(clamp((introT - 0.1) / 0.7, 0, 1));
			const iRingA = smooth(0.1, 0.55, introT);
			const iMoon = smooth(0.4, 0.9, introT);
			if (!burstDone && introT > 0.16) {
				burstDone = true;
				burst(1);
			}
			boost *= Math.pow(0.35, dt);
			pulse *= Math.pow(0.04, dt);
			ry += ((tx * 0.55 + Math.sin(time * 0.27) * 0.15) - ry) * Math.min(1, dt * 4);
			rx += ((-0.28 + ty * 0.35 + Math.sin(time * 0.21 + 1) * 0.06) - rx) * Math.min(1, dt * 4);

			ctx.clearRect(0, 0, S, S);
			drawNebula(iNeb);
			drawStars(iNeb);
			drawFlare(iNeb);
			drawMeteor(dt);

			const rScale = 0.4 + 0.6 * iRing;
			for (const rg of RINGS) {
				for (const m of rg.moons) {
					m.cur = moonPos(rg, m, rScale);
					m.acc = (m.acc || 0) + dt;
					if (m.acc > 0.016) {
						m.acc = 0;
						m.trail.push({ x: m.cur.x, y: m.cur.y });
						if (m.trail.length > q.trail) m.trail.shift();
					}
				}
			}
			for (const rg of RINGS) {
				drawRingPass(rg, rScale, iRingA, false);
				if (rg.belt) drawDust(rg, rScale, iRingA, false);
				drawMoons(rg, rScale, iMoon, false);
			}
			const pr = 0.162 * S;
			drawPlanet(S / 2, S / 2, pr, iPlanet * (1 + pulse * 0.05), iPlanetA);
			for (const rg of RINGS) {
				drawRingPass(rg, rScale, iRingA, true);
				if (rg.belt) drawDust(rg, rScale, iRingA, true);
				drawMoons(rg, rScale, iMoon, true);
			}
			drawShocks();
		}

		function onPointer(e) {
			const r = host.getBoundingClientRect();
			const cx = r.left + r.width / 2;
			const cy = r.top + r.height / 2;
			tx = clamp((e.clientX - cx) / (window.innerWidth / 2), -1, 1);
			ty = clamp((e.clientY - cy) / (window.innerHeight / 2), -1, 1);
		}
		let running = false;
		let last = 0;
		let slow = 0;
		let raf = 0;
		function loop(now) {
			if (!running) return;
			const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
			last = now;
			if (q.seg === 120) {
				slow = dt > 0.03 ? slow + 1 : Math.max(0, slow - 1);
				if (slow > 70) q = { seg: 72, wide: false, step: 2, stars: 60, trail: 16 };
			}
			frame(dt);
			raf = requestAnimationFrame(loop);
		}
		function start() {
			if (running || reduce) return;
			running = true;
			last = 0;
			raf = requestAnimationFrame(loop);
		}
		function stop() {
			running = false;
			cancelAnimationFrame(raf);
		}

		resize();
		if (reduce) {
			introT = 1;
			burstDone = true;
			frame(4);
		} else {
			window.addEventListener('pointermove', onPointer, { passive: true });
			canvas.addEventListener('pointerdown', (e) => {
				onPointer(e);
				burst(1.2);
			});
			new IntersectionObserver((es) => (es[0].isIntersecting && !document.hidden ? start() : stop()), { threshold: 0.01 }).observe(host);
			document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
		}
		new ResizeObserver(() => {
			resize();
			if (reduce) frame(0);
		}).observe(host);
	}

	document.querySelectorAll('[data-hero-orbit]').forEach(initOrbit);
</script>
