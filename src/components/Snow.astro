---
// src/components/Snow.astro
// 主页下雪特效（轻量、可关闭、尊重减少动效偏好）
---

<div class="snow" id="snow" aria-hidden="true"></div>

<style is:global>
  .snow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 40;
    overflow: hidden;
  }

  .snow .flake {
    position: absolute;
    top: -12px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 4px rgba(255, 255, 255, 0.6);
    will-change: transform;
    animation-name: snow-fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .snow .flake.wobble {
    animation-name: snow-fall-wobble;
  }

  @keyframes snow-fall {
    to {
      transform: translateY(110vh);
    }
  }

  @keyframes snow-fall-wobble {
    0% {
      transform: translateY(0) translateX(0);
    }
    25% {
      transform: translateY(27.5vh) translateX(14px);
    }
    50% {
      transform: translateY(55vh) translateX(-10px);
    }
    75% {
      transform: translateY(82.5vh) translateX(12px);
    }
    100% {
      transform: translateY(110vh) translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snow {
      display: none !important;
    }
  }
</style>

<script>
  function initSnow() {
    const root = document.getElementById('snow');
    if (!root) return;

    // 已经初始化过就跳过（防止 View Transitions 重复添加）
    if (root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.remove();
      return;
    }

    const COUNT = 56;
    const frag = document.createDocumentFragment();

    for (let i = 0; i < COUNT; i++) {
      const flake = document.createElement('span');
      flake.className = 'flake' + (Math.random() > 0.5 ? ' wobble' : '');

      const size = 3 + Math.random() * 5; // 3~8px，更容易看见
      const left = Math.random() * 100;
      const duration = 7 + Math.random() * 12; // 7~19s
      const delay = -Math.random() * duration;

      flake.style.width = size + 'px';
      flake.style.height = size + 'px';
      flake.style.left = left + '%';
      flake.style.opacity = String(0.55 + Math.random() * 0.45);
      flake.style.animationDuration = duration + 's';
      flake.style.animationDelay = delay + 's';

      if (size > 5) {
        flake.style.filter = 'blur(0.5px)';
      }

      frag.appendChild(flake);
    }

    root.appendChild(frag);
  }

  initSnow();
  document.addEventListener('astro:page-load', initSnow);
</script>
