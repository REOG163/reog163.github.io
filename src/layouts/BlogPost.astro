---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Comments from '../components/Comments.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const { tags = [], category } = Astro.props as any;
const fmt = (d: Date) =>
	d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

// 上一篇 = 更早发布，下一篇 = 更新发布
const slugOf = (p: any) => p.slug ?? p.id;
const all = (await getCollection('blog')).sort(
	(a: any, b: any) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const cur = Astro.url.pathname.replace(/\/+$/, '');
const idx = all.findIndex((p: any) => `/blog/${slugOf(p)}` === cur);
const prev: any = idx > 0 ? all[idx - 1] : null;
const next: any = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main.post {
				width: 100%;
				max-width: 720px;
				margin: 0 auto;
				padding: 28px 18px 56px;
				box-sizing: border-box;
				text-align: left;
			}
			.cover {
				width: 100%;
				height: auto;
				border-radius: 14px;
				display: block;
				margin-bottom: 18px;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 4px 14px;
				font-size: 14px;
				color: rgb(var(--gray));
			}
			.cat {
				color: var(--accent);
				font-weight: 600;
			}
			h1.title {
				margin: 10px 0 12px;
				font-size: 30px;
				line-height: 1.35;
				color: rgb(var(--black));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 18px;
			}
			.tags a {
				font-size: 13px;
				padding: 2px 10px;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.toc {
				margin: 0 0 22px;
				padding: 12px 16px;
				border: 1px solid rgba(var(--gray), 0.3);
				border-radius: 12px;
				font-size: 15px;
			}
			.toc[hidden] {
				display: none;
			}
			.toc summary {
				cursor: pointer;
				font-weight: 600;
			}
			.toc ul {
				margin: 10px 0 0;
				padding: 0;
				list-style: none;
			}
			.toc li {
				margin: 6px 0;
				line-height: 1.5;
			}
			.toc li.l3 {
				padding-left: 16px;
				font-size: 14px;
			}
			.toc a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.toc a:hover {
				color: var(--accent);
			}
			.prose {
				font-size: 17px;
				line-height: 1.95;
				color: rgb(var(--gray-dark));
			}
			.prose :global(h2) {
				font-size: 24px;
				margin: 2em 0 0.6em;
				scroll-margin-top: 76px;
			}
			.prose :global(h3) {
				font-size: 20px;
				margin: 1.6em 0 0.5em;
				scroll-margin-top: 76px;
			}
			.prose :global(p) {
				margin: 0 0 1.1em;
			}
			.prose :global(img) {
				max-width: 100%;
				height: auto;
				border-radius: 10px;
			}
			.prose :global(table) {
				display: block;
				overflow-x: auto;
				border-collapse: collapse;
				margin: 1em 0;
				font-size: 15px;
			}
			.prose :global(th),
			.prose :global(td) {
				border: 1px solid rgba(var(--gray), 0.35);
				padding: 8px 12px;
			}
			.prose :global(blockquote) {
				margin: 1em 0;
				padding: 2px 16px;
				border-left: 4px solid var(--accent);
				color: rgb(var(--gray));
			}
			.prose :global(pre) {
				padding: 14px;
				border-radius: 10px;
				overflow-x: auto;
				font-size: 14px;
				line-height: 1.6;
			}
			.share-mini {
				margin-left: auto;
				padding: 0;
				border: 0;
				background: none;
				font: inherit;
				font-size: 14px;
				color: var(--accent);
				cursor: pointer;
			}
			.share-end {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				margin-top: 36px;
				padding: 14px 18px;
				border-radius: 12px;
				background: rgb(var(--gray-light));
				font-size: 15px;
				color: rgb(var(--gray-dark));
			}
			.share-btn {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				padding: 8px 18px;
				border: 0;
				border-radius: 10px;
				background: var(--accent);
				color: #fff;
				font: inherit;
				font-size: 15px;
				font-weight: 600;
				cursor: pointer;
				flex: none;
			}
			:global(html[data-theme='dark']) .share-btn {
				color: #0b1020;
			}
			#progress {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				width: 0;
				background: var(--accent);
				z-index: 100;
			}
			.totop {
				position: fixed;
				right: 18px;
				bottom: 22px;
				width: 44px;
				height: 44px;
				border: 0;
				border-radius: 50%;
				background: var(--accent);
				color: #fff;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				pointer-events: none;
				transform: translateY(8px);
				transition: opacity 0.2s, transform 0.2s;
				z-index: 60;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
			}
			.totop.show {
				opacity: 1;
				pointer-events: auto;
				transform: none;
			}
			:global(html[data-theme='dark']) .totop {
				color: #0b1020;
			}
			.pn {
				display: grid;
				grid-template-columns: 1fr;
				gap: 12px;
				margin-top: 40px;
			}
			.pn a {
				display: block;
				padding: 14px 16px;
				border-radius: 12px;
				border: 1px solid rgba(var(--gray), 0.3);
				text-decoration: none;
				color: inherit;
			}
			.pn a:hover {
				border-color: var(--accent);
			}
			.pn small {
				display: block;
				font-size: 13px;
				color: var(--accent);
				margin-bottom: 2px;
			}
			.pn b {
				display: block;
				font-size: 16px;
				line-height: 1.5;
				color: rgb(var(--black));
			}
			.pn .next {
				text-align: right;
			}
			.pn span:empty {
				display: none;
			}
			@media (min-width: 720px) {
				.pn {
					grid-template-columns: 1fr 1fr;
				}
				.pn span:empty {
					display: block;
				}
			}
		</style>
	</head>
	<body>
		<div id="progress"></div>
		<Header />
		<main class="post">
			<article>
				{heroImage && <Image class="cover" width={1020} height={510} src={heroImage} alt="" />}
				<div class="meta">
					{category && <span class="cat">{category}</span>}
					<span>{fmt(pubDate)}</span>
					{updatedDate && <span>更新于 {fmt(updatedDate)}</span>}
					<span id="reading-time"></span>
					<button class="share-mini" type="button" data-share data-share-scope="article" aria-label="分享这篇文章">分享</button>
				</div>
				<h1 class="title">{title}</h1>
				{
					tags.length > 0 && (
						<div class="tags">
							{tags.map((t: string) => (
								<a href={`/blog?tag=${encodeURIComponent(t)}`}>#{t}</a>
							))}
						</div>
					)
				}
				<details id="toc" class="toc" hidden>
					<summary>目录</summary>
					<ul id="toc-list"></ul>
				</details>
				<div class="prose" id="prose"><slot /></div>
				<div class="share-end">
					<span>觉得有用？分享给朋友吧</span>
					<button class="share-btn" type="button" data-share data-share-scope="article">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" /></svg>
						分享
					</button>
				</div>
			</article>
			{
				(prev || next) && (
					<nav class="pn" aria-label="文章导航">
						{prev ? (
							<a class="prev" href={`/blog/${slugOf(prev)}/`}>
								<small>← 上一篇</small>
								<b>{prev.data.title}</b>
							</a>
						) : (
							<span />
						)}
						{next ? (
							<a class="next" href={`/blog/${slugOf(next)}/`}>
								<small>下一篇 →</small>
								<b>{next.data.title}</b>
							</a>
						) : (
							<span />
						)}
					</nav>
				)
			}
			<Comments />
		</main>
		<button class="totop" id="totop" type="button" aria-label="回到顶部">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6" /></svg>
		</button>
		<Footer />

		<script>
			const prose = document.getElementById('prose');
			if (prose) {
				// 阅读时间：中文按字数，英文按词数，约 400 单位/分钟
				const text = prose.textContent || '';
				const zh = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
				const en = (text.replace(/[\u4e00-\u9fa5]/g, ' ').match(/[A-Za-z0-9]+/g) || []).length;
				const mins = Math.max(1, Math.round((zh + en) / 400));
				const rt = document.getElementById('reading-time');
				if (rt) rt.textContent = `约 ${mins} 分钟读完`;

				// 目录：收集 h2 / h3，至少 3 个标题才显示
				const heads = Array.from(prose.querySelectorAll<HTMLElement>('h2, h3'));
				if (heads.length >= 3) {
					const list = document.getElementById('toc-list');
					heads.forEach((h, i) => {
						if (!h.id) h.id = 'section-' + i;
						const li = document.createElement('li');
						if (h.tagName === 'H3') li.className = 'l3';
						const a = document.createElement('a');
						a.href = '#' + h.id;
						a.textContent = h.textContent || '';
						li.appendChild(a);
						list?.appendChild(li);
					});
					const toc = document.getElementById('toc') as HTMLDetailsElement | null;
					if (toc) {
						toc.hidden = false;
						if (window.innerWidth >= 720) toc.open = true;
					}
				}
			}

			// 阅读进度条 + 回到顶部
			const bar = document.getElementById('progress');
			const top = document.getElementById('totop');
			function onScroll() {
				const doc = document.documentElement;
				const max = doc.scrollHeight - doc.clientHeight;
				const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
				if (bar) bar.style.width = Math.min(100, pct) + '%';
				top?.classList.toggle('show', window.scrollY > 600);
			}
			window.addEventListener('scroll', onScroll, { passive: true });
			top?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
			onScroll();
		</script>
	</body>
</html>
