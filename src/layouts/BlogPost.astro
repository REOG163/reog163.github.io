---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Comments from '../components/Comments.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const { tags = [], category } = Astro.props as any;
const fmt = (d: Date) =>
	d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main.post {
				width: 100%;
				max-width: 720px;
				margin: 0 auto;
				padding: 28px 18px 56px;
				box-sizing: border-box;
				text-align: left;
			}
			.cover {
				width: 100%;
				height: auto;
				border-radius: 14px;
				display: block;
				margin-bottom: 18px;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 4px 14px;
				font-size: 14px;
				color: rgb(var(--gray));
			}
			.cat {
				color: var(--accent);
				font-weight: 600;
			}
			h1.title {
				margin: 10px 0 12px;
				font-size: 30px;
				line-height: 1.35;
				color: rgb(var(--black));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 18px;
			}
			.tags a {
				font-size: 13px;
				padding: 2px 10px;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.toc {
				margin: 0 0 22px;
				padding: 12px 16px;
				border: 1px solid rgba(var(--gray), 0.3);
				border-radius: 12px;
				font-size: 15px;
			}
			.toc[hidden] {
				display: none;
			}
			.toc summary {
				cursor: pointer;
				font-weight: 600;
			}
			.toc ul {
				margin: 10px 0 0;
				padding: 0;
				list-style: none;
			}
			.toc li {
				margin: 6px 0;
				line-height: 1.5;
			}
			.toc li.l3 {
				padding-left: 16px;
				font-size: 14px;
			}
			.toc a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.toc a:hover {
				color: var(--accent);
			}
			.prose {
				font-size: 17px;
				line-height: 1.95;
				color: rgb(var(--gray-dark));
			}
			.prose :global(h2) {
				font-size: 24px;
				margin: 2em 0 0.6em;
				scroll-margin-top: 76px;
			}
			.prose :global(h3) {
				font-size: 20px;
				margin: 1.6em 0 0.5em;
				scroll-margin-top: 76px;
			}
			.prose :global(p) {
				margin: 0 0 1.1em;
			}
			.prose :global(img) {
				max-width: 100%;
				height: auto;
				border-radius: 10px;
			}
			.prose :global(table) {
				display: block;
				overflow-x: auto;
				border-collapse: collapse;
				margin: 1em 0;
				font-size: 15px;
			}
			.prose :global(th),
			.prose :global(td) {
				border: 1px solid rgba(var(--gray), 0.35);
				padding: 8px 12px;
			}
			.prose :global(blockquote) {
				margin: 1em 0;
				padding: 2px 16px;
				border-left: 4px solid var(--accent);
				color: rgb(var(--gray));
			}
			.prose :global(pre) {
				padding: 14px;
				border-radius: 10px;
				overflow-x: auto;
				font-size: 14px;
				line-height: 1.6;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="post">
			<article>
				{heroImage && <Image class="cover" width={1020} height={510} src={heroImage} alt="" />}
				<div class="meta">
					{category && <span class="cat">{category}</span>}
					<span>{fmt(pubDate)}</span>
					{updatedDate && <span>更新于 {fmt(updatedDate)}</span>}
					<span id="reading-time"></span>
				</div>
				<h1 class="title">{title}</h1>
				{
					tags.length > 0 && (
						<div class="tags">
							{tags.map((t: string) => (
								<a href={`/blog?tag=${encodeURIComponent(t)}`}>#{t}</a>
							))}
						</div>
					)
				}
				<details id="toc" class="toc" hidden>
					<summary>目录</summary>
					<ul id="toc-list"></ul>
				</details>
				<div class="prose" id="prose"><slot /></div>
			</article>
			<Comments />
		</main>
		<Footer />

		<script>
			const prose = document.getElementById('prose');
			if (prose) {
				// 阅读时间：中文按字数，英文按词数，约 400 单位/分钟
				const text = prose.textContent || '';
				const zh = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
				const en = (text.replace(/[\u4e00-\u9fa5]/g, ' ').match(/[A-Za-z0-9]+/g) || []).length;
				const mins = Math.max(1, Math.round((zh + en) / 400));
				const rt = document.getElementById('reading-time');
				if (rt) rt.textContent = `约 ${mins} 分钟读完`;

				// 目录：收集 h2 / h3，至少 3 个标题才显示
				const heads = Array.from(prose.querySelectorAll<HTMLElement>('h2, h3'));
				if (heads.length >= 3) {
					const list = document.getElementById('toc-list');
					heads.forEach((h, i) => {
						if (!h.id) h.id = 'section-' + i;
						const li = document.createElement('li');
						if (h.tagName === 'H3') li.className = 'l3';
						const a = document.createElement('a');
						a.href = '#' + h.id;
						a.textContent = h.textContent || '';
						li.appendChild(a);
						list?.appendChild(li);
					});
					const toc = document.getElementById('toc') as HTMLDetailsElement | null;
					if (toc) {
						toc.hidden = false;
						if (window.innerWidth >= 720) toc.open = true;
					}
				}
			}
		</script>
	</body>
</html>
