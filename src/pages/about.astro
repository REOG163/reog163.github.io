---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// ===== 在这里添加你的作品，复制一段 { ... } 即可 =====
// 优先显示 video，其次 image，都没有则显示动态 SVG 封面
const projects = [
	{
		title: '本站：REOG 个人网站',
		desc: '基于 Astro 构建的中文个人博客，支持深色模式、站内搜索、标签分类、RSS 订阅与评论，通过 GitHub Actions 自动部署到 GitHub Pages。',
		tags: ['Astro', 'GitHub Actions', 'GitHub Pages', 'Giscus'],
		status: '运行中',
		// 为你准备的默认酷炫视频（网络加载），你可以换成自己放在 public 里的视频，比如 '/my-video.mp4'
		video: 'https://assets.mixkit.co/videos/preview/mixkit-abstract-technology-blue-network-connections-32899-large.mp4',
		image: '', 
		links: [
			{ label: '访问网站', href: 'https://reog163.github.io' },
			{ label: '查看源码', href: 'https://github.com/REOG163/reog163.github.io' },
		],
	},
];
// ==================================================

const palettes = [
	['#14204a', '#3b5bdb', '#5eead4'],
	['#1d2f6b', '#7c5cff', '#8fa8ff'],
	['#0b3b4a', '#14b8a6', '#a7f3d0'],
];
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`作品集 | ${SITE_TITLE}`} description="我做过的项目与作品" />
		<style>
			main.pj {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 28px 18px 56px;
				box-sizing: border-box;
			}
			.label {
				margin: 0 0 4px;
				font-size: 13px;
				letter-spacing: 0.18em;
				font-weight: 600;
				color: var(--accent);
			}
			h1 {
				margin: 0 0 6px;
				font-size: 30px;
				color: rgb(var(--black));
			}
			.lead {
				margin: 0 0 24px;
				font-size: 16px;
				color: rgb(var(--gray));
			}
			
			.grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 18px;
			}

			/* 基础卡片样式 + 入场动画 */
			.card {
				display: flex;
				flex-direction: column;
				overflow: hidden;
				border-radius: 14px;
				border: 1px solid rgba(var(--gray), 0.3);
				background: rgba(var(--gray-light), 0.35);
				position: relative;
				transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
				animation: cardIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
			}

			@keyframes cardIn {
				from { opacity: 0; transform: translateY(30px) scale(0.98); }
				to { opacity: 1; transform: translateY(0) scale(1); }
			}

			.card:hover {
				transform: translateY(-6px);
				border-color: rgba(94, 234, 212, 0.5);
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.1);
			}
			:global(html[data-theme='dark']) .card:hover {
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.6), 0 0 24px rgba(94, 234, 212, 0.15);
				border-color: #5eead4;
			}

			/* 悬浮高光扫过 */
			.card::after {
				content: '';
				position: absolute;
				top: 0; left: -150%;
				width: 50%; height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
				transform: skewX(-25deg);
				transition: left 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
				pointer-events: none;
				z-index: 10;
			}
			.card:hover::after {
				left: 150%;
			}
			:global(html[data-theme='dark']) .card::after {
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
			}

			/* 封面区域 */
			.cover-wrap {
				width: 100%;
				aspect-ratio: 2 / 1;
				overflow: hidden;
				background: #0b1020;
				position: relative;
			}
			.cover {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.card:hover .cover {
				transform: scale(1.06);
			}

			/* ========== 原 SVG 动效保留（当没有视频/图片时显示） ========== */
			.orbit-rings circle {
				transform-origin: 320px 100px;
				animation: radar-pulse 4s ease-out infinite;
			}
			.orbit-rings circle:nth-child(2) { animation-delay: 1.3s; }
			.orbit-rings circle:nth-child(3) { animation-delay: 2.6s; }

			@keyframes radar-pulse {
				0% { transform: scale(0.8); opacity: 0; stroke-width: 2px;}
				20% { opacity: 0.4; }
				100% { transform: scale(1.2); opacity: 0; stroke-width: 0.5px;}
			}

			.orbit-dot {
				animation: dot-float 5s ease-in-out infinite;
			}
			@keyframes dot-float {
				0%, 100% { transform: translate(0, 0); filter: drop-shadow(0 0 4px currentColor); }
				50% { transform: translate(15px, -15px); filter: drop-shadow(0 0 10px currentColor); }
			}

			.orbit-number {
				animation: number-float 6s ease-in-out infinite;
			}
			@keyframes number-float {
				0%, 100% { transform: translateY(0); opacity: 0.9; }
				50% { transform: translateY(-6px); opacity: 1; text-shadow: 0 0 15px rgba(255,255,255,0.3); }
			}

			.cover-bg {
				animation: bg-pulse 8s ease-in-out infinite alternate;
			}
			@keyframes bg-pulse {
				0% { filter: brightness(1); }
				100% { filter: brightness(1.2); }
			}
			/* ================================= */

			.body {
				padding: 16px 18px 18px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				flex: 1;
			}
			.head {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 8px;
			}

			/* 重点文字：黄金流光特效 */
			.card h2, .soon b {
				margin: 0;
				font-size: 19px;
				line-height: 1.4;
				font-weight: 800;
				letter-spacing: 0.5px;
				background: linear-gradient(135deg, #bf953f 0%, #fcf6ba 25%, #b38728 50%, #fbf5b7 75%, #aa771c 100%);
				background-size: 200% auto;
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
				animation: shine 4s linear infinite;
				filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2));
			}

			@keyframes shine {
				to { background-position: 200% center; }
			}

			/* 状态标签优化 */
			.status {
				flex: none;
				font-size: 12px;
				padding: 2px 10px;
				border-radius: 999px;
				background: rgba(94, 234, 212, 0.15);
				color: #0f9d8a;
				border: 1px solid rgba(94, 234, 212, 0.3);
				box-shadow: 0 0 10px rgba(94, 234, 212, 0.05);
				display: flex;
				align-items: center;
				gap: 6px;
				font-weight: 600;
			}
			.status::before {
				content: '';
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #0f9d8a;
				box-shadow: 0 0 6px #0f9d8a;
				animation: blink 2s infinite ease-in-out;
			}
			@keyframes blink {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(0.8); }
			}

			:global(html[data-theme='dark']) .status {
				color: #5eead4;
				border-color: rgba(94, 234, 212, 0.4);
			}
			:global(html[data-theme='dark']) .status::before {
				background: #5eead4;
				box-shadow: 0 0 6px #5eead4;
			}

			.card p {
				margin: 0;
				font-size: 15px;
				line-height: 1.75;
				color: rgb(var(--gray-dark));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
			}
			.tags span {
				font-size: 12px;
				padding: 2px 10px;
				border-radius: 6px;
				background: rgba(var(--gray), 0.1);
				color: rgb(var(--gray-dark));
				transition: all 0.2s ease;
				border: 1px solid transparent;
			}
			.card:hover .tags span {
				background: rgba(var(--gray), 0.15);
				border-color: rgba(var(--gray), 0.3);
			}
			.links {
				display: flex;
				gap: 14px;
				margin-top: auto;
				padding-top: 10px;
			}
			.links a {
				font-size: 14px;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
				transition: opacity 0.2s;
			}
			.links a:hover {
				opacity: 0.8;
			}

			/* 筹备中卡片 */
			.soon {
				align-items: center;
				justify-content: center;
				text-align: center;
				border-style: dashed;
				border-width: 2px;
				padding: 36px 20px;
				background: transparent;
				border-color: rgba(var(--gray), 0.4);
				transition: all 0.4s ease;
			}
			.soon:hover {
				background: rgba(var(--gray-light), 0.2);
				border-color: rgba(94, 234, 212, 0.6);
			}
			:global(html[data-theme='dark']) .soon {
				border-color: #26335c;
			}
			:global(html[data-theme='dark']) .soon:hover {
				border-color: #5eead4;
				background: rgba(26, 36, 64, 0.6);
				box-shadow: 0 0 30px rgba(94, 234, 212, 0.08);
			}

			.soon-icon {
				margin-bottom: 12px;
				color: var(--accent);
				animation: float 3s ease-in-out infinite;
				display: flex;
				justify-content: center;
			}
			@keyframes float {
				0%, 100% { transform: translateY(0); }
				50% { transform: translateY(-8px); }
			}

			.soon span {
				font-size: 14px;
				color: rgb(var(--gray));
				margin-top: 4px;
			}

			@media (min-width: 720px) {
				.grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			:global(html[data-theme='dark']) .card {
				background: rgba(26, 36, 64, 0.95);
				border-color: #26335c;
			}

			/* 针对减少动效偏好，隐藏视频 */
			@media (prefers-reduced-motion: reduce) {
				.cover-wrap video {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="pj">
			<p class="label">PROJECTS · 作品集</p>
			<h1>我做过的东西</h1>
			<p class="lead">每个项目都是一次完整的实践：从想法到上线。</p>

			<div class="grid">
				{
					projects.map((p, i) => {
						const c = palettes[i % palettes.length];
						return (
							<div class="card" style={`animation-delay: ${i * 0.15}s;`}>
								<div class="cover-wrap">
									{/* 优先级 1：视频 */}
									{p.video ? (
										<video 
											class="cover" 
											src={p.video} 
											autoplay 
											muted 
											loop 
											playsinline 
										/>
									/* 优先级 2：图片 */
									) : p.image ? (
										<img class="cover" src={p.image} alt={p.title} loading="lazy" />
									/* 优先级 3：动态 SVG */
									) : (
										<svg class="cover" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
											<defs>
												<linearGradient id={`g${i}`} x1="0" y1="0" x2="1" y2="1">
													<stop offset="0" stop-color={c[0]} />
													<stop offset="1" stop-color={c[1]} />
												</linearGradient>
											</defs>
											
											<rect width="400" height="200" fill={`url(#g${i})`} class="cover-bg" />
											
											<g fill="none" stroke="#fff" stroke-opacity="0.3" class="orbit-rings">
												<circle cx="320" cy="100" r="90" />
												<circle cx="320" cy="100" r="56" />
												<circle cx="320" cy="100" r="24" />
											</g>
											
											<circle cx="230" cy="100" r="6" fill={c[2]} class="orbit-dot" style={`color: ${c[2]};`} />
											
											<text x="28" y="116" font-size="44" font-weight="800" fill="#fff" font-family="system-ui, sans-serif" letter-spacing="2" class="orbit-number">
												{String(i + 1).padStart(2, '0')}
											</text>
										</svg>
									)}
								</div>
								<div class="body">
									<div class="head">
										<h2>{p.title}</h2>
										{p.status && <span class="status">{p.status}</span>}
									</div>
									<p>{p.desc}</p>
									<div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
									<div class="links">
										{p.links.map((l) => (
											<a href={l.href} target="_blank" rel="noopener">{l.label} →</a>
										))}
									</div>
								</div>
							</div>
						);
					})
				}
				<div class="card soon" style="animation-delay: 0.4s;">
					<div class="soon-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 5v14M5 12h14"/>
						</svg>
					</div>
					<b>下一个作品筹备中</b>
					<span>有新项目上线后会在这里更新</span>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
