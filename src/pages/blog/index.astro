---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

// 排序规则：置顶文章在前（pinOrder 数字小的靠前，没写的排最后），其余按发布时间从新到旧
const posts = (await getCollection('blog')).sort((a: any, b: any) => {
	const pa = a.data.pinned ? 1 : 0;
	const pb = b.data.pinned ? 1 : 0;
	if (pa !== pb) return pb - pa;
	if (pa && pb) {
		const oa = a.data.pinOrder ?? 9999;
		const ob = b.data.pinOrder ?? 9999;
		if (oa !== ob) return oa - ob;
	}
	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
const categories = [...new Set(posts.map((p: any) => p.data.category).filter(Boolean))] as string[];
const tags = [...new Set(posts.flatMap((p: any) => p.data.tags ?? []))] as string[];
const slugOf = (p: any) => p.slug ?? p.id;
const fmt = (d: Date) =>
	d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 | ${SITE_TITLE}`} description="全部文章" />
		<style>
			main.list {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 28px 18px 56px;
				box-sizing: border-box;
			}
			.top {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 12px;
				margin-bottom: 18px;
			}
			.label {
				margin: 0 0 4px;
				font-size: 13px;
				letter-spacing: 0.18em;
				font-weight: 600;
				color: var(--accent);
			}
			h1 {
				margin: 0;
				font-size: 30px;
				color: rgb(var(--black));
			}
			.tools {
				display: flex;
				gap: 14px;
				font-size: 14px;
			}
			.tools a {
				color: var(--accent);
				text-decoration: none;
			}
			.filters {
				margin-bottom: 22px;
			}
			.row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 8px;
				margin-bottom: 10px;
			}
			.row > span {
				font-size: 13px;
				color: rgb(var(--gray));
				width: 36px;
			}
			.chip {
				padding: 4px 12px;
				font-size: 14px;
				line-height: 1.5;
				border-radius: 999px;
				border: 1px solid rgba(var(--gray), 0.4);
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
			}
			.chip.on {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}
			:global(html[data-theme='dark']) .chip.on {
				color: #0b1020;
			}
			.cards {
				display: grid;
				grid-template-columns: 1fr;
				gap: 18px;
			}
			.card {
				display: block;
				overflow: hidden;
				border-radius: 14px;
				border: 1px solid rgba(var(--gray), 0.3);
				background: rgba(var(--gray-light), 0.35);
				text-decoration: none;
				color: inherit;
			}
			.card[hidden] {
				display: none;
			}
			.card:hover {
				border-color: var(--accent);
			}
			.card.pinned {
				border-color: rgba(217, 165, 32, 0.7);
				background: rgba(245, 198, 58, 0.08);
			}
			.pin {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				padding: 0 8px;
				border-radius: 999px;
				background: rgba(245, 198, 58, 0.22);
				color: #9a6b00;
				font-weight: 600;
			}
			:global(html[data-theme='dark']) .pin {
				color: #f5c63a;
			}
			.thumb {
				display: block;
				width: 100%;
				height: auto;
			}
			.body {
				padding: 16px 18px 18px;
			}
			.m {
				display: flex;
				flex-wrap: wrap;
				gap: 4px 12px;
				font-size: 13px;
				color: rgb(var(--gray));
			}
			.m b {
				color: var(--accent);
			}
			.card h2 {
				margin: 6px 0 6px;
				font-size: 20px;
				line-height: 1.4;
				color: rgb(var(--black));
			}
			.card p {
				margin: 0 0 8px;
				font-size: 15px;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
			}
			.tg {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				font-size: 12px;
				color: rgb(var(--gray));
			}
			.empty {
				text-align: center;
				color: rgb(var(--gray));
				padding: 40px 0;
			}
			@media (min-width: 720px) {
				.cards {
					grid-template-columns: repeat(2, 1fr);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="list">
			<div class="top">
				<div>
					<p class="label">BLOG · 博客</p>
					<h1>全部文章</h1>
				</div>
				<div class="tools">
					<a href="/search">搜索</a>
					<a href="/rss.xml">RSS 订阅</a>
				</div>
			</div>

			{
				(categories.length > 0 || tags.length > 0) && (
					<div class="filters">
						{categories.length > 0 && (
							<div class="row" data-kind="category">
								<span>分类</span>
								<button class="chip on" data-v="" type="button">全部</button>
								{categories.map((c) => (
									<button class="chip" data-v={c} type="button">{c}</button>
								))}
							</div>
						)}
						{tags.length > 0 && (
							<div class="row" data-kind="tag">
								<span>标签</span>
								<button class="chip on" data-v="" type="button">全部</button>
								{tags.map((t) => (
									<button class="chip" data-v={t} type="button">#{t}</button>
								))}
							</div>
						)}
					</div>
				)
			}

			<div class="cards">
				{
					posts.map((p: any) => (
						<a
							class={p.data.pinned ? 'card pinned' : 'card'}
							href={`/blog/${slugOf(p)}/`}
							data-category={p.data.category ?? ''}
							data-tags={(p.data.tags ?? []).join('|')}
						>
							{p.data.heroImage && (
								<Image class="thumb" width={720} height={360} src={p.data.heroImage} alt="" />
							)}
							<div class="body">
								<div class="m">
									{p.data.pinned && (
										<span class="pin">
											<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 2.5a1 1 0 0 1 .7 1.7l-1.1 1.1 3.6 3.6 1.1-1.1a1 1 0 0 1 1.4 1.4l-3 3-.5 4.6-1.5 1.5-3.9-3.9-5.9 5.9a1 1 0 0 1-1.4-1.4l5.9-5.9-3.9-3.9 1.5-1.5 4.6-.5 3-3a1 1 0 0 1 .7-.3z"/></svg>
											置顶
										</span>
									)}
									{p.data.category && <b>{p.data.category}</b>}
									<span>{fmt(p.data.pubDate)}</span>
								</div>
								<h2>{p.data.title}</h2>
								<p>{p.data.description}</p>
								{(p.data.tags ?? []).length > 0 && (
									<div class="tg">
										{(p.data.tags ?? []).map((t: string) => <span>#{t}</span>)}
									</div>
								)}
							</div>
						</a>
					))
				}
			</div>
			<p class="empty" id="empty" hidden>没有符合条件的文章。</p>
		</main>
		<Footer />

		<script>
			const state: { category: string; tag: string } = { category: '', tag: '' };
			const params = new URLSearchParams(location.search);
			state.category = params.get('category') || '';
			state.tag = params.get('tag') || '';

			const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
			const empty = document.getElementById('empty');

			function apply() {
				let shown = 0;
				cards.forEach((c) => {
					const okC = !state.category || c.dataset.category === state.category;
					const okT = !state.tag || (c.dataset.tags || '').split('|').includes(state.tag);
					c.hidden = !(okC && okT);
					if (!c.hidden) shown++;
				});
				document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
					const kind = row.dataset.kind as 'category' | 'tag';
					row.querySelectorAll<HTMLElement>('.chip').forEach((ch) => {
						ch.classList.toggle('on', (ch.dataset.v || '') === state[kind]);
					});
				});
				if (empty) empty.hidden = shown > 0;
				const q = new URLSearchParams();
				if (state.category) q.set('category', state.category);
				if (state.tag) q.set('tag', state.tag);
				history.replaceState(null, '', q.toString() ? '?' + q.toString() : location.pathname);
			}

			document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
				row.addEventListener('click', (e) => {
					const btn = (e.target as HTMLElement).closest<HTMLElement>('.chip');
					if (!btn) return;
					const kind = row.dataset.kind as 'category' | 'tag';
					state[kind] = btn.dataset.v || '';
					apply();
				});
			});
			apply();
		</script>
	</body>
</html>
