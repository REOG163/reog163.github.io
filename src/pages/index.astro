---
import HeroOrbit from '../components/HeroOrbit.astro';
import Snow from '../components/Snow.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Windows 桌面版下载地址（由 GitHub Actions 自动发布到 Releases）
const DOWNLOAD_URL = 'https://github.com/REOG163/reog163.github.io/releases/latest/download/REOG-Setup.exe';

const principles = [
	{
		no: '01',
		title: '先问为什么，再问怎么做',
		desc: '多数返工源于问题没定义清楚。动手之前，先把目标、约束与成功标准写下来。',
	},
	{
		no: '02',
		title: '小步迭代，持续验证',
		desc: '把大目标拆成可交付、可回退的小步骤。每一步都有反馈，错误成本才可控。',
	},
	{
		no: '03',
		title: '记录即资产',
		desc: '经验不写下来就会衰减。文章、笔记与复盘，是时间留给自己的复利。',
	},
];

const fields = [
	{ name: '系统设计', note: '用最少的部件，搭出稳定的结构' },
	{ name: '自动化与 AI 工具', note: '把重复劳动交给机器，把判断留给自己' },
	{ name: '独立开发', note: '从想法到上线，完整走通一遍' },
	{ name: '知识管理', note: '让学到的东西可检索、可复用、可传递' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main.home {
				position: relative;
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
				font-size: 16px;
				line-height: 1.7;
				color: #0f172a;
				overflow-x: hidden; /* 防止涂鸦文字撑出滚动条 */
			}
			.wrap {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 0 20px;
				box-sizing: border-box;
				position: relative;
				z-index: 2;
			}

			/* ================= Hero ================= */
			.hero {
				background: linear-gradient(160deg, #0b1020 0%, #14204a 60%, #1d2f6b 100%);
				color: #fff;
				overflow: hidden;
				position: relative;
			}
			.hero::before {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(circle at 80% 20%, rgba(143, 168, 255, 0.15), transparent 50%);
				pointer-events: none;
			}
			.hero .wrap {
				display: grid;
				grid-template-columns: 1fr;
				gap: 8px;
				padding-top: 48px;
				padding-bottom: 40px;
				align-items: center;
			}
			.eyebrow {
				font-size: 13px;
				letter-spacing: 0.2em;
				color: #8fa8ff;
				margin: 0 0 12px;
				animation: slide-up 0.6s ease both;
			}

			/* ================= 标题 3D 残影特效 ================= */
			.hero h1 {
				margin: 0;
				font-size: 60px;
				line-height: 1.1;
				letter-spacing: 0.04em;
				animation: slide-up 0.6s ease 0.1s both;
			}
			.glitch-text {
				position: relative;
				display: inline-block;
				font-weight: 900;
				/* 银白色渐变底色 */
				background: linear-gradient(135deg, #ffffff 10%, #e2e8f0 40%, #cbd5e1 60%, #f8fafc 90%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				-webkit-text-fill-color: transparent;
				/* 银白发散微光 + Q弹呼吸 */
				filter: drop-shadow(0 8px 16px rgba(255, 255, 255, 0.2));
				animation: text-float 3s ease-in-out infinite;
				z-index: 2;
			}

			/* 动态残影 1 - 蓝色系 */
			.glitch-text::before {
				content: attr(data-text);
				position: absolute;
				left: 0;
				top: 0;
				z-index: -1;
				background: linear-gradient(135deg, #5eead4 0%, #3b82f6 100%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				-webkit-text-fill-color: transparent;
				animation: ghost-1 2.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
				opacity: 0;
				pointer-events: none;
			}
			/* 动态残影 2 - 粉橙系 */
			.glitch-text::after {
				content: attr(data-text);
				position: absolute;
				left: 0;
				top: 0;
				z-index: -2;
				background: linear-gradient(135deg, #f472b6 0%, #fb923c 100%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				-webkit-text-fill-color: transparent;
				animation: ghost-2 2.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite 0.15s;
				opacity: 0;
				pointer-events: none;
			}
			/* 悬停时残影加速爆发 */
			.hero h1:hover .glitch-text::before,
			.hero h1:hover .glitch-text::after {
				animation-duration: 1s;
			}

			@keyframes text-float {
				0%, 100% { transform: scale(1) translateY(0); }
				50% { transform: scale(1.02) translateY(-3px); }
			}
			@keyframes ghost-1 {
				0%, 100% { transform: translate(0, 0) scale(1); opacity: 0; filter: blur(0); }
				30% { transform: translate(-10px, 5px) scale(1.02); opacity: 0.6; filter: blur(3px); }
				70% { transform: translate(-22px, 12px) scale(1.05); opacity: 0; filter: blur(8px); }
			}
			@keyframes ghost-2 {
				0%, 100% { transform: translate(0, 0) scale(1); opacity: 0; filter: blur(0); }
				30% { transform: translate(10px, -5px) scale(1.02); opacity: 0.4; filter: blur(3px); }
				70% { transform: translate(22px, -12px) scale(1.05); opacity: 0; filter: blur(8px); }
			}

			.hero .slogan {
				margin: 18px 0 0;
				font-size: 20px;
				line-height: 1.5;
				color: #e6ebff;
				font-weight: 600;
				animation: slide-up 0.6s ease 0.2s both;
			}
			.hero .sub {
				margin: 12px 0 0;
				font-size: 15px;
				color: #aab6e0;
				animation: slide-up 0.6s ease 0.3s both;
			}

			/* ================= 按钮流光特效 ================= */
			.cta {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 28px;
				animation: slide-up 0.6s ease 0.4s both;
			}
			.btn {
				position: relative;
				display: inline-block;
				padding: 11px 24px;
				border-radius: 10px;
				font-size: 15px;
				font-weight: 600;
				text-decoration: none;
				line-height: 1.4;
				overflow: hidden;
				transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
			}
			/* Q弹悬停与点击 */
			.btn:hover {
				transform: translateY(-3px) scale(1.04);
			}
			.btn:active {
				transform: translateY(0) scale(0.96);
			}
			/* 扫光效果 */
			.btn::after {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 50%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
				transform: skewX(-20deg);
				transition: left 0.6s ease;
			}
			.btn:hover::after {
				left: 200%;
			}

			.btn.primary {
				background: linear-gradient(90deg, #3b5bdb, #5c7cfa, #3b5bdb);
				background-size: 200% 100%;
				color: #fff;
				animation: flow-bg 3s linear infinite;
				box-shadow: 0 4px 15px rgba(59, 91, 219, 0.3);
			}
			.btn.primary:hover {
				box-shadow: 0 10px 25px rgba(59, 91, 219, 0.5);
			}
			@keyframes flow-bg {
				0% { background-position: 0% 50%; }
				100% { background-position: 200% 50%; }
			}

			.btn.ghost {
				border: 1px solid rgba(255, 255, 255, 0.4);
				color: #fff;
				background: rgba(255, 255, 255, 0.05);
				backdrop-filter: blur(4px);
			}
			.btn.ghost:hover {
				background: rgba(255, 255, 255, 0.15);
				border-color: #fff;
				box-shadow: 0 8px 20px rgba(255, 255, 255, 0.15);
			}

			.btn.dl {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				border: 1px solid #5eead4;
				color: #5eead4;
				background: rgba(94, 234, 212, 0.05);
			}
			.btn.dl:hover {
				background: rgba(94, 234, 212, 0.15);
				box-shadow: 0 8px 20px rgba(94, 234, 212, 0.2);
			}

			.art {
				width: 100%;
				max-width: 380px;
				margin: 8px auto 0;
				animation: fade-in 1s ease 0.5s both;
			}

			/* ================= 页面区块 ================= */
			section.block {
				padding: 56px 0 8px;
			}
			.label {
				font-size: 13px;
				letter-spacing: 0.18em;
				color: #3b5bdb;
				margin: 0 0 8px;
				font-weight: 600;
			}
			.block h2 {
				margin: 0 0 8px;
				font-size: 26px;
				line-height: 1.3;
				color: #0f172a;
			}
			.lead {
				margin: 0 0 28px;
				color: #475569;
				font-size: 16px;
			}

			/* ================= 卡片 Q 弹交互 ================= */
			.cards {
				display: grid;
				grid-template-columns: 1fr;
				gap: 16px;
			}
			.card {
				background: #fff;
				border: 1px solid #e2e8f0;
				border-radius: 14px;
				padding: 22px;
				transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, border-color 0.3s ease;
			}
			.card:hover {
				transform: translateY(-8px) scale(1.02);
				box-shadow: 0 16px 30px -10px rgba(59, 91, 219, 0.15);
				border-color: rgba(59, 91, 219, 0.3);
			}
			.card .no {
				font-size: 13px;
				font-weight: 700;
				color: #3b5bdb;
				letter-spacing: 0.1em;
			}
			.card h3 {
				margin: 6px 0 8px;
				font-size: 18px;
				line-height: 1.4;
				color: #0f172a;
			}
			.card p {
				margin: 0;
				font-size: 15px;
				color: #475569;
			}

			/* ================= 领域列表 ================= */
			.fields {
				display: grid;
				grid-template-columns: 1fr;
				gap: 12px;
			}
			.field {
				display: flex;
				gap: 14px;
				align-items: flex-start;
				padding: 16px 18px;
				border-radius: 12px;
				background: #f1f5ff;
				transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
			}
			.field:hover {
				transform: translateX(6px) scale(1.01);
				background: #e8eeff;
			}
			.field svg {
				flex: none;
				width: 28px;
				height: 28px;
				margin-top: 2px;
				transition: transform 0.3s ease;
			}
			.field:hover svg {
				transform: rotate(15deg) scale(1.1);
			}
			.field b {
				display: block;
				font-size: 16px;
				color: #0f172a;
			}
			.field span {
				font-size: 14px;
				color: #475569;
			}

			/* ================= 宣言 ================= */
			.manifesto {
				margin: 56px 0 0;
				background: #0b1020;
				color: #e6ebff;
				text-align: center;
				padding: 52px 0;
				position: relative;
				overflow: hidden;
			}
			.manifesto::before {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(ellipse at center, rgba(143, 168, 255, 0.1), transparent 70%);
			}
			.manifesto p {
				margin: 0 auto;
				max-width: 640px;
				font-size: 20px;
				line-height: 1.8;
				font-weight: 600;
				position: relative;
			}
			.manifesto small {
				display: block;
				margin-top: 14px;
				color: #8fa8ff;
				font-size: 13px;
				letter-spacing: 0.15em;
				position: relative;
			}

			/* ================= 结尾 ================= */
			.end {
				text-align: center;
				padding: 56px 0 64px;
			}
			.end h2 {
				margin: 0 0 8px;
				font-size: 24px;
			}
			.end p {
				margin: 0 0 22px;
				color: #475569;
			}
			.end .btn.primary {
				background: linear-gradient(90deg, #14204a, #3b5bdb, #14204a);
				background-size: 200% 100%;
				color: #fff;
			}

			/* ================= 涂鸦与手写字 ================= */
			.doodle-left {
				position: absolute;
				left: 3%;
				bottom: 80px;
				display: flex;
				flex-direction: column;
				gap: 6px;
				pointer-events: none;
				user-select: none;
				transform: rotate(-5deg);
				z-index: 1;
			}
			.doodle-left span {
				font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', cursive;
				font-size: 26px;
				color: rgba(0, 0, 0, 0.25);
				font-weight: 700;
				letter-spacing: 2px;
				animation: float-up 4s ease-in-out infinite alternate;
			}
			.doodle-left span:nth-child(2) {
				margin-left: 24px;
				font-size: 20px;
				opacity: 0.8;
				animation-delay: 1s;
			}

			.doodle-right {
				position: absolute;
				right: 4%;
				bottom: 100px;
				display: flex;
				align-items: center;
				justify-content: center;
				transform: rotate(8deg);
				pointer-events: none;
				user-select: none;
				z-index: 1;
			}
			.doodle-right .graffiti {
				font-family: 'Comic Sans MS', 'Chalkboard SE', 'Marker Felt', cursive;
				font-size: 32px;
				font-weight: 900;
				color: #ff6b6b;
				text-shadow: 2px 2px 0 #fff, 4px 4px 0 rgba(0, 0, 0, 0.1);
				transform: rotate(-10deg);
				animation: wiggle 3s ease-in-out infinite alternate;
			}
			.doodle-scribble {
				position: absolute;
				top: -25px;
				left: -30px;
				width: 140px;
				height: 140px;
				opacity: 0.6;
			}

			@keyframes float-up {
				0% { transform: translateY(0); }
				100% { transform: translateY(-10px); }
			}
			@keyframes wiggle {
				0% { transform: rotate(-8deg) scale(1); }
				100% { transform: rotate(-14deg) scale(1.05); }
			}

			/* ================= 响应式 ================= */
			@media (min-width: 720px) {
				.hero .wrap {
					grid-template-columns: 1.1fr 0.9fr;
					gap: 32px;
					padding-top: 72px;
					padding-bottom: 64px;
				}
				.hero h1 {
					font-size: 84px;
				}
				.hero .slogan {
					font-size: 24px;
				}
				.art {
					margin: 0;
				}
				.cards {
					grid-template-columns: repeat(3, 1fr);
				}
				.fields {
					grid-template-columns: repeat(2, 1fr);
				}
				.block h2 {
					font-size: 30px;
				}
			}
			@media (max-width: 900px) {
				.doodle-left, .doodle-right {
					display: none; /* 移动端隐藏涂鸦防止重叠 */
				}
			}

			/* ================= 深色模式 ================= */
			:global(html[data-theme='dark']) main.home {
				color: #e2e8f0;
				background: #0b1020;
			}
			:global(html[data-theme='dark']) section.block {
				background: #0b1020;
			}
			:global(html[data-theme='dark']) .block h2,
			:global(html[data-theme='dark']) .card h3,
			:global(html[data-theme='dark']) .field b,
			:global(html[data-theme='dark']) .end h2 { color: #f1f5f9; }
			:global(html[data-theme='dark']) .lead,
			:global(html[data-theme='dark']) .card p,
			:global(html[data-theme='dark']) .field span,
			:global(html[data-theme='dark']) .end p { color: #aab6d3; }
			:global(html[data-theme='dark']) .card { background: #111a33; border-color: #26335c; }
			:global(html[data-theme='dark']) .card:hover { border-color: rgba(143, 168, 255, 0.4); box-shadow: 0 16px 30px -10px rgba(0, 0, 0, 0.4); }
			:global(html[data-theme='dark']) .field { background: #14204a; }
			:global(html[data-theme='dark']) .field:hover { background: #1a2b5e; }
			:global(html[data-theme='dark']) .label,
			:global(html[data-theme='dark']) .card .no { color: #8fa8ff; }
			:global(html[data-theme='dark']) .manifesto { background: #070b18; }
			:global(html[data-theme='dark']) .end {
				background: #0b1020;
			}
			:global(html[data-theme='dark']) .end .btn.primary { background: linear-gradient(90deg, #8fa8ff, #3b5bdb, #8fa8ff); background-size: 200% 100%; color: #0b1020; }
			:global(html[data-theme='dark']) .doodle-left span { color: rgba(255, 255, 255, 0.2); }
			:global(html[data-theme='dark']) .doodle-right .graffiti { text-shadow: 2px 2px 0 #0b1020, 4px 4px 0 rgba(255, 255, 255, 0.1); }

			/* 动画基础 */
			@keyframes slide-up {
				from { opacity: 0; transform: translateY(20px); }
				to { opacity: 1; transform: none; }
			}
			@keyframes fade-in {
				from { opacity: 0; }
				to { opacity: 1; }
			}
		</style>
	</head>
	<body>
		<Header />
		<Snow />
		<main class="home">
			
			<!-- 左侧留白手写字 -->
			<div class="doodle-left" aria-hidden="true">
				<span>保持热爱</span>
				<span>奔赴山海</span>
			</div>

			<!-- 右侧留白涂鸦字 -->
			<div class="doodle-right" aria-hidden="true">
				<svg class="doodle-scribble" viewBox="0 0 100 100" fill="none" stroke="#5eead4" stroke-width="2" stroke-linecap="round">
					<path d="M50,5 C80,5 95,30 95,60 C95,90 70,95 50,95 C20,95 5,80 5,50 C5,20 30,5 50,5 Z" stroke-dasharray="4 6" />
					<path d="M30,20 L20,10 M80,80 L90,90" />
				</svg>
				<span class="graffiti">Eureka!</span>
			</div>

			<!-- Hero -->
			<section class="hero">
				<div class="wrap">
					<div>
						<p class="eyebrow">PERSONAL LAB · 个人实验室</p>
						<h1>
							<!-- 使用 data-text 实现残影特效 -->
							<span class="glitch-text" data-text="REOG">REOG</span>
						</h1>
						<p class="slogan">把复杂的事，做成简单可靠的系统。</p>
						<p class="sub">工程 · 产品 · 长期主义。在这里记录我如何思考、构建与复盘。</p>
						<div class="cta">
							<a class="btn primary" href="/blog">阅读文章</a>
							<a class="btn ghost" href="/about">关于我</a>
							<a class="btn dl" id="dl-app" href={DOWNLOAD_URL} rel="noopener" title="下载 Windows 桌面版">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" /></svg>
								下载 App
							</a>
						</div>
					</div>
					<div class="art" aria-hidden="true">
						<HeroOrbit />
					</div>
				</div>
			</section>

			<!-- 方法论 -->
			<section class="block">
				<div class="wrap">
					<p class="label">PRINCIPLES · 方法论</p>
					<h2>三条做事原则</h2>
					<p class="lead">不追热点，只保留经得起时间检验的做法。</p>
					<div class="cards">
						{
							principles.map((p) => (
								<div class="card">
									<span class="no">{p.no}</span>
									<h3>{p.title}</h3>
									<p>{p.desc}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- 方向 -->
			<section class="block">
				<div class="wrap">
					<p class="label">FOCUS · 关注方向</p>
					<h2>我持续投入的领域</h2>
					<p class="lead">每个方向都围绕同一件事：用更少的力气，获得更可靠的结果。</p>
					<div class="fields">
						{
							fields.map((f) => (
								<div class="field">
									<svg viewBox="0 0 24 24" fill="none" stroke="#3b5bdb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 3 3 8l9 5 9-5-9-5Z" />
										<path d="m3 13 9 5 9-5" />
									</svg>
									<div>
										<b>{f.name}</b>
										<span>{f.note}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

