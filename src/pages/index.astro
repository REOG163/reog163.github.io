---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em;
			}
			.hero h1 {
				margin: 0 0 0.3em;
				font-size: 2.4em;
			}
			.hero p {
				font-size: 1.15em;
				color: rgb(var(--gray-dark));
				margin: 0;
			}
			.links {
				display: flex;
				gap: 1em;
				margin-top: 1.8em;
			}
			.links a {
				padding: 0.6em 1.4em;
				border-radius: 8px;
				text-decoration: none;
				border: 1px solid rgb(var(--accent));
			}
			.links a.primary {
				background: rgb(var(--accent));
				color: #fff;
			}
			.links a.secondary {
				color: rgb(var(--accent));
			}
			.topics {
				margin-top: 3em;
			}
			.topics h2 {
				font-size: 1.3em;
				margin-bottom: 0.6em;
			}
			.topics ul {
				list-style: none;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			.topics li {
				padding: 0.3em 0.9em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				font-size: 0.95em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>你好，我是 [你的名字]</h1>
				<p>记录思考，分享所学。写代码，也写生活。</p>
				<div class="links">
					<a class="primary" href="/blog">阅读文章</a>
					<a class="secondary" href="/about">关于我</a>
				</div>
			</section>

			<section class="topics">
				<h2>关注方向</h2>
				<ul>
					<li>技术笔记</li>
					<li>项目复盘</li>
					<li>效率工具</li>
					<li>生活随想</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
