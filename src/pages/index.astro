---
import Snow from '../components/Snow.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Windows 桌面版下载地址（由 GitHub Actions 自动发布到 Releases）
const DOWNLOAD_URL = 'https://github.com/REOG163/reog163.github.io/releases/latest/download/REOG-Setup.exe';

const principles = [
	{
		no: '01',
		title: '先问为什么，再问怎么做',
		desc: '多数返工源于问题没定义清楚。动手之前，先把目标、约束与成功标准写下来。',
	},
	{
		no: '02',
		title: '小步迭代，持续验证',
		desc: '把大目标拆成可交付、可回退的小步骤。每一步都有反馈，错误成本才可控。',
	},
	{
		no: '03',
		title: '记录即资产',
		desc: '经验不写下来就会衰减。文章、笔记与复盘，是时间留给自己的复利。',
	},
];

const fields = [
	{ name: '系统设计', note: '用最少的部件，搭出稳定的结构' },
	{ name: '自动化与 AI 工具', note: '把重复劳动交给机器，把判断留给自己' },
	{ name: '独立开发', note: '从想法到上线，完整走通一遍' },
	{ name: '知识管理', note: '让学到的东西可检索、可复用、可传递' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main.home {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
				font-size: 16px;
				line-height: 1.7;
				color: #0f172a;
			}
			.wrap {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 0 20px;
				box-sizing: border-box;
			}

			/* Hero */
			.hero {
				background: linear-gradient(160deg, #0b1020 0%, #14204a 60%, #1d2f6b 100%);
				color: #fff;
				overflow: hidden;
			}
			.hero .wrap {
				display: grid;
				grid-template-columns: 1fr;
				gap: 8px;
				padding-top: 48px;
				padding-bottom: 40px;
				align-items: center;
			}
			.eyebrow {
				font-size: 13px;
				letter-spacing: 0.2em;
				color: #8fa8ff;
				margin: 0 0 12px;
			}
			.hero h1 {
				margin: 0;
				font-size: 56px;
				line-height: 1.05;
				letter-spacing: 0.04em;
				color: #fff;
			}
			.hero .slogan {
				margin: 18px 0 0;
				font-size: 20px;
				line-height: 1.5;
				color: #e6ebff;
				font-weight: 600;
			}
			.hero .sub {
				margin: 12px 0 0;
				font-size: 15px;
				color: #aab6e0;
			}
			.cta {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 28px;
			}
			.btn {
				display: inline-block;
				padding: 11px 24px;
				border-radius: 10px;
				font-size: 15px;
				font-weight: 600;
				text-decoration: none;
				line-height: 1.4;
			}
			.btn.primary {
				background: #fff;
				color: #14204a;
			}
			.btn.ghost {
				border: 1px solid rgba(255, 255, 255, 0.4);
				color: #fff;
			}
			.btn.dl {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				border: 1px solid #5eead4;
				color: #5eead4;
			}
			.btn.dl:hover {
				background: rgba(94, 234, 212, 0.12);
			}
			.art {
				width: 100%;
				max-width: 380px;
				margin: 8px auto 0;
			}
			.art svg {
				width: 100%;
				height: auto;
				display: block;
			}
			.spin {
				transform-origin: 200px 200px;
				animation: spin 40s linear infinite;
			}
			.spin.rev {
				animation-duration: 60s;
				animation-direction: reverse;
			}
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.spin {
					animation: none;
				}
			}

			/* Sections */
			section.block {
				padding: 56px 0 8px;
			}
			.label {
				font-size: 13px;
				letter-spacing: 0.18em;
				color: #3b5bdb;
				margin: 0 0 8px;
				font-weight: 600;
			}
			.block h2 {
				margin: 0 0 8px;
				font-size: 26px;
				line-height: 1.3;
				color: #0f172a;
			}
			.lead {
				margin: 0 0 28px;
				color: #475569;
				font-size: 16px;
			}

			/* Principles */
			.cards {
				display: grid;
				grid-template-columns: 1fr;
				gap: 16px;
			}
			.card {
				background: #fff;
				border: 1px solid #e2e8f0;
				border-radius: 14px;
				padding: 22px;
			}
			.card .no {
				font-size: 13px;
				font-weight: 700;
				color: #3b5bdb;
				letter-spacing: 0.1em;
			}
			.card h3 {
				margin: 6px 0 8px;
				font-size: 18px;
				line-height: 1.4;
				color: #0f172a;
			}
			.card p {
				margin: 0;
				font-size: 15px;
				color: #475569;
			}

			/* Fields */
			.fields {
				display: grid;
				grid-template-columns: 1fr;
				gap: 12px;
			}
			.field {
				display: flex;
				gap: 14px;
				align-items: flex-start;
				padding: 16px 18px;
				border-radius: 12px;
				background: #f1f5ff;
			}
			.field svg {
				flex: none;
				width: 28px;
				height: 28px;
				margin-top: 2px;
			}
			.field b {
				display: block;
				font-size: 16px;
				color: #0f172a;
			}
			.field span {
				font-size: 14px;
				color: #475569;
			}

			/* Manifesto */
			.manifesto {
				margin: 56px 0 0;
				background: #0b1020;
				color: #e6ebff;
				text-align: center;
				padding: 52px 0;
			}
			.manifesto p {
				margin: 0 auto;
				max-width: 640px;
				font-size: 20px;
				line-height: 1.8;
				font-weight: 600;
			}
			.manifesto small {
				display: block;
				margin-top: 14px;
				color: #8fa8ff;
				font-size: 13px;
				letter-spacing: 0.15em;
			}

			/* Bottom CTA */
			.end {
				text-align: center;
				padding: 56px 0 64px;
			}
			.end h2 {
				margin: 0 0 8px;
				font-size: 24px;
			}
			.end p {
				margin: 0 0 22px;
				color: #475569;
			}
			.end .btn.primary {
				background: #14204a;
				color: #fff;
			}

			@media (min-width: 720px) {
				.hero .wrap {
					grid-template-columns: 1.1fr 0.9fr;
					gap: 32px;
					padding-top: 72px;
					padding-bottom: 64px;
				}
				.hero h1 {
					font-size: 84px;
				}
				.hero .slogan {
					font-size: 24px;
				}
				.art {
					margin: 0;
				}
				.cards {
					grid-template-columns: repeat(3, 1fr);
				}
				.fields {
					grid-template-columns: repeat(2, 1fr);
				}
				.block h2 {
					font-size: 30px;
				}
			}
					/* 深色模式 */
			:global(html[data-theme='dark']) main.home { color: #e2e8f0; }
			:global(html[data-theme='dark']) .block h2,
			:global(html[data-theme='dark']) .card h3,
			:global(html[data-theme='dark']) .field b,
			:global(html[data-theme='dark']) .end h2 { color: #f1f5f9; }
			:global(html[data-theme='dark']) .lead,
			:global(html[data-theme='dark']) .card p,
			:global(html[data-theme='dark']) .field span,
			:global(html[data-theme='dark']) .end p { color: #aab6d3; }
			:global(html[data-theme='dark']) .card { background: #111a33; border-color: #26335c; }
			:global(html[data-theme='dark']) .field { background: #14204a; }
			:global(html[data-theme='dark']) .label,
			:global(html[data-theme='dark']) .card .no { color: #8fa8ff; }
			:global(html[data-theme='dark']) .manifesto { background: #070b18; }
			:global(html[data-theme='dark']) .end .btn.primary { background: #8fa8ff; color: #0b1020; }
		</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Hero -->
			<section class="hero">
				<div class="wrap">
					<div>
						<p class="eyebrow">PERSONAL LAB · 个人实验室</p>
						<h1>REOG</h1>
						<p class="slogan">把复杂的事，做成简单可靠的系统。</p>
						<p class="sub">工程 · 产品 · 长期主义。在这里记录我如何思考、构建与复盘。</p>
						<div class="cta">
							<a class="btn primary" href="/blog">阅读文章</a>
							<a class="btn ghost" href="/about">关于我</a>
							<a class="btn dl" id="dl-app" href={DOWNLOAD_URL} rel="noopener" title="下载 Windows 桌面版">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" /></svg>
								下载 App
							</a>
						</div>
					</div>
					<div class="art" aria-hidden="true">
						<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
							<defs>
								<radialGradient id="glow" cx="50%" cy="50%" r="50%">
									<stop offset="0%" stop-color="#6d8bff" stop-opacity="0.55" />
									<stop offset="100%" stop-color="#6d8bff" stop-opacity="0" />
								</radialGradient>
								<linearGradient id="ring" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#8fa8ff" />
									<stop offset="100%" stop-color="#5eead4" />
								</linearGradient>
							</defs>
							<circle cx="200" cy="200" r="190" fill="url(#glow)" />
							<g stroke="#8fa8ff" stroke-opacity="0.15" stroke-width="1">
								<path d="M0 100H400M0 200H400M0 300H400M100 0V400M200 0V400M300 0V400" />
							</g>
							<circle cx="200" cy="200" r="160" fill="none" stroke="#8fa8ff" stroke-opacity="0.25" />
							<circle cx="200" cy="200" r="110" fill="none" stroke="url(#ring)" stroke-width="1.5" stroke-opacity="0.8" />
							<circle cx="200" cy="200" r="60" fill="none" stroke="#8fa8ff" stroke-opacity="0.4" />
							<g class="spin">
								<circle cx="200" cy="40" r="7" fill="#5eead4" />
								<circle cx="200" cy="310" r="5" fill="#8fa8ff" />
							</g>
							<g class="spin rev">
								<circle cx="360" cy="200" r="6" fill="#fff" />
								<circle cx="90" cy="200" r="4" fill="#5eead4" />
							</g>
							<rect x="176" y="176" width="48" height="48" rx="12" fill="#fff" />
							<path d="M190 208V192h12a6 6 0 0 1 0 12h-12m10 0 8 4" fill="none" stroke="#14204a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</div>
				</div>
			</section>

			<!-- 方法论 -->
			<section class="block">
				<div class="wrap">
					<p class="label">PRINCIPLES · 方法论</p>
					<h2>三条做事原则</h2>
					<p class="lead">不追热点，只保留经得起时间检验的做法。</p>
					<div class="cards">
						{
							principles.map((p) => (
								<div class="card">
									<span class="no">{p.no}</span>
									<h3>{p.title}</h3>
									<p>{p.desc}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- 方向 -->
			<section class="block">
				<div class="wrap">
					<p class="label">FOCUS · 关注方向</p>
					<h2>我持续投入的领域</h2>
					<p class="lead">每个方向都围绕同一件事：用更少的力气，获得更可靠的结果。</p>
					<div class="fields">
						{
							fields.map((f) => (
								<div class="field">
									<svg viewBox="0 0 24 24" fill="none" stroke="#3b5bdb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 3 3 8l9 5 9-5-9-5Z" />
										<path d="m3 13 9 5 9-5" />
									</svg>
									<div>
										<b>{f.name}</b>
										<span>{f.note}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- 宣言 -->
			<section class="manifesto">
				<div class="wrap">
					<p>真正的效率，不是更快地做更多，而是更清楚地只做对的事。</p>
					<small>— REOG</small>
				</div>
			</section>

			<!-- 结尾 -->
			<section class="end">
				<div class="wrap">
					<h2>从最新的一篇开始</h2>
					<p>所有文章都来自真实的实践与复盘。</p>
					<a class="btn primary" href="/blog">进入博客</a>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// 在桌面版 App 内不再显示「下载 App」
			if (/REOGApp/.test(navigator.userAgent)) {
				const el = document.getElementById('dl-app');
				if (el) el.style.display = 'none';
			}
		</script>
	</body>
</html>
