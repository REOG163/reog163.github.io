---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// ===== 在这里添加你的作品，复制一段 { ... } 即可 =====
const projects = [
	{
		title: '本站：REOG 个人网站',
		desc: '基于 Astro 构建的中文个人博客，支持深色模式、站内搜索、标签分类、RSS 订阅与评论，通过 GitHub Actions 自动部署到 GitHub Pages。',
		tags: ['Astro', 'GitHub Actions', 'GitHub Pages', 'Giscus'],
		status: '运行中',
		video: '',
		image: '', 
		links: [
			{ label: '访问网站', href: 'https://reog163.github.io' },
			{ label: '查看源码', href: 'https://github.com/REOG163/reog163.github.io' },
		],
	},
];
// ==================================================

const palettes = [
	['#14204a', '#3b5bdb', '#5eead4'],
	['#1d2f6b', '#7c5cff', '#8fa8ff'],
	['#0b3b4a', '#14b8a6', '#a7f3d0'],
];
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`作品集 | ${SITE_TITLE}`} description="我做过的项目与作品" />
		<style>
			@property --angle {
				syntax: '<angle>';
				initial-value: 0deg;
				inherits: false;
			}

			/* =======================================
			   基础布局与卡片样式
			   ======================================= */
			main.pj {
				width: 100%; max-width: 960px; margin: 0 auto; padding: 28px 18px 56px; box-sizing: border-box;
			}
			.label { margin: 0 0 4px; font-size: 13px; letter-spacing: 0.18em; font-weight: 600; color: var(--accent); }
			h1 { margin: 0 0 6px; font-size: 30px; color: rgb(var(--black)); }
			.lead { margin: 0 0 24px; font-size: 16px; color: rgb(var(--gray)); }
			
			.grid { display: grid; grid-template-columns: 1fr; gap: 18px; }

			.card {
				display: flex; flex-direction: column; overflow: hidden; border-radius: 14px;
				border: 1px solid rgba(var(--gray), 0.3); background: rgba(var(--gray-light), 0.35);
				position: relative; transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
				animation: cardIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
			}

			@keyframes cardIn {
				from { opacity: 0; transform: translateY(30px) scale(0.98); }
				to { opacity: 1; transform: translateY(0) scale(1); }
			}

			.card:hover {
				transform: translateY(-6px); border-color: rgba(var(--gray), 0.5);
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.2);
			}
			:global(html[data-theme='dark']) .card:hover {
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.6); border-color: #4a5a85;
			}

			/* 封面区域 */
			.cover-wrap {
				width: 100%; aspect-ratio: 2 / 1; overflow: hidden; background: #0b1020; position: relative;
			}
			.cover { display: block; width: 100%; height: 100%; object-fit: cover; }

			/* 01 动效 */
			.tech-bg { fill: url(#bg-grad); }
			.grid-lines { stroke: rgba(94, 234, 212, 0.15); stroke-width: 1; }
			.core-ring { transform-origin: 320px 100px; }
			.ring-fast { animation: spin 6s linear infinite; }
			.ring-reverse { animation: spin 12s linear infinite reverse; }
			.ring-slow { animation: spin 25s linear infinite; }
			@keyframes spin { 100% { transform: rotate(360deg); } }
			.scanner { animation: scan 4s ease-in-out infinite; }
			@keyframes scan { 0%, 100% { transform: translateY(-40px); opacity: 0; } 10%, 90% { opacity: 0.8; } 50% { transform: translateY(40px); opacity: 1; } }
			.energy-pulse { transform-origin: 320px 100px; animation: pulse-ring 3s cubic-bezier(0.2, 0.8, 0.2, 1) infinite; }
			@keyframes pulse-ring { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.8); opacity: 0; } }
			.big-number { animation: number-breathe 3s ease-in-out infinite alternate; filter: drop-shadow(0 0 10px rgba(94, 234, 212, 0.8)); font-family: 'Impact', 'Arial Black', system-ui, sans-serif; }
			@keyframes number-breathe { 0% { transform: scale(1); opacity: 0.85; } 100% { transform: scale(1.05); opacity: 1; } }
			.particle { animation: float-up 5s linear infinite; }
			@keyframes float-up { 0% { transform: translateY(0); opacity: 0; } 20% { opacity: 1; } 80% { opacity: 1; } 100% { transform: translateY(-80px); opacity: 0; } }

			/* =======================================
			   卡片内的真实重击印章 (Meteor Strike)
			   ======================================= */
			.seal-stamp-wrapper {
				position: absolute; bottom: 15px; right: 18px; width: 95px; height: 95px; z-index: 50;
				cursor: pointer; pointer-events: auto !important; 
				/* 初始隐藏，等待砸落 */
				opacity: 0;
				animation: meteor-strike 1.2s cubic-bezier(0.1, 1.5, 0.2, 1) 1s forwards; 
			}
			.seal-stamp-wrapper:hover {
				transform: scale(1.15) rotate(-5deg); filter: brightness(1.3) drop-shadow(0 0 20px rgba(255, 50, 50, 0.8));
			}

			/* 动感模糊与砸落震颤 */
			@keyframes meteor-strike {
				0% { transform: scale(6) translateY(-400px) rotate(-35deg); opacity: 0; filter: blur(20px); }
				20% { filter: blur(5px); }
				40% { transform: scale(0.85) translateY(10px) rotate(8deg); opacity: 1; filter: blur(0); } /* 轰击命中 */
				45% { transform: scale(1.15) translateY(-15px) rotate(-3deg); } /* 强力反弹 */
				55% { transform: scale(0.95) translateY(5px) rotate(2deg); }
				65% { transform: scale(1.05) translateY(-2px) rotate(0deg); }
				80%, 100% { transform: scale(1) translateY(0) rotate(0deg); opacity: 1; }
			}

			/* 卡片物理震颤 */
			.card.shake {
				animation: camera-shake 0.6s cubic-bezier(.36,.07,.19,.97) both 1.3s;
			}
			@keyframes camera-shake {
				10%, 90% { transform: translate3d(-2px, 1px, 0) rotate(-1deg); }
				20%, 80% { transform: translate3d(4px, -2px, 0) rotate(1deg); }
				30%, 50%, 70% { transform: translate3d(-6px, 3px, 0) rotate(-2deg); }
				40%, 60% { transform: translate3d(6px, -3px, 0) rotate(2deg); }
			}

			/* 等离子冲击波 */
			.seal-shockwave {
				position: absolute; inset: 0; border-radius: 50%;
				border: 4px solid rgba(255, 20, 20, 0.9); box-shadow: 0 0 40px rgba(255, 20, 20, 0.8), inset 0 0 20px rgba(255, 20, 20, 0.5);
				animation: mega-shockwave 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) 1.3s backwards; opacity: 0; pointer-events: none;
			}
			@keyframes mega-shockwave {
				0% { transform: scale(0.2); opacity: 1; border-width: 15px; }
				100% { transform: scale(3); opacity: 0; border-width: 0px; }
			}

			.seal-stamp-wrapper svg {
				width: 100%; height: 100%; pointer-events: none;
				filter: drop-shadow(0 8px 16px rgba(0,0,0,0.9)) drop-shadow(0 0 5px rgba(200, 30, 30, 0.6));
			}

			/* =======================================
			   内容区
			   ======================================= */
			.body { padding: 16px 18px 90px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
			.head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }

			/* 黄金流光文字 */
			.card h2, .soon b {
				margin: 0; font-size: 19px; line-height: 1.4; font-weight: 800; letter-spacing: 0.5px;
				background: linear-gradient(135deg, #bf953f 0%, #fcf6ba 25%, #b38728 50%, #fbf5b7 75%, #aa771c 100%);
				background-size: 200% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
				animation: shine 4s linear infinite; filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2));
			}
			@keyframes shine { to { background-position: 200% center; } }

			/* 状态标签 */
			.status {
				flex: none; font-size: 12px; padding: 2px 10px; border-radius: 999px;
				background: rgba(94, 234, 212, 0.15); color: #0f9d8a; border: 1px solid rgba(94, 234, 212, 0.3);
				display: flex; align-items: center; gap: 6px; font-weight: 600;
			}
			.status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #0f9d8a; box-shadow: 0 0 6px #0f9d8a; animation: blink 2s infinite ease-in-out; }
			@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
			:global(html[data-theme='dark']) .status { color: #5eead4; border-color: rgba(94, 234, 212, 0.4); }
			:global(html[data-theme='dark']) .status::before { background: #5eead4; box-shadow: 0 0 6px #5eead4; }

			.card p { margin: 0; font-size: 15px; line-height: 1.75; color: rgb(var(--gray-dark)); }
			.tags { display: flex; flex-wrap: wrap; gap: 6px; }
			.tags span { font-size: 12px; padding: 2px 10px; border-radius: 6px; background: rgba(var(--gray), 0.1); color: rgb(var(--gray-dark)); }
			.links { display: flex; gap: 14px; margin-top: 10px; }
			.links a { font-size: 14px; font-weight: 600; color: var(--accent); text-decoration: none; }
			.links a:hover { opacity: 0.8; }

			/* 筹备中卡片 */
			.soon {
				align-items: center; justify-content: center; text-align: center;
				border-style: dashed; border-width: 2px; padding: 36px 20px; background: transparent; border-color: rgba(var(--gray), 0.4);
			}
			.soon:hover { background: rgba(var(--gray-light), 0.2); border-color: rgba(94, 234, 212, 0.6); }
			:global(html[data-theme='dark']) .soon { border-color: #26335c; }
			:global(html[data-theme='dark']) .soon:hover { border-color: #5eead4; background: rgba(26, 36, 64, 0.6); }
			.soon-icon { margin-bottom: 12px; color: var(--accent); animation: float 3s ease-in-out infinite; display: flex; justify-content: center; }
			@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
			.soon span { font-size: 14px; color: rgb(var(--gray)); margin-top: 4px; }

			@media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
			:global(html[data-theme='dark']) .card { background: rgba(26, 36, 64, 0.95); border-color: #26335c; }

			/* =======================================
			   终极全屏检视 Modal (Cinematic VFX)
			   ======================================= */
			.modal-overlay {
				position: fixed; inset: 0; background: rgba(0, 0, 0, 0.98);
				z-index: 99999; display: flex; align-items: center; justify-content: center;
				opacity: 0; visibility: hidden; transition: all 0.5s ease;
				perspective: 2000px; overflow: hidden;
			}
			.modal-overlay.active { opacity: 1; visibility: visible; }

			/* 1. 深渊能量网格 (极光底纹) */
			.modal-bg-energy {
				position: absolute; inset: 0;
				background: 
					radial-gradient(circle at center, rgba(200, 20, 30, 0.25) 0%, transparent 70%),
					linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
				background-size: 100% 100%, 60px 60px, 60px 60px;
				opacity: 0; transform: scale(1.5);
				transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.modal-overlay.active .modal-bg-energy { 
				opacity: 1; transform: scale(1); 
				animation: grid-pulse 3s infinite alternate; 
			}
			@keyframes grid-pulse { from { background-size: 100% 100%, 60px 60px, 60px 60px; } to { background-size: 100% 100%, 70px 70px, 70px 70px; } }

			/* 2. 好莱坞神圣光芒 (God Rays) */
			.modal-god-rays {
				position: absolute; width: 400vw; height: 400vw; top: 50%; left: 50%;
				transform: translate(-50%, -50%) scale(0); z-index: 1; opacity: 0;
				background: repeating-conic-gradient(
					from 0deg,
					rgba(255, 30, 30, 0.2) 0deg 2deg,
					transparent 2deg 10deg
				);
				mask-image: radial-gradient(circle, black 5%, transparent 50%);
				-webkit-mask-image: radial-gradient(circle, black 5%, transparent 50%);
			}
			.modal-overlay.active .modal-god-rays {
				animation: rays-burst 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards, spin-god-rays 40s linear infinite;
			}
			@keyframes rays-burst { 0% { transform: translate(-50%, -50%) scale(0); opacity: 0; } 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
			@keyframes spin-god-rays { 100% { transform: translate(-50%, -50%) rotate(360deg); } }

			/* 3. 巨型冲击波核爆 (Mega Shockwave) */
			.modal-shockwave-ring {
				position: absolute; top: 50%; left: 50%; width: 10px; height: 10px;
				border-radius: 50%; border: 8px solid rgba(255, 255, 255, 1); z-index: 2;
				transform: translate(-50%, -50%) scale(0); opacity: 0;
				box-shadow: 0 0 100px #ff1a33, inset 0 0 100px #ff1a33;
			}
			.modal-overlay.active .modal-shockwave-ring {
				animation: mega-wave 1.2s cubic-bezier(0.1, 0.9, 0.2, 1) 0.3s forwards;
			}
			@keyframes mega-wave {
				0% { transform: translate(-50%, -50%) scale(0); opacity: 1; border-width: 30px; }
				100% { transform: translate(-50%, -50%) scale(120); opacity: 0; border-width: 1px; }
			}

			/* 4. 镜头光晕与色差特效 */
			.modal-lens-flare {
				position: absolute; inset: -100px; z-index: 5; pointer-events: none;
				background: radial-gradient(circle at 25% 25%, rgba(255,255,255,0.9) 0%, transparent 15%),
							linear-gradient(45deg, transparent 45%, rgba(255, 50, 50, 0.4) 50%, transparent 55%);
				mix-blend-mode: screen; opacity: 0;
			}
			.modal-overlay.active .modal-lens-flare { animation: flare-flash 1s ease-out 0.5s forwards; }
			@keyframes flare-flash { 0% { opacity: 0; transform: scale(0.5); } 30% { opacity: 1; transform: scale(1.2); } 100% { opacity: 0.7; transform: scale(1); } }

			/* 5. 核心印章主体 (陨石破屏 Z轴拉伸) */
			.modal-content {
				width: 90vw; height: 90vw; max-width: 700px; max-height: 700px; position: relative; z-index: 10;
				/* 初始在极深远方，微小且模糊 */
				transform: scale(0.01) rotateZ(90deg) rotateX(80deg) translateZ(-3000px);
				opacity: 0; filter: blur(30px) brightness(2);
				transition: all 1.2s cubic-bezier(0.1, 1.5, 0.2, 1);
			}
			.modal-overlay.active .modal-content {
				/* 狂飙到眼前 */
				transform: scale(1) rotateZ(0deg) rotateX(10deg) rotateY(-10deg) translateZ(0);
				opacity: 1; filter: blur(0) brightness(1);
				animation: final-hover-3d 5s ease-in-out infinite alternate 1.2s;
			}
			@keyframes final-hover-3d {
				0% { transform: scale(1) rotateX(10deg) rotateY(-10deg) translateY(0); }
				100% { transform: scale(1.03) rotateX(15deg) rotateY(15deg) translateY(-15px); }
			}

			.modal-content svg {
				width: 100%; height: 100%;
				filter: drop-shadow(0 40px 80px rgba(255, 0, 0, 0.8)) drop-shadow(0 0 200px rgba(255, 50, 50, 0.5));
			}

			/* 6. 漫天飞舞的能量粒子 */
			.modal-particle {
				position: absolute; background: #fff; border-radius: 50%; pointer-events: none; z-index: 3;
				box-shadow: 0 0 10px #fff, 0 0 30px #ff2a40, 0 0 50px #ff2a40; opacity: 0;
			}
			.modal-overlay.active .modal-particle { animation: particle-fly var(--dur, 2s) ease-out forwards; }
			@keyframes particle-fly {
				0% { transform: translate(0, 0) scale(1); opacity: 1; filter: brightness(2); }
				100% { transform: translate(var(--tx), var(--ty)) scale(0); opacity: 0; }
			}

			/* SVG 内部光效增强 */
			.gold-blade { animation: spin 4s linear infinite; transform-origin: 200px 200px; }
			.gem-core-pulse { animation: core-lava 2s ease-in-out infinite alternate; }
			@keyframes core-lava {
				0% { opacity: 0.5; filter: drop-shadow(0 0 20px rgba(255, 0, 0, 0.8)); }
				100% { opacity: 1; filter: drop-shadow(0 0 60px rgba(255, 100, 100, 1)); }
			}

			/* 右上角关闭提示 */
			.modal-close-hint {
				position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%);
				font-size: 13px; color: rgba(255,255,255,0.6);
				letter-spacing: 4px; font-family: monospace; z-index: 20; opacity: 0; transition: opacity 0.5s;
				cursor: pointer; padding: 10px 20px; border: 1px solid rgba(255,255,255,0.2); border-radius: 30px;
				background: rgba(0,0,0,0.5); backdrop-filter: blur(5px);
			}
			.modal-overlay.active .modal-close-hint { opacity: 1; transition-delay: 2s; }
			.modal-close-hint:hover { color: #fff; border-color: #fff; background: rgba(255,255,255,0.1); }
		</style>
	</head>
	<body>
		<Header />
		<main class="pj">
			<p class="label">PROJECTS · 作品集</p>
			<h1>我做过的东西</h1>
			<p class="lead">每个项目都是一次完整的实践：从想法到上线。</p>

			<div class="grid">
				{
					projects.map((p, i) => {
						const c = palettes[i % palettes.length];
						return (
							<div class="card" id="project-card">
								
								<div class="cover-wrap">
									{p.video ? (
										<video class="cover js-video" src={p.video} autoplay muted loop playsinline preload="metadata" />
									) : p.image ? (
										<img class="cover" src={p.image} alt={p.title} style="background: #0b1020;" />
									) : (
										<svg class="cover" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
											<defs>
												<radialGradient id="bg-grad" cx="80%" cy="50%" r="80%">
													<stop offset="0%" stop-color="#14204a" />
													<stop offset="100%" stop-color="#0b1020" />
												</radialGradient>
												<linearGradient id="num-grad" x1="0" y1="0" x2="1" y2="1">
													<stop offset="0%" stop-color="#ffffff" />
													<stop offset="100%" stop-color="#5eead4" />
												</linearGradient>
												<linearGradient id="scan-grad" x1="0" y1="0" x2="0" y2="1">
													<stop offset="0%" stop-color="rgba(94, 234, 212, 0)" />
													<stop offset="50%" stop-color="rgba(94, 234, 212, 0.5)" />
													<stop offset="100%" stop-color="rgba(94, 234, 212, 0)" />
												</linearGradient>
											</defs>
											<rect width="400" height="200" class="tech-bg" />
											<g class="grid-lines">
												<line x1="0" y1="50" x2="400" y2="50" />
												<line x1="0" y1="100" x2="400" y2="100" />
												<line x1="0" y1="150" x2="400" y2="150" />
												<line x1="50" y1="0" x2="50" y2="200" />
												<line x1="150" y1="0" x2="150" y2="200" />
												<line x1="250" y1="0" x2="250" y2="200" />
												<line x1="350" y1="0" x2="350" y2="200" />
											</g>
											<circle cx="320" cy="100" r="70" fill="none" stroke="rgba(94, 234, 212, 0.2)" stroke-width="1" />
											<circle cx="320" cy="100" r="40" fill="none" stroke="#5eead4" stroke-width="2" class="energy-pulse" />
											<g class="core-ring ring-slow"><circle cx="320" cy="100" r="85" fill="none" stroke="rgba(94, 234, 212, 0.3)" stroke-width="4" stroke-dasharray="2 10" /></g>
											<g class="core-ring ring-reverse"><circle cx="320" cy="100" r="65" fill="none" stroke="#8fa8ff" stroke-width="1.5" stroke-dasharray="15 5" /><circle cx="320" cy="35" r="4" fill="#8fa8ff" filter="drop-shadow(0 0 6px #8fa8ff)" /></g>
											<g class="core-ring ring-fast"><circle cx="320" cy="100" r="50" fill="none" stroke="#5eead4" stroke-width="1" /><circle cx="270" cy="100" r="3" fill="#5eead4" filter="drop-shadow(0 0 8px #5eead4)" /></g>
											<rect x="250" y="60" width="140" height="4" fill="url(#scan-grad)" class="scanner" />
											<circle cx="280" cy="130" r="1.5" fill="#fff" class="particle" style="animation-delay: 0s;" />
											<circle cx="350" cy="140" r="2" fill="#5eead4" class="particle" style="animation-delay: 1.5s;" />
											<circle cx="310" cy="150" r="1" fill="#8fa8ff" class="particle" style="animation-delay: 3s;" />
											<text x="30" y="135" font-size="90" font-weight="900" fill="url(#num-grad)" class="big-number">{String(i + 1).padStart(2, '0')}</text>
										</svg>
									)}
								</div>
								
								<div class="body">
									<div class="head">
										<h2>{p.title}</h2>
										{p.status && <span class="status">{p.status}</span>}
									</div>
									<p>{p.desc}</p>
									<div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
									<div class="links">
										{p.links.map((l) => (
											<a href={l.href} target="_blank" rel="noopener">{l.label} →</a>
										))}
									</div>
								</div>

								{/* 陨石砸落印章 */}
								{!p.video && !p.image && (
									<div class="seal-stamp-wrapper js-open-seal" title="点击全屏检视">
										<div class="seal-shockwave"></div>
										<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
											<defs>
												<linearGradient id="ink-gold-sm" x1="0%" y1="0%" x2="100%" y2="100%">
													<stop offset="0%" stop-color="#f2d780"/>
													<stop offset="50%" stop-color="#a67c00"/>
													<stop offset="100%" stop-color="#5c4300"/>
												</linearGradient>
												<path id="text-arc-sm" d="M 40, 100 A 60,60 0 1,1 160, 100" fill="none" />
												<filter id="rough-ink" x="-20%" y="-20%" width="140%" height="140%">
													<feTurbulence type="fractalNoise" baseFrequency="0.08" numOctaves="3" result="noise" />
													<feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
												</filter>
											</defs>
											<g filter="url(#rough-ink)">
												<circle cx="100" cy="100" r="85" fill="none" stroke="#9b111e" stroke-width="6" opacity="0.95"/>
												<circle cx="100" cy="100" r="75" fill="none" stroke="#9b111e" stroke-width="2" opacity="0.6"/>
												<text font-size="13" fill="#9b111e" font-family="Georgia, serif" letter-spacing="3" opacity="0.8">
													<textPath href="#text-arc-sm" startOffset="50%" text-anchor="middle">REOG • AUTHENTIC •</textPath>
												</text>
												<polygon points="100,30 115,85 170,100 115,115 100,170 85,115 30,100 85,85" fill="none" stroke="#9b111e" stroke-width="1.5" opacity="0.4"/>
												<text x="100" y="135" text-anchor="middle" font-size="80" font-weight="900" fill="url(#ink-gold-sm)" font-family="Georgia, 'Times New Roman', serif" stroke="#9b111e" stroke-width="2" paint-order="stroke fill">R</text>
											</g>
										</svg>
									</div>
								)}
							</div>
						);
					})
				}
				<div class="card soon">
					<div class="soon-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 5v14M5 12h14"/>
						</svg>
					</div>
					<b>下一个作品筹备中</b>
					<span>有新项目上线后会在这里更新</span>
				</div>
			</div>
		</main>
		<Footer />

		{/* =======================================
		    终极视觉核爆 Modal
		    ======================================= */}
		<div class="modal-overlay" id="seal-modal">
			
			<div class="modal-bg-energy"></div>
			<div class="modal-god-rays"></div>
			<div class="modal-shockwave-ring"></div>
			<div class="modal-lens-flare"></div>
			
			{/* 漫天飞散的超级粒子群 (使用内联样式随机化) */}
			<div class="modal-particle" style="width: 8px; height: 8px; --tx: -400px; --ty: -300px; top: 50%; left: 50%; animation-delay: 0.1s; --dur: 1.5s;"></div>
			<div class="modal-particle" style="width: 12px; height: 12px; --tx: 500px; --ty: -200px; top: 50%; left: 50%; animation-delay: 0.2s; background:#ffcc00; --dur: 2s;"></div>
			<div class="modal-particle" style="width: 5px; height: 5px; --tx: -600px; --ty: 400px; top: 50%; left: 50%; animation-delay: 0.15s; --dur: 1.8s;"></div>
			<div class="modal-particle" style="width: 15px; height: 15px; --tx: 300px; --ty: 500px; top: 50%; left: 50%; animation-delay: 0.3s; background:#ff2a40; --dur: 2.2s;"></div>
			<div class="modal-particle" style="width: 6px; height: 6px; --tx: 100px; --ty: -600px; top: 50%; left: 50%; animation-delay: 0.05s; background:#ffcc00; --dur: 1.6s;"></div>
			<div class="modal-particle" style="width: 10px; height: 10px; --tx: -300px; --ty: -500px; top: 50%; left: 50%; animation-delay: 0.4s; --dur: 2.5s;"></div>
			<div class="modal-particle" style="width: 4px; height: 4px; --tx: 600px; --ty: 300px; top: 50%; left: 50%; animation-delay: 0.25s; --dur: 1.2s;"></div>
			<div class="modal-particle" style="width: 9px; height: 9px; --tx: -500px; --ty: 100px; top: 50%; left: 50%; animation-delay: 0.35s; background:#ff2a40; --dur: 1.9s;"></div>

			<div class="modal-close-hint">[ 点击任意位置关闭 ]</div>

			{/* 巨型印章本体 */}
			<div class="modal-content">
				<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
					<defs>
						{/* 多层复杂渐变：模拟红宝石内部光源与外部金属 */}
						<radialGradient id="gem-core" cx="50%" cy="50%" r="50%">
							<stop offset="0%" stop-color="#ff4757" />
							<stop offset="20%" stop-color="#ff1a33" />
							<stop offset="60%" stop-color="#800a16" />
							<stop offset="90%" stop-color="#2b0003" />
							<stop offset="100%" stop-color="#000000" />
						</radialGradient>
						<linearGradient id="gold-metal" x1="0" y1="0" x2="1" y2="1">
							<stop offset="0%" stop-color="#fff5cc" />
							<stop offset="25%" stop-color="#d4af37" />
							<stop offset="50%" stop-color="#6b4c1c" />
							<stop offset="75%" stop-color="#d4af37" />
							<stop offset="100%" stop-color="#fff5cc" />
						</linearGradient>
						<path id="arc-lg" d="M 200, 20 A 180,180 0 1,1 199.9, 20" fill="none" />
						<filter id="glow">
							<feGaussianBlur stdDeviation="6" result="coloredBlur"/>
							<feMerge>
								<feMergeNode in="coloredBlur"/>
								<feMergeNode in="SourceGraphic"/>
							</feMerge>
						</filter>
					</defs>
					<g>
						{/* 外圈底座与刻度线 */}
						<circle cx="200" cy="200" r="195" fill="#030509" stroke="#22180a" stroke-width="8" />
						<circle cx="200" cy="200" r="175" fill="none" stroke="url(#gold-metal)" stroke-width="12" stroke-dasharray="4 18" opacity="0.7" />
						
						{/* 环形符文文字（高强度金光） */}
						<text font-size="22" fill="#d4af37" font-family="monospace" font-weight="900" letter-spacing="12" filter="drop-shadow(0 0 8px #ffcc00)">
							<textPath href="#arc-lg" startOffset="50%" text-anchor="middle">
								REOG • AUTHENTIC SEAL • EST. 2024 •
							</textPath>
						</text>

						{/* 内圈金属结构 */}
						<circle cx="200" cy="200" r="135" fill="none" stroke="url(#gold-metal)" stroke-width="8" filter="url(#glow)"/>
						<circle cx="200" cy="200" r="128" fill="none" stroke="#9b111e" stroke-width="3" />
						
						{/* 红宝石主体底盘（深渊底色） */}
						<circle cx="200" cy="200" r="120" fill="url(#gem-core)" />
						
						{/* 3D 切割面（多面体折射，重头戏） */}
						<g opacity="0.7">
							{/* 八边形主切割 */}
							<polygon points="200,80 290,140 290,260 200,320 110,260 110,140" fill="none" stroke="#ff6b81" stroke-width="3"/>
							{/* 内部高光切面（模拟光从左上角打入） */}
							<polygon points="200,80 290,140 200,200" fill="rgba(255,255,255,0.4)"/>
							<polygon points="200,80 110,140 200,200" fill="rgba(255,50,50,0.5)"/>
							{/* 底部暗部切面 */}
							<polygon points="200,320 290,260 200,200" fill="rgba(100,0,0,0.6)"/>
							<polygon points="200,320 110,260 200,200" fill="rgba(50,0,0,0.8)"/>
							{/* 侧面切面 */}
							<polygon points="290,140 290,260 200,200" fill="rgba(255,150,150,0.2)"/>
							<polygon points="110,140 110,260 200,200" fill="rgba(255,150,150,0.2)"/>
							{/* 内嵌菱形反光 */}
							<polygon points="200,110 260,200 200,290 140,200" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
						</g>
						
						{/* 顶部终极镜面高光 */}
						<circle cx="140" cy="140" r="60" fill="rgba(255,255,255,0.25)" filter="blur(20px)" />
						<circle cx="140" cy="140" r="20" fill="rgba(255,255,255,0.6)" filter="blur(5px)" />

						{/* 核心岩浆呼吸层 */}
						<circle cx="200" cy="200" r="120" fill="url(#gem-core)" opacity="0.8" class="gem-core-pulse" mix-blend-mode="screen" />
						
						{/* 超大浮雕 R 字母 */}
						<text x="200" y="265" text-anchor="middle" font-size="170" font-weight="900" fill="url(#gold-metal)" font-family="Georgia, 'Times New Roman', serif" 
							filter="drop-shadow(0px 15px 25px rgba(0,0,0,1)) drop-shadow(0px 0px 30px rgba(255,215,0,0.6))">
							R
						</text>

						{/* 极速旋转的光刃圈（4个不同速度的光弧） */}
						<g class="gold-blade">
							<circle cx="200" cy="200" r="175" fill="none" stroke="url(#gold-metal)" stroke-width="10" stroke-dasharray="120 800" stroke-linecap="round" />
							<circle cx="200" cy="200" r="175" fill="none" stroke="#ffffff" stroke-width="4" stroke-dasharray="30 890" stroke-linecap="round" opacity="0.9"/>
							<circle cx="200" cy="200" r="175" fill="none" stroke="#ff1a33" stroke-width="6" stroke-dasharray="200 800" stroke-linecap="round" opacity="0.5" transform="rotate(180 200 200)"/>
						</g>
					</g>
				</svg>
			</div>
		</div>

		<script>
			// ========================================================
			// 好莱坞级交互逻辑：全屏核爆效果触发与物理震颤模拟
			// ========================================================
			document.addEventListener('astro:page-load', () => {
				// 1. 视频播放逻辑
				const videos = document.querySelectorAll('.js-video');
				videos.forEach((video: any) => {
					video.playbackRate = 0.6; 
					video.play().catch((err: any) => console.log(err));
				});

				// 2. 触发器：卡片震颤效果
				// 当印章即将砸在卡片上的瞬间（1.3s 左右），触发整个卡片的物理震颤
				const cards = document.querySelectorAll('.card');
				cards.forEach(card => {
					setTimeout(() => {
						card.classList.add('shake');
					}, 1300);
				});

				// 3. Modal 弹窗逻辑（事件委托，保证 100% 触发）
				const modal = document.getElementById('seal-modal');
				
				if (modal) {
					document.body.addEventListener('click', (e) => {
						const target = e.target as HTMLElement;
						
						// 点击印章，激活核爆特效
						if (target.closest('.js-open-seal')) {
							modal.classList.add('active');
							document.body.style.overflow = 'hidden'; 
							
							// （可选）利用 Web Audio API 播放网页低音轰鸣声
							// 如果浏览器允许，此处可加入震撼音效
						}
						
						// 点击任意区域，关闭弹窗
						if (target === modal || target.closest('.modal-overlay')) {
							modal.classList.remove('active');
							document.body.style.overflow = '';
						}
					});
				}
			});
		</script>
	</body>
</html>
