---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// ===== 在这里添加你的作品，复制一段 { ... } 即可 =====
const projects = [
	{
		title: '本站：REOG 个人网站',
		desc: '基于 Astro 构建的中文个人博客，支持深色模式、站内搜索、标签分类、RSS 订阅与评论，通过 GitHub Actions 自动部署到 GitHub Pages。',
		tags: ['Astro', 'GitHub Actions', 'GitHub Pages', 'Giscus'],
		status: '运行中',
		// 留空即可显示震撼的 01 动态封面
		video: '',
		image: '', 
		links: [
			{ label: '访问网站', href: 'https://reog163.github.io' },
			{ label: '查看源码', href: 'https://github.com/REOG163/reog163.github.io' },
		],
	},
];
// ==================================================

const palettes = [
	['#14204a', '#3b5bdb', '#5eead4'],
	['#1d2f6b', '#7c5cff', '#8fa8ff'],
	['#0b3b4a', '#14b8a6', '#a7f3d0'],
];
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`作品集 | ${SITE_TITLE}`} description="我做过的项目与作品" />
		<style>
			/* 核心：定义 CSS Houdini 变量，让锥形渐变的角度可以动起来 */
			@property --angle {
				syntax: '<angle>';
				initial-value: 0deg;
				inherits: false;
			}

			main.pj {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 28px 18px 56px;
				box-sizing: border-box;
			}
			.label {
				margin: 0 0 4px;
				font-size: 13px;
				letter-spacing: 0.18em;
				font-weight: 600;
				color: var(--accent);
			}
			h1 {
				margin: 0 0 6px;
				font-size: 30px;
				color: rgb(var(--black));
			}
			.lead {
				margin: 0 0 24px;
				font-size: 16px;
				color: rgb(var(--gray));
			}
			
			.grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 18px;
			}

			.card {
				display: flex;
				flex-direction: column;
				overflow: hidden;
				border-radius: 14px;
				border: 1px solid rgba(var(--gray), 0.3);
				background: rgba(var(--gray-light), 0.35);
				position: relative;
				transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
				animation: cardIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
			}

			/* ================= 边缘流光特效 ================= */
			.card::before {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: 14px;
				padding: 1.5px; /* 控制光线的粗细 */
				/* 基础状态：暗色边缘 + 尾部流光 */
				background: conic-gradient(
					from var(--angle), 
					rgba(var(--gray), 0.2) 0%, 
					rgba(var(--gray), 0.2) 70%, 
					#5eead4 90%, 
					#8fa8ff 100%
				);
				-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
				-webkit-mask-composite: xor;
				mask-composite: exclude;
				pointer-events: none;
				animation: spin-edge 4s linear infinite;
				z-index: 5; /* 确保光效在内容最上层，但只有边框宽度 */
			}

			@keyframes spin-edge {
				to {
					--angle: 360deg;
				}
			}

			/* 深色模式下的基础流光 */
			:global(html[data-theme='dark']) .card::before {
				background: conic-gradient(
					from var(--angle), 
					rgba(38, 51, 92, 0.8) 0%, 
					rgba(38, 51, 92, 0.8) 70%, 
					#5eead4 90%, 
					#8fa8ff 100%
				);
			}

			/* 悬浮时：流光加速、变粗、色彩更亮 */
			.card:hover::before {
				padding: 2px;
				background: conic-gradient(
					from var(--angle), 
					transparent 40%, 
					#5eead4 70%, 
					#ffffff 85%, 
					#8fa8ff 100%
				);
				animation-duration: 1.5s;
			}
			/* ================================================= */

			@keyframes cardIn {
				from { opacity: 0; transform: translateY(30px) scale(0.98); }
				to { opacity: 1; transform: translateY(0) scale(1); }
			}

			.card:hover {
				transform: translateY(-6px);
				border-color: transparent; /* 悬浮时隐藏原本的边框，露出里面的流光 */
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.1);
			}
			:global(html[data-theme='dark']) .card:hover {
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.6), 0 0 24px rgba(94, 234, 212, 0.15);
			}

			/* 悬浮斜向高光扫光 */
			.card::after {
				content: '';
				position: absolute;
				top: 0; left: -150%;
				width: 50%; height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
				transform: skewX(-25deg);
				transition: left 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
				pointer-events: none;
				z-index: 10;
			}
			.card:hover::after {
				left: 150%;
			}
			:global(html[data-theme='dark']) .card::after {
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
			}

			/* 封面区域 */
			.cover-wrap {
				width: 100%;
				aspect-ratio: 2 / 1;
				overflow: hidden;
				background: #0b1020;
				position: relative;
			}
			.cover {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.card:hover .cover {
				transform: scale(1.03);
			}

			/* ================= 震撼科幻封面特效 ================= */
			.tech-bg {
				fill: url(#bg-grad);
			}
			.grid-lines {
				stroke: rgba(94, 234, 212, 0.15);
				stroke-width: 1;
			}
			.core-ring {
				transform-origin: 320px 100px;
			}
			.ring-fast { animation: spin 6s linear infinite; }
			.ring-reverse { animation: spin 12s linear infinite reverse; }
			.ring-slow { animation: spin 25s linear infinite; }
			@keyframes spin { 100% { transform: rotate(360deg); } }

			.scanner { animation: scan 4s ease-in-out infinite; }
			@keyframes scan {
				0%, 100% { transform: translateY(-40px); opacity: 0; }
				10%, 90% { opacity: 0.8; }
				50% { transform: translateY(40px); opacity: 1; }
			}

			.energy-pulse {
				transform-origin: 320px 100px;
				animation: pulse-ring 3s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
			}
			@keyframes pulse-ring {
				0% { transform: scale(0.6); opacity: 0.8; }
				100% { transform: scale(1.8); opacity: 0; }
			}

			.big-number {
				animation: number-breathe 3s ease-in-out infinite alternate;
				filter: drop-shadow(0 0 10px rgba(94, 234, 212, 0.8)) drop-shadow(0 0 20px rgba(94, 234, 212, 0.4));
				font-family: 'Impact', 'Arial Black', system-ui, sans-serif;
			}
			@keyframes number-breathe {
				0% { transform: scale(1); opacity: 0.85; }
				100% { transform: scale(1.05); opacity: 1; }
			}

			.particle { animation: float-up 5s linear infinite; }
			@keyframes float-up {
				0% { transform: translateY(0); opacity: 0; }
				20% { opacity: 1; }
				80% { opacity: 1; }
				100% { transform: translateY(-80px); opacity: 0; }
			}
			/* ==================================================== */

			.body {
				padding: 16px 18px 18px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				flex: 1;
			}
			.head {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 8px;
			}

			/* 黄金流光文字 */
			.card h2, .soon b {
				margin: 0;
				font-size: 19px;
				line-height: 1.4;
				font-weight: 800;
				letter-spacing: 0.5px;
				background: linear-gradient(135deg, #bf953f 0%, #fcf6ba 25%, #b38728 50%, #fbf5b7 75%, #aa771c 100%);
				background-size: 200% auto;
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
				animation: shine 4s linear infinite;
				filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2));
			}
			@keyframes shine { to { background-position: 200% center; } }

			/* 状态标签 */
			.status {
				flex: none;
				font-size: 12px;
				padding: 2px 10px;
				border-radius: 999px;
				background: rgba(94, 234, 212, 0.15);
				color: #0f9d8a;
				border: 1px solid rgba(94, 234, 212, 0.3);
				box-shadow: 0 0 10px rgba(94, 234, 212, 0.05);
				display: flex;
				align-items: center;
				gap: 6px;
				font-weight: 600;
				z-index: 6; /* 防止被流光遮挡 */
			}
			.status::before {
				content: '';
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #0f9d8a;
				box-shadow: 0 0 6px #0f9d8a;
				animation: blink 2s infinite ease-in-out;
			}
			@keyframes blink {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(0.8); }
			}
			:global(html[data-theme='dark']) .status { color: #5eead4; border-color: rgba(94, 234, 212, 0.4); }
			:global(html[data-theme='dark']) .status::before { background: #5eead4; box-shadow: 0 0 6px #5eead4; }

			.card p { margin: 0; font-size: 15px; line-height: 1.75; color: rgb(var(--gray-dark)); }
			.tags { display: flex; flex-wrap: wrap; gap: 6px; }
			.tags span {
				font-size: 12px;
				padding: 2px 10px;
				border-radius: 6px;
				background: rgba(var(--gray), 0.1);
				color: rgb(var(--gray-dark));
				transition: all 0.2s ease;
				border: 1px solid transparent;
			}
			.card:hover .tags span { background: rgba(var(--gray), 0.15); border-color: rgba(var(--gray), 0.3); }
			.links { display: flex; gap: 14px; margin-top: auto; padding-top: 10px; }
			.links a {
				font-size: 14px;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
				transition: opacity 0.2s;
				z-index: 6;
			}
			.links a:hover { opacity: 0.8; }

			/* 筹备中卡片 */
			.soon {
				align-items: center;
				justify-content: center;
				text-align: center;
				border-style: dashed;
				border-width: 2px;
				padding: 36px 20px;
				background: transparent;
				border-color: rgba(var(--gray), 0.4);
				transition: all 0.4s ease;
			}
			/* 筹备中卡片不需要动态流光，隐藏掉 */
			.soon::before {
				display: none;
			}
			.soon:hover { background: rgba(var(--gray-light), 0.2); border-color: rgba(94, 234, 212, 0.6); }
			:global(html[data-theme='dark']) .soon { border-color: #26335c; }
			:global(html[data-theme='dark']) .soon:hover {
				border-color: #5eead4;
				background: rgba(26, 36, 64, 0.6);
				box-shadow: 0 0 30px rgba(94, 234, 212, 0.08);
			}
			.soon-icon {
				margin-bottom: 12px;
				color: var(--accent);
				animation: float 3s ease-in-out infinite;
				display: flex;
				justify-content: center;
			}
			@keyframes float {
				0%, 100% { transform: translateY(0); }
				50% { transform: translateY(-8px); }
			}
			.soon span { font-size: 14px; color: rgb(var(--gray)); margin-top: 4px; }

			@media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
			:global(html[data-theme='dark']) .card { background: rgba(26, 36, 64, 0.95); border-color: #26335c; }

			@media (prefers-reduced-motion: reduce) {
				.cover-wrap video, .cover-wrap svg * { animation: none !important; }
				.card::before { animation: none !important; background: transparent !important; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="pj">
			<p class="label">PROJECTS · 作品集</p>
			<h1>我做过的东西</h1>
			<p class="lead">每个项目都是一次完整的实践：从想法到上线。</p>

			<div class="grid">
				{
					projects.map((p, i) => {
						const c = palettes[i % palettes.length];
						return (
							<div class="card" style={`animation-delay: ${i * 0.15}s;`}>
								<div class="cover-wrap">
									{p.video ? (
										<video 
											class="cover js-video" 
											src={p.video} 
											autoplay 
											muted 
											loop 
											playsinline
											preload="metadata"
										/>
									) : p.image ? (
										<img class="cover" src={p.image} alt={p.title} style="background: #0b1020;" />
									) : (
										<svg class="cover" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
											<defs>
												<radialGradient id="bg-grad" cx="80%" cy="50%" r="80%">
													<stop offset="0%" stop-color="#14204a" />
													<stop offset="100%" stop-color="#0b1020" />
												</radialGradient>
												<linearGradient id="num-grad" x1="0" y1="0" x2="1" y2="1">
													<stop offset="0%" stop-color="#ffffff" />
													<stop offset="100%" stop-color="#5eead4" />
												</linearGradient>
												<linearGradient id="scan-grad" x1="0" y1="0" x2="0" y2="1">
													<stop offset="0%" stop-color="rgba(94, 234, 212, 0)" />
													<stop offset="50%" stop-color="rgba(94, 234, 212, 0.5)" />
													<stop offset="100%" stop-color="rgba(94, 234, 212, 0)" />
												</linearGradient>
											</defs>
											
											<rect width="400" height="200" class="tech-bg" />
											
											<g class="grid-lines">
												<line x1="0" y1="50" x2="400" y2="50" />
												<line x1="0" y1="100" x2="400" y2="100" />
												<line x1="0" y1="150" x2="400" y2="150" />
												<line x1="50" y1="0" x2="50" y2="200" />
												<line x1="150" y1="0" x2="150" y2="200" />
												<line x1="250" y1="0" x2="250" y2="200" />
												<line x1="350" y1="0" x2="350" y2="200" />
											</g>

											<circle cx="320" cy="100" r="70" fill="none" stroke="rgba(94, 234, 212, 0.2)" stroke-width="1" />
											<circle cx="320" cy="100" r="40" fill="none" stroke="#5eead4" stroke-width="2" class="energy-pulse" />

											<g class="core-ring ring-slow">
												<circle cx="320" cy="100" r="85" fill="none" stroke="rgba(94, 234, 212, 0.3)" stroke-width="4" stroke-dasharray="2 10" />
											</g>
											<g class="core-ring ring-reverse">
												<circle cx="320" cy="100" r="65" fill="none" stroke="#8fa8ff" stroke-width="1.5" stroke-dasharray="15 5" />
												<circle cx="320" cy="35" r="4" fill="#8fa8ff" filter="drop-shadow(0 0 6px #8fa8ff)" />
											</g>
											<g class="core-ring ring-fast">
												<circle cx="320" cy="100" r="50" fill="none" stroke="#5eead4" stroke-width="1" />
												<circle cx="270" cy="100" r="3" fill="#5eead4" filter="drop-shadow(0 0 8px #5eead4)" />
											</g>

											<rect x="250" y="60" width="140" height="4" fill="url(#scan-grad)" class="scanner" />

											<circle cx="280" cy="130" r="1.5" fill="#fff" class="particle" style="animation-delay: 0s;" />
											<circle cx="350" cy="140" r="2" fill="#5eead4" class="particle" style="animation-delay: 1.5s;" />
											<circle cx="310" cy="150" r="1" fill="#8fa8ff" class="particle" style="animation-delay: 3s;" />

											<text x="30" y="135" font-size="90" font-weight="900" fill="url(#num-grad)" class="big-number">
												{String(i + 1).padStart(2, '0')}
											</text>
										</svg>
									)}
								</div>
								<div class="body">
									<div class="head">
										<h2>{p.title}</h2>
										{p.status && <span class="status">{p.status}</span>}
									</div>
									<p>{p.desc}</p>
									<div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
									<div class="links">
										{p.links.map((l) => (
											<a href={l.href} target="_blank" rel="noopener">{l.label} →</a>
										))}
									</div>
								</div>
							</div>
						);
					})
				}
				<div class="card soon" style="animation-delay: 0.4s;">
					<div class="soon-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 5v14M5 12h14"/>
						</svg>
					</div>
					<b>下一个作品筹备中</b>
					<span>有新项目上线后会在这里更新</span>
				</div>
			</div>
		</main>
		<Footer />

		<!-- 强制视频播放 & 降速的兜底脚本 -->
		<script>
			document.addEventListener('astro:page-load', () => {
				const videos = document.querySelectorAll('.js-video');
				videos.forEach((video: any) => {
					video.playbackRate = 0.6; 
					const playPromise = video.play();
					if (playPromise !== undefined) {
						playPromise.catch((error: any) => {
							console.log('浏览器拦截了自动播放:', error);
						});
					}
				});
			});
		</script>
	</body>
</html>
