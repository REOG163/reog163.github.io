---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// ===== 在这里添加你的作品，复制一段 { ... } 即可 =====
const projects = [
	{
		title: '本站：REOG 个人网站',
		desc: '基于 Astro 构建的中文个人博客，支持深色模式、站内搜索、标签分类、RSS 订阅与评论，通过 GitHub Actions 自动部署到 GitHub Pages。',
		tags: ['Astro', 'GitHub Actions', 'GitHub Pages', 'Giscus'],
		status: '运行中',
		video: '',
		image: '', 
		links: [
			{ label: '访问网站', href: 'https://reog163.github.io' },
			{ label: '查看源码', href: 'https://github.com/REOG163/reog163.github.io' },
		],
	},
];
// ==================================================

const palettes = [
	['#14204a', '#3b5bdb', '#5eead4'],
	['#1d2f6b', '#7c5cff', '#8fa8ff'],
	['#0b3b4a', '#14b8a6', '#a7f3d0'],
];
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`作品集 | ${SITE_TITLE}`} description="我做过的项目与作品" />
		<style>
			@property --angle {
				syntax: '<angle>';
				initial-value: 0deg;
				inherits: false;
			}

			main.pj {
				width: 100%; max-width: 960px; margin: 0 auto; padding: 28px 18px 56px; box-sizing: border-box;
			}
			.label { margin: 0 0 4px; font-size: 13px; letter-spacing: 0.18em; font-weight: 600; color: var(--accent); }
			h1 { margin: 0 0 6px; font-size: 30px; color: rgb(var(--black)); }
			.lead { margin: 0 0 24px; font-size: 16px; color: rgb(var(--gray)); }
			
			.grid { display: grid; grid-template-columns: 1fr; gap: 18px; }

			.card {
				display: flex; flex-direction: column; overflow: hidden; border-radius: 14px;
				border: 1px solid rgba(var(--gray), 0.3); background: rgba(var(--gray-light), 0.35);
				position: relative; transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
				animation: cardIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
			}

			@keyframes cardIn {
				from { opacity: 0; transform: translateY(30px) scale(0.98); }
				to { opacity: 1; transform: translateY(0) scale(1); }
			}

			.card:hover {
				transform: translateY(-6px); border-color: rgba(var(--gray), 0.5);
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.2);
			}
			:global(html[data-theme='dark']) .card:hover {
				box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.6); border-color: #4a5a85;
			}

			/* 封面区域 */
			.cover-wrap {
				width: 100%; aspect-ratio: 2 / 1; overflow: hidden; background: #0b1020; position: relative;
			}
			.cover { display: block; width: 100%; height: 100%; object-fit: cover; }

			/* 01 动效 */
			.tech-bg { fill: url(#bg-grad); }
			.grid-lines { stroke: rgba(94, 234, 212, 0.15); stroke-width: 1; }
			.core-ring { transform-origin: 320px 100px; }
			.ring-fast { animation: spin 6s linear infinite; }
			.ring-reverse { animation: spin 12s linear infinite reverse; }
			.ring-slow { animation: spin 25s linear infinite; }
			@keyframes spin { 100% { transform: rotate(360deg); } }
			.scanner { animation: scan 4s ease-in-out infinite; }
			@keyframes scan { 0%, 100% { transform: translateY(-40px); opacity: 0; } 10%, 90% { opacity: 0.8; } 50% { transform: translateY(40px); opacity: 1; } }
			.energy-pulse { transform-origin: 320px 100px; animation: pulse-ring 3s cubic-bezier(0.2, 0.8, 0.2, 1) infinite; }
			@keyframes pulse-ring { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.8); opacity: 0; } }
			.big-number { animation: number-breathe 3s ease-in-out infinite alternate; filter: drop-shadow(0 0 10px rgba(94, 234, 212, 0.8)); font-family: 'Impact', 'Arial Black', system-ui, sans-serif; }
			@keyframes number-breathe { 0% { transform: scale(1); opacity: 0.85; } 100% { transform: scale(1.05); opacity: 1; } }
			.particle { animation: float-up 5s linear infinite; }
			@keyframes float-up { 0% { transform: translateY(0); opacity: 0; } 20% { opacity: 1; } 80% { opacity: 1; } 100% { transform: translateY(-80px); opacity: 0; } }

			/* ================= 卡片右下角：陨石砸落印章 ================= */
			.seal-stamp-wrapper {
				position: absolute; bottom: 15px; right: 18px; width: 95px; height: 95px; z-index: 50;
				cursor: pointer; pointer-events: auto !important; 
				animation: stamp-slam 1s cubic-bezier(0.1, 1.5, 0.3, 1) 0.8s backwards; /* 极速砸下 */
				transition: transform 0.3s ease, filter 0.3s ease;
			}
			.seal-stamp-wrapper:hover {
				transform: scale(1.1) rotate(-3deg); filter: brightness(1.2) drop-shadow(0 0 15px rgba(255, 50, 50, 0.6));
			}

			/* 冲击波圆环 */
			.seal-shockwave {
				position: absolute; inset: 0; border-radius: 50%;
				border: 3px solid rgba(200, 30, 30, 0.8); box-shadow: 0 0 20px rgba(200, 30, 30, 0.6);
				animation: shockwave 1s cubic-bezier(0.1, 0.8, 0.3, 1) 1.5s backwards; opacity: 0; pointer-events: none;
			}

			/* 砸落动作，伴随震颤和模糊 */
			@keyframes stamp-slam {
				0% { transform: scale(4) translateY(-150px) rotate(-25deg); opacity: 0; filter: blur(10px); }
				40% { transform: scale(0.85) translateY(10px) rotate(5deg); opacity: 1; filter: blur(0); }
				50% { transform: scale(1.05) translateY(-5px) rotate(-2deg); } /* 弹起震颤 */
				65% { transform: scale(0.98) translateY(2px) rotate(1deg); }
				80% { transform: scale(1.02) translateY(-1px) rotate(0deg); }
				100% { transform: scale(1) translateY(0) rotate(0deg); opacity: 1; }
			}
			@keyframes shockwave {
				0% { transform: scale(0.5); opacity: 1; }
				100% { transform: scale(2.5); opacity: 0; border-width: 1px; }
			}

			.seal-stamp-wrapper svg {
				width: 100%; height: 100%; pointer-events: none;
				filter: drop-shadow(0 6px 12px rgba(0,0,0,0.9)) drop-shadow(0 0 3px rgba(200, 30, 30, 0.5));
			}

			/* 内容区，底部加 Padding 防止文字被印章遮挡 */
			.body { padding: 16px 18px 85px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
			.head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }

			/* 黄金流光文字 */
			.card h2, .soon b {
				margin: 0; font-size: 19px; line-height: 1.4; font-weight: 800; letter-spacing: 0.5px;
				background: linear-gradient(135deg, #bf953f 0%, #fcf6ba 25%, #b38728 50%, #fbf5b7 75%, #aa771c 100%);
				background-size: 200% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
				animation: shine 4s linear infinite; filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2));
			}
			@keyframes shine { to { background-position: 200% center; } }

			/* 状态标签 */
			.status {
				flex: none; font-size: 12px; padding: 2px 10px; border-radius: 999px;
				background: rgba(94, 234, 212, 0.15); color: #0f9d8a; border: 1px solid rgba(94, 234, 212, 0.3);
				display: flex; align-items: center; gap: 6px; font-weight: 600;
			}
			.status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #0f9d8a; box-shadow: 0 0 6px #0f9d8a; animation: blink 2s infinite ease-in-out; }
			@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
			:global(html[data-theme='dark']) .status { color: #5eead4; border-color: rgba(94, 234, 212, 0.4); }
			:global(html[data-theme='dark']) .status::before { background: #5eead4; box-shadow: 0 0 6px #5eead4; }

			.card p { margin: 0; font-size: 15px; line-height: 1.75; color: rgb(var(--gray-dark)); }
			.tags { display: flex; flex-wrap: wrap; gap: 6px; }
			.tags span { font-size: 12px; padding: 2px 10px; border-radius: 6px; background: rgba(var(--gray), 0.1); color: rgb(var(--gray-dark)); }
			.links { display: flex; gap: 14px; margin-top: 10px; }
			.links a { font-size: 14px; font-weight: 600; color: var(--accent); text-decoration: none; }
			.links a:hover { opacity: 0.8; }

			/* 筹备中卡片 */
			.soon {
				align-items: center; justify-content: center; text-align: center;
				border-style: dashed; border-width: 2px; padding: 36px 20px; background: transparent; border-color: rgba(var(--gray), 0.4);
			}
			.soon:hover { background: rgba(var(--gray-light), 0.2); border-color: rgba(94, 234, 212, 0.6); }
			:global(html[data-theme='dark']) .soon { border-color: #26335c; }
			:global(html[data-theme='dark']) .soon:hover { border-color: #5eead4; background: rgba(26, 36, 64, 0.6); }
			.soon-icon { margin-bottom: 12px; color: var(--accent); animation: float 3s ease-in-out infinite; display: flex; justify-content: center; }
			@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
			.soon span { font-size: 14px; color: rgb(var(--gray)); margin-top: 4px; }

			@media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
			:global(html[data-theme='dark']) .card { background: rgba(26, 36, 64, 0.95); border-color: #26335c; }

			/* ================= 好莱坞大片级 全屏检视 Modal ================= */
			.modal-overlay {
				position: fixed; inset: 0; background: rgba(0, 0, 0, 0.98);
				z-index: 99999; display: flex; align-items: center; justify-content: center;
				opacity: 0; visibility: hidden; transition: all 0.4s ease;
				perspective: 1500px; overflow: hidden;
			}
			.modal-overlay.active { opacity: 1; visibility: visible; }

			/* 1. 暗场能量底纹 (极光与网格脉冲) */
			.modal-bg-energy {
				position: absolute; inset: 0;
				background: 
					radial-gradient(circle at center, rgba(155, 17, 30, 0.15) 0%, transparent 60%),
					linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
				background-size: 100% 100%, 40px 40px, 40px 40px;
				opacity: 0; transition: opacity 0.5s ease;
			}
			.modal-overlay.active .modal-bg-energy { opacity: 1; animation: grid-pulse 3s infinite alternate; }
			@keyframes grid-pulse { from { background-size: 100% 100%, 40px 40px, 40px 40px; } to { background-size: 100% 100%, 45px 45px, 45px 45px; } }

			/* 2. 超级星爆射线 (Hollywood God Rays) */
			.modal-god-rays {
				position: absolute; width: 300vw; height: 300vw; top: 50%; left: 50%;
				transform: translate(-50%, -50%) scale(0); z-index: 1; opacity: 0;
				background: repeating-conic-gradient(
					from 0deg,
					rgba(255, 50, 50, 0.15) 0deg 3deg,
					transparent 3deg 15deg
				);
				mask-image: radial-gradient(circle, black 10%, transparent 60%);
				-webkit-mask-image: radial-gradient(circle, black 10%, transparent 60%);
			}
			.modal-overlay.active .modal-god-rays {
				animation: rays-burst 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards, spin-slow 30s linear infinite;
			}
			@keyframes rays-burst { 0% { transform: translate(-50%, -50%) scale(0); opacity: 0; } 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
			@keyframes spin-slow { 100% { transform: translate(-50%, -50%) rotate(360deg); } }

			/* 3. 中心印章主体 (陨石降落 -> 3D 悬浮) */
			.modal-content {
				width: 85vw; height: 85vw; max-width: 650px; max-height: 650px; position: relative; z-index: 10;
				/* 初始在极远处，翻滚，并且极度模糊（动感模糊） */
				transform: scale(0.05) rotateZ(180deg) rotateX(80deg) translateZ(-1000px);
				opacity: 0; filter: blur(20px);
				transition: all 1s cubic-bezier(0.16, 1, 0.3, 1); /* 极具冲击力的弹簧曲线 */
			}
			.modal-overlay.active .modal-content {
				/* 轰到眼前，视角微调，归位 */
				transform: scale(1) rotateZ(0deg) rotateX(10deg) rotateY(-10deg) translateZ(0);
				opacity: 1; filter: blur(0);
				animation: hover-3d 6s ease-in-out infinite alternate 1s; /* 悬浮动效延迟1秒接入 */
			}
			
			@keyframes hover-3d {
				0% { transform: scale(1) rotateX(10deg) rotateY(-10deg) translateY(0); }
				100% { transform: scale(1.02) rotateX(15deg) rotateY(15deg) translateY(-20px); }
			}

			/* 4. 镜头光晕映射 (Lens Flare) */
			.modal-lens-flare {
				position: absolute; inset: -50px; z-index: 5; pointer-events: none;
				background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.8) 0%, transparent 10%),
							linear-gradient(45deg, transparent 40%, rgba(255, 200, 100, 0.2) 50%, transparent 60%);
				mix-blend-mode: screen; opacity: 0;
			}
			.modal-overlay.active .modal-lens-flare { animation: flare-flash 1s ease-out 0.4s forwards; }
			@keyframes flare-flash { 0% { opacity: 0; transform: scale(0.8); } 20% { opacity: 1; transform: scale(1.1); } 100% { opacity: 0.6; transform: scale(1); } }

			/* 5. 环形冲击波 (站在大招上的视觉) */
			.modal-shockwave-ring {
				position: absolute; top: 50%; left: 50%; width: 10px; height: 10px;
				border-radius: 50%; border: 4px solid rgba(255, 50, 50, 0.8); z-index: 2;
				transform: translate(-50%, -50%) scale(0); opacity: 0;
			}
			.modal-overlay.active .modal-shockwave-ring {
				animation: mega-shockwave 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) 0.2s forwards;
			}
			@keyframes mega-shockwave {
				0% { transform: translate(-50%, -50%) scale(0); opacity: 1; border-width: 20px; box-shadow: 0 0 100px #ff0000; }
				100% { transform: translate(-50%, -50%) scale(80); opacity: 0; border-width: 1px; box-shadow: 0 0 200px transparent; }
			}

			/* 浮游粒子群 */
			.modal-particle {
				position: absolute; background: #fff; border-radius: 50%; pointer-events: none; z-index: 3;
				box-shadow: 0 0 10px #fff, 0 0 20px #ff2a40; opacity: 0;
			}
			.modal-overlay.active .modal-particle { animation: particle-fly 1.5s ease-out forwards; }
			@keyframes particle-fly {
				0% { transform: translate(0, 0) scale(1); opacity: 1; }
				100% { transform: translate(var(--tx), var(--ty)) scale(0); opacity: 0; }
			}

			/* SVG 内部光效增强 */
			.modal-content svg {
				width: 100%; height: 100%;
				filter: drop-shadow(0 30px 60px rgba(200, 0, 0, 0.8)) drop-shadow(0 0 150px rgba(255, 50, 50, 0.4));
			}
			.gold-flow { animation: spin 6s linear infinite; transform-origin: 200px 200px; }
			.gem-lava { animation: lava-breathe 2s ease-in-out infinite alternate; }
			@keyframes lava-breathe {
				0% { opacity: 0.4; filter: drop-shadow(0 0 20px rgba(255, 0, 0, 0.8)); }
				100% { opacity: 1; filter: drop-shadow(0 0 50px rgba(255, 100, 100, 1)); }
			}

			/* 右上角关闭提示 */
			.modal-close-hint {
				position: absolute; top: 40px; right: 40px; font-size: 14px; color: rgba(255,255,255,0.4);
				letter-spacing: 2px; font-family: monospace; z-index: 20; opacity: 0; transition: opacity 0.5s;
				cursor: pointer;
			}
			.modal-overlay.active .modal-close-hint { opacity: 1; transition-delay: 1.5s; }
			.modal-close-hint:hover { color: #fff; }
		</style>
	</head>
	<body>
		<Header />
		<main class="pj">
			<p class="label">PROJECTS · 作品集</p>
			<h1>我做过的东西</h1>
			<p class="lead">每个项目都是一次完整的实践：从想法到上线。</p>

			<div class="grid">
				{
					projects.map((p, i) => {
						const c = palettes[i % palettes.length];
						return (
							<div class="card" style={`animation-delay: ${i * 0.15}s;`}>
								
								<div class="cover-wrap">
									{p.video ? (
										<video class="cover js-video" src={p.video} autoplay muted loop playsinline preload="metadata" />
									) : p.image ? (
										<img class="cover" src={p.image} alt={p.title} style="background: #0b1020;" />
									) : (
										<svg class="cover" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
											<defs>
												<radialGradient id="bg-grad" cx="80%" cy="50%" r="80%">
													<stop offset="0%" stop-color="#14204a" />
													<stop offset="100%" stop-color="#0b1020" />
												</radialGradient>
												<linearGradient id="num-grad" x1="0" y1="0" x2="1" y2="1">
													<stop offset="0%" stop-color="#ffffff" />
													<stop offset="100%" stop-color="#5eead4" />
												</linearGradient>
												<linearGradient id="scan-grad" x1="0" y1="0" x2="0" y2="1">
													<stop offset="0%" stop-color="rgba(94, 234, 212, 0)" />
													<stop offset="50%" stop-color="rgba(94, 234, 212, 0.5)" />
													<stop offset="100%" stop-color="rgba(94, 234, 212, 0)" />
												</linearGradient>
											</defs>
											<rect width="400" height="200" class="tech-bg" />
											<g class="grid-lines">
												<line x1="0" y1="50" x2="400" y2="50" />
												<line x1="0" y1="100" x2="400" y2="100" />
												<line x1="0" y1="150" x2="400" y2="150" />
												<line x1="50" y1="0" x2="50" y2="200" />
												<line x1="150" y1="0" x2="150" y2="200" />
												<line x1="250" y1="0" x2="250" y2="200" />
												<line x1="350" y1="0" x2="350" y2="200" />
											</g>
											<circle cx="320" cy="100" r="70" fill="none" stroke="rgba(94, 234, 212, 0.2)" stroke-width="1" />
											<circle cx="320" cy="100" r="40" fill="none" stroke="#5eead4" stroke-width="2" class="energy-pulse" />
											<g class="core-ring ring-slow"><circle cx="320" cy="100" r="85" fill="none" stroke="rgba(94, 234, 212, 0.3)" stroke-width="4" stroke-dasharray="2 10" /></g>
											<g class="core-ring ring-reverse"><circle cx="320" cy="100" r="65" fill="none" stroke="#8fa8ff" stroke-width="1.5" stroke-dasharray="15 5" /><circle cx="320" cy="35" r="4" fill="#8fa8ff" filter="drop-shadow(0 0 6px #8fa8ff)" /></g>
											<g class="core-ring ring-fast"><circle cx="320" cy="100" r="50" fill="none" stroke="#5eead4" stroke-width="1" /><circle cx="270" cy="100" r="3" fill="#5eead4" filter="drop-shadow(0 0 8px #5eead4)" /></g>
											<rect x="250" y="60" width="140" height="4" fill="url(#scan-grad)" class="scanner" />
											<circle cx="280" cy="130" r="1.5" fill="#fff" class="particle" style="animation-delay: 0s;" />
											<circle cx="350" cy="140" r="2" fill="#5eead4" class="particle" style="animation-delay: 1.5s;" />
											<circle cx="310" cy="150" r="1" fill="#8fa8ff" class="particle" style="animation-delay: 3s;" />
											<text x="30" y="135" font-size="90" font-weight="900" fill="url(#num-grad)" class="big-number">{String(i + 1).padStart(2, '0')}</text>
										</svg>
									)}
								</div>
								
								<div class="body">
									<div class="head">
										<h2>{p.title}</h2>
										{p.status && <span class="status">{p.status}</span>}
									</div>
									<p>{p.desc}</p>
									<div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
									<div class="links">
										{p.links.map((l) => (
											<a href={l.href} target="_blank" rel="noopener">{l.label} →</a>
										))}
									</div>
								</div>

								{/* 卡片右下角的真实印章（带砸落冲击波） */}
								{!p.video && !p.image && (
									<div class="seal-stamp-wrapper js-open-seal" title="点击全屏检视">
										<div class="seal-shockwave"></div>
										<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
											<defs>
												<linearGradient id="ink-gold-sm" x1="0%" y1="0%" x2="100%" y2="100%">
													<stop offset="0%" stop-color="#f2d780"/>
													<stop offset="50%" stop-color="#a67c00"/>
													<stop offset="100%" stop-color="#5c4300"/>
												</linearGradient>
												<path id="text-arc-sm" d="M 40, 100 A 60,60 0 1,1 160, 100" fill="none" />
											</defs>
											<circle cx="100" cy="100" r="85" fill="none" stroke="#9b111e" stroke-width="5" opacity="0.9"/>
											<circle cx="100" cy="100" r="76" fill="none" stroke="#9b111e" stroke-width="2" opacity="0.5"/>
											<text font-size="13" fill="#9b111e" font-family="Georgia, serif" letter-spacing="3" opacity="0.8">
												<textPath href="#text-arc-sm" startOffset="50%" text-anchor="middle">REOG • AUTHENTIC •</textPath>
											</text>
											<polygon points="100,30 115,85 170,100 115,115 100,170 85,115 30,100 85,85" fill="none" stroke="#9b111e" stroke-width="1.5" opacity="0.3"/>
											<text x="100" y="135" text-anchor="middle" font-size="80" font-weight="900" fill="url(#ink-gold-sm)" font-family="Georgia, 'Times New Roman', serif" stroke="#9b111e" stroke-width="2" paint-order="stroke fill">R</text>
										</svg>
									</div>
								)}
							</div>
						);
					})
				}
				<div class="card soon" style="animation-delay: 0.4s;">
					<div class="soon-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 5v14M5 12h14"/>
						</svg>
					</div>
					<b>下一个作品筹备中</b>
					<span>有新项目上线后会在这里更新</span>
				</div>
			</div>
		</main>
		<Footer />

		{/* ================= 核爆级全屏检视 Modal ================= */}
		<div class="modal-overlay" id="seal-modal">
			
			<!-- 能量网格底纹 -->
			<div class="modal-bg-energy"></div>
			<!-- 放射性神光 -->
			<div class="modal-god-rays"></div>
			<!-- 镜头光晕 -->
			<div class="modal-lens-flare"></div>
			<!-- 巨型冲击波 -->
			<div class="modal-shockwave-ring"></div>
			
			<!-- 飘散的火星粒子群 -->
			<div class="modal-particle" style="width: 4px; height: 4px; --tx: -200px; --ty: -200px; top: 50%; left: 50%; animation-delay: 0.2s;"></div>
			<div class="modal-particle" style="width: 6px; height: 6px; --tx: 300px; --ty: -150px; top: 50%; left: 50%; animation-delay: 0.3s; background:#ffcc00;"></div>
			<div class="modal-particle" style="width: 3px; height: 3px; --tx: -350px; --ty: 200px; top: 50%; left: 50%; animation-delay: 0.1s;"></div>
			<div class="modal-particle" style="width: 5px; height: 5px; --tx: 250px; --ty: 250px; top: 50%; left: 50%; animation-delay: 0.4s; background:#ff2a40;"></div>
			<div class="modal-particle" style="width: 8px; height: 8px; --tx: 0px; --ty: 350px; top: 50%; left: 50%; animation-delay: 0.2s; background:#ffcc00;"></div>

			<div class="modal-close-hint">[ 点击任意位置关闭 ]</div>

			<!-- 本体：巨型红宝石印章 -->
			<div class="modal-content">
				<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<radialGradient id="gem-base-lg" cx="50%" cy="50%" r="50%">
							<stop offset="0%" stop-color="#ff1a33" />
							<stop offset="30%" stop-color="#9b111e" />
							<stop offset="70%" stop-color="#3a0006" />
							<stop offset="100%" stop-color="#050001" />
						</radialGradient>
						<linearGradient id="gold-ring-lg" x1="0" y1="0" x2="1" y2="1">
							<stop offset="0%" stop-color="#fff5cc" />
							<stop offset="20%" stop-color="#d4af37" />
							<stop offset="50%" stop-color="#5c3a0b" />
							<stop offset="80%" stop-color="#d4af37" />
							<stop offset="100%" stop-color="#fff5cc" />
						</linearGradient>
						<path id="arc-lg" d="M 200, 20 A 180,180 0 1,1 199.9, 20" fill="none" />
					</defs>
					<g>
						{/* 外圈黑金底座与刻度 */}
						<circle cx="200" cy="200" r="195" fill="#05080f" stroke="#33250c" stroke-width="6" />
						<circle cx="200" cy="200" r="175" fill="none" stroke="#bf953f" stroke-width="10" stroke-dasharray="4 15" opacity="0.6" />
						
						{/* 环形文字（发金光） */}
						<text font-size="22" fill="#d4af37" font-family="monospace" font-weight="900" letter-spacing="10" filter="drop-shadow(0 0 5px #d4af37)">
							<textPath href="#arc-lg" startOffset="50%" text-anchor="middle">
								REOG • AUTHENTIC SEAL • EST. 2024 •
							</textPath>
						</text>

						{/* 内圈金环 */}
						<circle cx="200" cy="200" r="135" fill="none" stroke="url(#gold-ring-lg)" stroke-width="6" />
						<circle cx="200" cy="200" r="128" fill="none" stroke="#9b111e" stroke-width="2" />
						
						{/* 核心红宝石圆盘 */}
						<circle cx="200" cy="200" r="120" fill="url(#gem-base-lg)" />
						
						{/* 宝石内部复杂切割面（折射质感） */}
						<g opacity="0.6">
							<polygon points="200,80 290,140 290,260 200,320 110,260 110,140" fill="none" stroke="#ff4d4d" stroke-width="3"/>
							<polygon points="200,80 290,140 200,200" fill="rgba(255,255,255,0.3)"/>
							<polygon points="200,80 110,140 200,200" fill="rgba(255,50,50,0.4)"/>
							<polygon points="200,320 290,260 200,200" fill="rgba(255,255,255,0.1)"/>
							<polygon points="200,320 110,260 200,200" fill="rgba(255,50,50,0.2)"/>
							<polygon points="290,140 290,260 200,200" fill="rgba(255,150,150,0.15)"/>
							<polygon points="110,140 110,260 200,200" fill="rgba(255,150,150,0.15)"/>
						</g>
						
						{/* 顶部高光点 */}
						<circle cx="150" cy="150" r="50" fill="rgba(255,255,255,0.2)" filter="blur(15px)" />

						{/* 岩浆流动呼吸光晕（核心） */}
						<circle cx="200" cy="200" r="120" fill="url(#gem-base-lg)" opacity="0.8" class="gem-lava" mix-blend-mode="screen" />
						
						{/* 超大 R 文字（浮雕+阴影） */}
						<text x="200" y="260" text-anchor="middle" font-size="160" font-weight="900" fill="url(#gold-ring-lg)" font-family="Georgia, 'Times New Roman', serif" filter="drop-shadow(0px 15px 30px rgba(0,0,0,1)) drop-shadow(0px 0px 20px rgba(255,215,0,0.4))">
							R
						</text>

						{/* 极速旋转的光刃 / 光环 */}
						<g class="gold-flow">
							<circle cx="200" cy="200" r="175" fill="none" stroke="url(#gold-ring-lg)" stroke-width="8" stroke-dasharray="150 1000" stroke-linecap="round" />
							<circle cx="200" cy="200" r="175" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="50 1100" stroke-linecap="round" opacity="0.8"/>
						</g>
					</g>
				</svg>
			</div>
		</div>

		<script>
			document.addEventListener('astro:page-load', () => {
				const videos = document.querySelectorAll('.js-video');
				videos.forEach((video: any) => {
					video.playbackRate = 0.6; 
					video.play().catch((err: any) => console.log(err));
				});
			});

			// 使用事件委托，确保 100% 点击触发，且不受页面切换影响
			const modal = document.getElementById('seal-modal');
			
			if (modal) {
				document.body.addEventListener('click', (e) => {
					const target = e.target as HTMLElement;
					
					// 点击印章打开
					if (target.closest('.js-open-seal')) {
						modal.classList.add('active');
						document.body.style.overflow = 'hidden'; 
					}
					
					// 点击任意位置（包括弹窗本身）关闭
					if (target === modal || target.closest('.modal-overlay')) {
						modal.classList.remove('active');
						document.body.style.overflow = '';
					}
				});
			}
		</script>
	</body>
</html>
