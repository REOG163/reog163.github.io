---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function countChars(body: string) {
  const text = body || '';
  const zh = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
  const en = (text.replace(/[\u4e00-\u9fa5]/g, ' ').match(/[A-Za-z0-9]+/g) || []).length;
  return zh + en;
}

const rows = posts.map((p) => {
  const body = (p as any).body ?? '';
  const chars = countChars(body);
  const day = p.data.pubDate.toISOString().slice(0, 10);
  return {
    title: p.data.title,
    slug: (p as any).slug ?? p.id,
    day,
    chars,
    tags: p.data.tags ?? [],
    category: p.data.category ?? '',
  };
});

const totalPosts = rows.length;
const totalChars = rows.reduce((s, r) => s + r.chars, 0);
const tagMap = new Map<string, number>();
for (const r of rows) {
  for (const t of r.tags) tagMap.set(t, (tagMap.get(t) || 0) + 1);
}
const topTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

const weeks = 16;
const today = new Date();
today.setHours(0, 0, 0, 0);
const dayCount = new Map<string, number>();
for (const r of rows) {
  dayCount.set(r.day, (dayCount.get(r.day) || 0) + 1);
}
const cells: { date: string; count: number }[] = [];
const start = new Date(today);
start.setDate(start.getDate() - (weeks * 7 - 1));
for (let d = new Date(start); d <= today; d.setDate(d.getDate() + 1)) {
  const key = d.toISOString().slice(0, 10);
  cells.push({ date: key, count: dayCount.get(key) || 0 });
}

const thisYear = today.getFullYear();
const yearPosts = rows.filter((r) => r.day.startsWith(String(thisYear))).length;

const title = `写作仪表盘 · ${SITE_TITLE}`;
const description = '字数、标签分布与写作日历。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main.stats {
        max-width: 860px;
        margin: 0 auto;
        padding: 48px 20px 64px;
        box-sizing: border-box;
        overflow-x: hidden;
      }
      .label {
        font-size: 13px;
        letter-spacing: 0.18em;
        color: var(--accent);
        font-weight: 600;
        margin: 0 0 10px;
      }
      h1 {
        margin: 0 0 8px;
        font-size: 32px;
        color: rgb(var(--black));
      }
      .lead {
        margin: 0 0 32px;
        color: rgb(var(--gray));
        font-size: 16px;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 36px;
      }
      @media (min-width: 640px) {
        .grid { grid-template-columns: repeat(4, 1fr); }
      }
      .metric {
        padding: 18px 16px;
        border-radius: 14px;
        border: 1px solid rgba(var(--gray), 0.3);
        background: rgba(var(--gray-light), 0.4);
        min-width: 0;
      }
      .metric b {
        display: block;
        font-size: 28px;
        line-height: 1.2;
        color: rgb(var(--black));
        word-break: break-all;
      }
      .metric span {
        font-size: 13px;
        color: rgb(var(--gray));
      }
      h2 {
        margin: 0 0 14px;
        font-size: 18px;
        color: rgb(var(--black));
      }
      .section { margin-bottom: 40px; }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(var(--gray-light), 0.7);
        border: 1px solid rgba(var(--gray), 0.25);
        font-size: 13px;
        color: rgb(var(--gray-dark));
        text-decoration: none;
        max-width: 100%;
      }
      .tag em {
        font-style: normal;
        font-weight: 700;
        color: var(--accent);
      }
      .cal {
        display: grid;
        grid-template-columns: repeat(16, 1fr);
        gap: 4px;
      }
      .cell {
        aspect-ratio: 1;
        border-radius: 3px;
        background: rgba(var(--gray), 0.15);
        min-width: 0;
      }
      .cell.c1 { background: rgba(143, 168, 255, 0.35); }
      .cell.c2 { background: rgba(143, 168, 255, 0.6); }
      .cell.c3 { background: rgba(143, 168, 255, 0.9); }
      .list { list-style: none; margin: 0; padding: 0; }
      .list li {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(var(--gray), 0.2);
        font-size: 15px;
      }
      .list a {
        color: rgb(var(--black));
        text-decoration: none;
        font-weight: 600;
        min-width: 0;
        word-break: break-word;
      }
      .list a:hover { color: var(--accent); }
      .list .meta {
        flex: none;
        color: rgb(var(--gray));
        font-size: 13px;
      }
      @media (max-width: 640px) {
        main.stats { padding: 28px 14px 48px; }
        h1 { font-size: 26px; }
        .grid { grid-template-columns: 1fr 1fr; gap: 10px; }
        .metric { padding: 14px 12px; }
        .metric b { font-size: 22px; }
        .cal { grid-template-columns: repeat(7, 1fr); gap: 3px; }
        .list li {
          flex-direction: column;
          align-items: flex-start;
          gap: 4px;
        }
        .list .meta { font-size: 12px; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="stats">
      <p class="label">STATS · 写作仪表盘</p>
      <h1>记录，才变成资产</h1>
      <p class="lead">从博客内容集合自动统计。字数为正文粗算（中文按字、英文按词）。</p>

      <div class="grid">
        <div class="metric"><b>{totalPosts}</b><span>篇文章</span></div>
        <div class="metric"><b>{totalChars.toLocaleString('zh-CN')}</b><span>估算字数</span></div>
        <div class="metric"><b>{yearPosts}</b><span>{thisYear} 年发布</span></div>
        <div class="metric"><b>{tagMap.size}</b><span>个标签</span></div>
      </div>

      <section class="section">
        <h2>最近 16 周</h2>
        <div class="cal" title="有发布的日期会高亮">
          {
            cells.map((c) => (
              <div
                class={`cell ${c.count >= 3 ? 'c3' : c.count === 2 ? 'c2' : c.count === 1 ? 'c1' : ''}`}
                title={`${c.date}${c.count ? ` · ${c.count} 篇` : ''}`}
              />
            ))
          }
        </div>
      </section>

      <section class="section">
        <h2>标签分布</h2>
        <div class="tags">
          {
            topTags.length === 0 ? (
              <span style="color:rgb(var(--gray))">暂无标签</span>
            ) : (
              topTags.map(([t, n]) => (
                <a class="tag" href={`/blog?tag=${encodeURIComponent(t)}`}>
                  #{t} <em>{n}</em>
                </a>
              ))
            )
          }
        </div>
      </section>

      <section class="section">
        <h2>全部文章</h2>
        <ul class="list">
          {
            rows.map((r) => (
              <li>
                <a href={`/blog/${r.slug}/`}>{r.title}</a>
                <span class="meta">{r.day} · {r.chars.toLocaleString('zh-CN')} 字</span>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
